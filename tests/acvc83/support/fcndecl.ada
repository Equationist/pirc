-- FCNDECL.ADA

-- PACKAGE THAT MAY BE MODIFIED TO DECLARE FUNCTIONS THAT RETURN
-- VALUES USABLE FOR INITIALIZATION OF CONSTANTS IN PACKAGE SPPRT13.

WITH SYSTEM;
PACKAGE FCNDECL IS
     TYPE BUF_T IS ARRAY (1 .. 1024) OF INTEGER;
     VAR_BUF_0 : BUF_T;
     VAR_BUF_1 : BUF_T;
     VAR_BUF_2 : BUF_T;
END FCNDECL;
