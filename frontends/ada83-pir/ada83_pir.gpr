with "../diana/gnat/diana.gpr";

project Ada83_Pir is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";

   for Main use ("diana2pir.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2012", "-g");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Linker is
      for Default_Switches ("Ada") use ("-B/usr/bin");
   end Linker;

end Ada83_Pir;
