# ada83-pir — Ada 83 -> DIANA -> PIR -> pirc compiler driver
# Supports single-file, multi-file, persistent program libraries (-L),
# separate compilation (-c), and pure-Ada LRM Chapter 10 binding (ada83_bind).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
DIANA_BIN="$ROOT/frontends/diana/bin"
DIANA2PIR="$SCRIPT_DIR/bin/diana2pir"
ADA83_BIND="$SCRIPT_DIR/bin/ada83_bind"
RTL_IMG="$SCRIPT_DIR/build/rtl_lib"
PIRC="${PIRC:-$ROOT/build/pirc}"

TARGET="aarch64-apple-darwin"
OPT="-O2"
CHECKS_FLAG="--checks"
EMIT_PIR=0
EMIT_ASM=0
DO_INTERP=0
COMPILE_ONLY=0
BIND_ONLY=0
LIB_DIR=""
MAIN_UNIT=""
OUTPUT=""
SRCS=()
EXTRA_LINK=()

usage() {
    cat >&2 <<EOF
Usage: ada83-pir [options] [file1.ada ...]
Options:
  -o <file>           Output executable (or .pir/.s with --emit-pir/-S)
  -L <dir>|--lib=<d>  Use/create persistent Ada 83 program library directory
  -c                  Compile source file(s) into the program library only
  --main=<unit>       Specify main library procedure name for binding
  --bind <unit>       Bind and link main library procedure from library (-L)
  -O0 | -O1 | -O2     Optimization level passed to pirc (default: -O2)
  --target=<triple>   Target triple (aarch64-apple-darwin | x86_64-apple-darwin)
  --no-checks         Suppress Ada runtime range/index/overflow checks
  --checks            Enable Ada runtime checks (default)
  --emit-pir          Emit PIR HIR only (single input file)
  -S                  Emit assembly only (single input file)
  --interp            Run via pirc --interp (single input file, no C runtime I/O)
  --pirc=<path>       Override pirc binary path
EOF
    exit 1
}

while [ $# -gt 0 ]; do
    case "$1" in
        -o) shift; OUTPUT="$1" ;;
        -L|--lib) shift; LIB_DIR="$1" ;;
        --lib=*) LIB_DIR="${1#--lib=}" ;;
        -c) COMPILE_ONLY=1 ;;
        --main=*) MAIN_UNIT="${1#--main=}" ;;
        --main) shift; MAIN_UNIT="$1" ;;
        --bind) shift; BIND_ONLY=1; MAIN_UNIT="$1" ;;
        --bind=*) BIND_ONLY=1; MAIN_UNIT="${1#--bind=}" ;;
        -O0|-O1|-O2) OPT="$1" ;;
        --target=*) TARGET="${1#--target=}" ;;
        --target) shift; TARGET="$1" ;;
        --no-checks) CHECKS_FLAG="--no-checks" ;;
        --checks) CHECKS_FLAG="--checks" ;;
        --emit-pir) EMIT_PIR=1 ;;
        -S) EMIT_ASM=1 ;;
        --interp) DO_INTERP=1 ;;
        --pirc=*) PIRC="${1#--pirc=}" ;;
        -l*|-Wl,*) EXTRA_LINK+=("$1") ;;
        -h|--help) usage ;;
        -*) echo "ada83-pir: unknown option '$1'" >&2; usage ;;
        *.o|*.a) EXTRA_LINK+=("$1") ;;
        *) SRCS+=("$1") ;;
    esac
    shift
done

if [ ${#SRCS[@]} -eq 0 ] && [ "$BIND_ONLY" -eq 0 ]; then
    usage
fi

if [ -n "$LIB_DIR" ]; then
    mkdir -p "$LIB_DIR"
    WORK="$(cd "$LIB_DIR" && pwd)"
    if [ ! -f "$WORK/PARSE.VM" ]; then
        cp "$RTL_IMG/PARSE.VM" "$WORK/PARSE.VM"
        cp "$RTL_IMG/PARSE.BIN" "$WORK/PARSE.BIN"
        cp "$RTL_IMG/DIANA.BIN" "$WORK/DIANA.BIN"
        cp "$RTL_IMG/ADA__LIB.CTL" "$WORK/ADA__LIB.CTL"
        cp -R "$RTL_IMG/ADA__LIB" "$WORK/ADA__LIB"
    fi
    mkdir -p "$WORK/objs"
else
    WORK="$(mktemp -d "${TMPDIR:-/tmp}/ada83_pir.XXXXXX")"
    trap 'rm -rf "$WORK"' EXIT
    cp "$RTL_IMG/PARSE.VM" "$WORK/PARSE.VM"
    cp "$RTL_IMG/PARSE.BIN" "$WORK/PARSE.BIN"
    cp "$RTL_IMG/DIANA.BIN" "$WORK/DIANA.BIN"
    cp "$RTL_IMG/ADA__LIB.CTL" "$WORK/ADA__LIB.CTL"
    cp -R "$RTL_IMG/ADA__LIB" "$WORK/ADA__LIB"
    mkdir -p "$WORK/objs"
fi

USE_SINGLE_DIRECT=0
if [ "$EMIT_PIR" -eq 1 ] || [ "$EMIT_ASM" -eq 1 ] || [ "$DO_INTERP" -eq 1 ]; then
    USE_SINGLE_DIRECT=1
elif [ -z "$LIB_DIR" ] && [ "$COMPILE_ONLY" -eq 0 ] && [ "$BIND_ONLY" -eq 0 ] && [ ${#SRCS[@]} -eq 1 ] && [ -z "$MAIN_UNIT" ]; then
    USE_SINGLE_DIRECT=1
fi

# Monotonic object counter persisted in library
SEQ_FILE="$WORK/objs/.seq"
OBJ_SEQ=0
if [ -f "$SEQ_FILE" ]; then
    OBJ_SEQ="$(cat "$SEQ_FILE")"
fi

SINGLE_OBJ=""
for idx in "${!SRCS[@]}"; do
    src_abs="$(cd "$(dirname "${SRCS[$idx]}")" && pwd)/$(basename "${SRCS[$idx]}")"
    OBJ_SEQ=$((OBJ_SEQ + 1))
    echo "$OBJ_SEQ" > "$SEQ_FILE"
    pir_out="$WORK/objs/unit_${OBJ_SEQ}.pir"
    obj_out="$WORK/objs/unit_${OBJ_SEQ}.o"

    (
        cd "$WORK"
        rm -f '$$$.TMP' '$$$PGM.TMP' SEMPHASE.TMP WRITELIB.TMP ADA__LIB.TMP
        cp "$src_abs" '$$$PGM.TMP'
        cp PARSE.VM '$$$.TMP'
        chmod 644 '$$$.TMP'

        if ! "$DIANA_BIN/parphase" >"$WORK/par.log" 2>&1; then
            cat "$WORK/par.log" >&2
            exit 1
        fi
        if grep -q "Syntax error" "$WORK/par.log"; then
            "$DIANA_BIN/errphase" >&2 || cat "$WORK/par.log" >&2
            exit 1
        fi
        if ! "$DIANA_BIN/libphase" >"$WORK/lib.log" 2>&1; then
            cat "$WORK/lib.log" >&2
            exit 1
        fi
        cp '$$$.TMP' SEMPHASE.TMP
        if ! "$DIANA_BIN/semphase" >"$WORK/sem.log" 2>&1; then
            "$DIANA_BIN/errphase" >&2 || cat "$WORK/sem.log" >&2
            exit 1
        fi
        # Check for semantic errors (ignore '(W)' warning-only diagnostics)
        "$DIANA_BIN/errphase" >"$WORK/err.log" 2>&1 || true
        if grep '==>' "$WORK/err.log" | grep -qvE '==>[[:space:]]*[0-9]+:[[:space:]]*\(W\)'; then
            cat "$WORK/err.log" >&2
            exit 1
        fi

        if [ "$USE_SINGLE_DIRECT" -eq 1 ]; then
            "$DIANA2PIR" --target="$TARGET" "$CHECKS_FLAG" --main -o "$pir_out"
        else
            "$DIANA2PIR" --target="$TARGET" "$CHECKS_FLAG" --no-main --lib="$WORK/ADA__LIB" --record-obj="$obj_out" -o "$pir_out"
        fi

        # Save compiled unit to ADA__LIB for subsequent units (with clauses)
        if [ -f ADA__LIB.TMP ]; then
            mv ADA__LIB.TMP ADA__LIB.CTL
        fi
        cp '$$$.TMP' WRITELIB.TMP
        if ! "$DIANA_BIN/writelib" >"$WORK/wlib.log" 2>&1; then
            cat "$WORK/wlib.log" >&2
            exit 1
        fi
    )

    if [ "$EMIT_PIR" -eq 1 ]; then
        if [ -n "$OUTPUT" ]; then
            cp "$pir_out" "$OUTPUT"
        else
            cat "$pir_out"
        fi
        exit 0
    fi

    if [ "$DO_INTERP" -eq 1 ]; then
        exec "$PIRC" --interp --target="$TARGET" "$OPT" "$pir_out"
    fi

    if [ "$EMIT_ASM" -eq 1 ]; then
        if [ -n "$OUTPUT" ]; then
            "$PIRC" --target="$TARGET" "$OPT" -S "$pir_out" -o "$OUTPUT"
        else
            "$PIRC" --target="$TARGET" "$OPT" -S "$pir_out"
        fi
        exit 0
    fi

    "$PIRC" --target="$TARGET" "$OPT" -c "$pir_out" -o "$obj_out"
    SINGLE_OBJ="$obj_out"
done

if [ "$COMPILE_ONLY" -eq 1 ]; then
    exit 0
fi

OBJS=()
if [ "$USE_SINGLE_DIRECT" -eq 1 ]; then
    OBJS+=("$SINGLE_OBJ")
else
    # Run pure-Ada LRM Chapter 10 binder (ada83_bind)
    BIND_PIR="$WORK/objs/binder_main.pir"
    BIND_OBJ="$WORK/objs/binder_main.o"
    OBJS_TXT="$WORK/objs/live_objs.txt"
    BIND_ARGS=(--lib="$WORK/ADA__LIB" --target="$TARGET" --emit-pir="$BIND_PIR" --objs-out="$OBJS_TXT")
    if [ -n "$MAIN_UNIT" ]; then
        BIND_ARGS+=(--main="$MAIN_UNIT")
    fi
    "$ADA83_BIND" "${BIND_ARGS[@]}"
    "$PIRC" --target="$TARGET" "$OPT" -c "$BIND_PIR" -o "$BIND_OBJ"
    while IFS= read -r obj_line; do
        [ -n "$obj_line" ] && OBJS+=("$obj_line")
    done < "$OBJS_TXT"
    OBJS+=("$BIND_OBJ")
fi

if [ -z "$OUTPUT" ]; then
    OUTPUT="a.out"
fi

case "$TARGET" in
    aarch64-apple-darwin*)
        cc -arch arm64 "${OBJS[@]}" ${EXTRA_LINK[@]+"${EXTRA_LINK[@]}"} "$SCRIPT_DIR/build/ada_rt_arm64.o" "$SCRIPT_DIR/build/ada_io_arm64.o" "$SCRIPT_DIR/build/ada_task_arm64.o" "$SCRIPT_DIR/build/pir_rt_arm64.o" -lm -lpthread -o "$OUTPUT"
        ;;
    x86_64-apple-darwin*)
        cc -arch x86_64 "${OBJS[@]}" ${EXTRA_LINK[@]+"${EXTRA_LINK[@]}"} "$SCRIPT_DIR/build/ada_rt_x64.o" "$SCRIPT_DIR/build/ada_io_x64.o" "$SCRIPT_DIR/build/ada_task_x64.o" "$SCRIPT_DIR/build/pir_rt_x64.o" -lm -lpthread -o "$OUTPUT"
        ;;
    *)
        echo "ada83-pir: unsupported link target '$TARGET'" >&2
        exit 1
        ;;
esac
