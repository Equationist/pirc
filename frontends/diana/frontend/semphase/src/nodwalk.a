with TEXT2_IO; use TEXT2_IO;
with TEXT_IO;
with DIANA, DIANAMAN, DIANATTR; use DIANA, DIANAMAN, DIANATTR;
with DEFUTIL; use DEFUTIL;
with VISUTIL; use VISUTIL;
with MAKENOD; use MAKENOD;
with UARITH;
with SEMGLOB; use SEMGLOB;
with EXPTYPE, EXPRESO; use EXPTYPE, EXPRESO;
with REQUTIL; use REQUTIL;
with REDSUBP; use REDSUBP;
with DEFWALK; use DEFWALK;
with SETUTIL; use SETUTIL;
with STMWALK; use STMWALK;
with PREFCNS;
with PRAWALK; use PRAWALK;
with ATTWALK; use ATTWALK;
with HOMUNIT; use HOMUNIT;
with INSTANT;
with DERIVED; use DERIVED; -- Remember_Derived_Decl
with REPCLAU;
with CHKSTAT;

package body NODWALK is

    EQUAL_SYM: TREE := CONST_VOID; -- storesym("=");
    NOT_EQUAL_SYM: TREE := CONST_VOID; -- storesym("/=");

    MAX_STUBS: constant NATURAL := 256;
    STUB_REGIONS: array (1 .. MAX_STUBS) of TREE;
    STUB_SYMS: array (1 .. MAX_STUBS) of TREE;
    STUB_COUNT: NATURAL := 0;

    MAX_LP_OUT: constant NATURAL := 256;
    LP_OUT_SPECS: array (1 .. MAX_LP_OUT) of TREE;
    LP_OUT_COUNT: NATURAL := 0;

    MAX_BODIES: constant NATURAL := 4096;
    BODY_IDS: array (1 .. MAX_BODIES) of TREE;
    BODY_COUNT: NATURAL := 0;

    procedure RESET_UNIT_BODIES is
    begin
	BODY_COUNT := 0;
    end RESET_UNIT_BODIES;

    procedure RECORD_BODY(ID: TREE) is
    begin
	if ID = CONST_VOID then return; end if;
	for K in 1 .. BODY_COUNT loop
	    if BODY_IDS(K) = ID then return; end if;
	end loop;
	if BODY_COUNT < MAX_BODIES then
	    BODY_COUNT := BODY_COUNT + 1;
	    BODY_IDS(BODY_COUNT) := ID;
	end if;
    end RECORD_BODY;

    function HAS_RECORDED_BODY(ID: TREE) return BOOLEAN is
    begin
	if ID = CONST_VOID then return FALSE; end if;
	for K in 1 .. BODY_COUNT loop
	    if BODY_IDS(K) = ID then return TRUE; end if;
	end loop;
	return FALSE;
    end HAS_RECORDED_BODY;

    function DECL_S_REQUIRES_BODY(ITEM_S: TREE; ALLOW_INCOMPLETE: BOOLEAN := FALSE) return BOOLEAN is
	IL: SEQ_TYPE;
	IT: TREE;
	SN: TREE;
	UK: TREE;
	HDR: TREE;
    begin
	if ITEM_S = CONST_VOID then return FALSE; end if;
	IL := LIST(ITEM_S);
	while not IS_EMPTY(IL) loop
	    POP(IL, IT);
	    case KIND(IT) is
	    when DN_SUBPROG_ENTRY_DECL =>
		SN := D(AS_SOURCE_NAME, IT);
		UK := D(AS_UNIT_KIND, IT);
		if SN /= CONST_VOID and then KIND(SN) in CLASS_SUBPROG_NAME
		and then UK = CONST_VOID
		and then D(SM_INTERFACE, SN) = CONST_VOID then
		    return TRUE;
		end if;
	    when DN_TASK_DECL =>
		return TRUE;
	    when DN_GENERIC_DECL =>
		HDR := D(AS_HEADER, IT);
		if HDR = CONST_VOID or else KIND(HDR) /= DN_PACKAGE_SPEC
		or else DB(XD_BODY_IS_REQUIRED, HDR) then
		    return TRUE;
		end if;
	    when DN_PACKAGE_DECL =>
		UK := D(AS_UNIT_KIND, IT);
		HDR := D(AS_HEADER, IT);
		if UK = CONST_VOID and then HDR /= CONST_VOID
		and then KIND(HDR) = DN_PACKAGE_SPEC
		and then DB(XD_BODY_IS_REQUIRED, HDR) then
		    return TRUE;
		end if;
	    when DN_TYPE_DECL =>
		if ALLOW_INCOMPLETE then
		    SN := D(AS_SOURCE_NAME, IT);
		    if SN /= CONST_VOID and then KIND(SN) in CLASS_TYPE_NAME
		    and then D(SM_TYPE_SPEC, SN) /= CONST_VOID
		    and then KIND(D(SM_TYPE_SPEC, SN)) = DN_INCOMPLETE
		    and then D(XD_FULL_TYPE_SPEC, D(SM_TYPE_SPEC, SN)) = CONST_VOID then
			return TRUE;
		    end if;
		end if;
	    when others =>
		null;
	    end case;
	end loop;
	return FALSE;
    end DECL_S_REQUIRES_BODY;

    procedure CHECK_COMPLETIONS(ITEM_S: TREE) is
	IL: SEQ_TYPE;
	IT: TREE;
	SN: TREE;
	UK: TREE;
	HDR: TREE;
    begin
	if ITEM_S = CONST_VOID then return; end if;
	IL := LIST(ITEM_S);
	while not IS_EMPTY(IL) loop
	    POP(IL, IT);
	    case KIND(IT) is
	    when DN_TYPE_DECL =>
		SN := D(AS_SOURCE_NAME, IT);
		if SN /= CONST_VOID and then KIND(SN) in CLASS_TYPE_NAME
		and then D(SM_TYPE_SPEC, SN) /= CONST_VOID
		and then KIND(D(SM_TYPE_SPEC, SN)) = DN_INCOMPLETE
		and then D(XD_FULL_TYPE_SPEC, D(SM_TYPE_SPEC, SN)) = CONST_VOID then
		    ERROR(D(LX_SRCPOS, IT), "Missing full declaration for incomplete type");
		end if;
	    when DN_SUBPROG_ENTRY_DECL =>
		SN := D(AS_SOURCE_NAME, IT);
		UK := D(AS_UNIT_KIND, IT);
		if SN /= CONST_VOID and then KIND(SN) in CLASS_SUBPROG_NAME
		and then UK = CONST_VOID
		and then D(SM_INTERFACE, SN) = CONST_VOID
		and then not HAS_RECORDED_BODY(SN) then
		    ERROR(D(LX_SRCPOS, IT), "Missing body for subprogram");
		end if;
	    when DN_TASK_DECL =>
		SN := D(AS_SOURCE_NAME, IT);
		if SN /= CONST_VOID and then not HAS_RECORDED_BODY(SN)
		and then not (KIND(SN) = DN_TYPE_ID and then HAS_RECORDED_BODY(D(SM_FIRST, SN))) then
		    ERROR(D(LX_SRCPOS, IT), "Missing body for task");
		end if;
	    when DN_PACKAGE_DECL =>
		SN := D(AS_SOURCE_NAME, IT);
		UK := D(AS_UNIT_KIND, IT);
		HDR := D(AS_HEADER, IT);
		if SN /= CONST_VOID and then UK = CONST_VOID
		and then HDR /= CONST_VOID and then KIND(HDR) = DN_PACKAGE_SPEC
		and then DB(XD_BODY_IS_REQUIRED, HDR)
		and then not HAS_RECORDED_BODY(SN) then
		    ERROR(D(LX_SRCPOS, IT), "Missing body for package");
		end if;
	    when DN_GENERIC_DECL =>
		SN := D(AS_SOURCE_NAME, IT);
		HDR := D(AS_HEADER, IT);
		if SN /= CONST_VOID
		and then (HDR = CONST_VOID or else KIND(HDR) /= DN_PACKAGE_SPEC
			  or else DB(XD_BODY_IS_REQUIRED, HDR))
		and then not HAS_RECORDED_BODY(SN) then
		    ERROR(D(LX_SRCPOS, IT), "Missing body for generic unit");
		end if;
	    when others =>
		null;
	    end case;
	end loop;
    end CHECK_COMPLETIONS;

    function TYPE_CONTAINS_TARGET(TS: TREE; TARGET: TREE; DEPTH: NATURAL) return BOOLEAN is
	CUR: TREE := TS;
	CL: TREE;
	DL: SEQ_TYPE;
	DECL: TREE;
	VP: TREE;
	VL: SEQ_TYPE;
	V: TREE;
    begin
	if CUR = CONST_VOID or else TARGET = CONST_VOID or else DEPTH > 24 then
	    return FALSE;
	end if;
	if CUR = TARGET then
	    return TRUE;
	end if;
	case KIND(CUR) is
	when DN_PRIVATE | DN_L_PRIVATE =>
	    if D(SM_TYPE_SPEC, CUR) /= CONST_VOID then
		return TYPE_CONTAINS_TARGET(D(SM_TYPE_SPEC, CUR), TARGET, DEPTH + 1);
	    end if;
	when DN_CONSTRAINED_ARRAY =>
	    return TYPE_CONTAINS_TARGET(D(SM_BASE_TYPE, CUR), TARGET, DEPTH + 1);
	when DN_ARRAY =>
	    return TYPE_CONTAINS_TARGET(D(SM_COMP_TYPE, CUR), TARGET, DEPTH + 1);
	when DN_CONSTRAINED_RECORD =>
	    return TYPE_CONTAINS_TARGET(D(SM_BASE_TYPE, CUR), TARGET, DEPTH + 1);
	when DN_RECORD =>
	    CL := D(SM_COMP_LIST, CUR);
	    if CL /= CONST_VOID and then KIND(CL) = DN_COMP_LIST then
		declare
		    function CHECK_CL(C: TREE; D_CUR: NATURAL) return BOOLEAN is
			DS_N: TREE;
			D_L: SEQ_TYPE;
			D_IT: TREE;
			SN_L: SEQ_TYPE;
			V_P: TREE;
			V_L: SEQ_TYPE;
			V_IT: TREE;
		    begin
			if C = CONST_VOID or else KIND(C) /= DN_COMP_LIST or else D_CUR > 24 then
			    return FALSE;
			end if;
			DS_N := D(AS_DECL_S, C);
			if DS_N /= CONST_VOID then
			    D_L := LIST(DS_N);
			    while not IS_EMPTY(D_L) loop
				POP(D_L, D_IT);
				if KIND(D_IT) = DN_VARIABLE_DECL then
				    SN_L := LIST(D(AS_SOURCE_NAME_S, D_IT));
				    if not IS_EMPTY(SN_L)
				    and then TYPE_CONTAINS_TARGET(D(SM_OBJ_TYPE, HEAD(SN_L)), TARGET, D_CUR + 1) then
					return TRUE;
				    end if;
				end if;
			    end loop;
			end if;
			V_P := D(AS_VARIANT_PART, C);
			if V_P /= CONST_VOID and then KIND(V_P) = DN_VARIANT_PART then
			    V_L := LIST(D(AS_VARIANT_S, V_P));
			    while not IS_EMPTY(V_L) loop
				POP(V_L, V_IT);
				if KIND(V_IT) = DN_VARIANT
				and then CHECK_CL(D(AS_COMP_LIST, V_IT), D_CUR + 1) then
				    return TRUE;
				end if;
			    end loop;
			end if;
			return FALSE;
		    end CHECK_CL;
		begin
		    return CHECK_CL(CL, DEPTH + 1);
		end;
	    end if;
	when others =>
	    null;
	end case;
	return FALSE;
    end TYPE_CONTAINS_TARGET;

    procedure WALK_HEADER(NODE: TREE; H: H_TYPE);
    procedure SWITCH_REGION (GENERIC_ID, REGION_DEF: TREE);
    procedure WALK_UNIT_DESC
		( SOURCE_NAME:	TREE
		; NODE: TREE
		; H: H_TYPE
		; HEADER: TREE := CONST_VOID );
    procedure INSERT_OBJ_TYPE_AND_INIT_EXP_IN_S
		( SOURCE_NAME_S:	TREE
		; OBJ_TYPE:		TREE
		; INIT_EXP:		TREE := CONST_VOID
		; DEFER_VISIBLE:	BOOLEAN := FALSE );
    procedure FINISH_PARAM_DECL
		( NODE: TREE
		; H: H_TYPE
		; DEFER_VISIBLE: BOOLEAN := FALSE );
    procedure FINISH_VARIABLE_DECL(NODE: TREE; H: H_TYPE);
    function IS_CONSTANT_EXP (EXP: TREE) return BOOLEAN;
    procedure REPROCESS_USE_CLAUSES(DECL_S: TREE; H: H_TYPE);
    procedure FIXUP_CONSTRAINED_ARRAY_OBJECTS(SOURCE_NAME_S: TREE; H: H_TYPE);
    procedure CHECK_EQUALITY_OPERATOR(OPERATOR_ID: TREE; H: H_TYPE);

    -- $$$$ should be combined with upper case for make_used_op_from_string
    procedure FORCE_UPPER_CASE(OPERATOR_ID: TREE) is
	function MAKE_UPPER_CASE(A_IN: STRING) return STRING is
            MAGIC: constant := CHARACTER'POS('a') - CHARACTER'POS('A');
            A: STRING (A_IN'RANGE) := A_IN;
	begin
            for II in A'RANGE loop
                if A(II) in 'a' .. 'z' then
                    A(II) := CHARACTER'VAL(CHARACTER'POS(A(II)) - MAGIC);
		end if;
	    end loop;
	    return A;
	end MAKE_UPPER_CASE;

    begin
	D(LX_SYMREP, OPERATOR_ID, STORESYM
		( MAKE_UPPER_CASE(PRINTNAME(D(LX_SYMREP, OPERATOR_ID))) ) );
    end FORCE_UPPER_CASE;

    procedure WALK(NODE: TREE; H: H_TYPE) is

    begin
	if NODE = CONST_VOID then
	    return;
	end if;

        PUT("Walk "); PUT_LINE(NODE_REP(NODE));

        case CLASS_ITEM'(KIND(NODE)) is


	-- for a discriminant or a parameter declaration
	when DN_DSCRMT_DECL | DN_IN | DN_IN_OUT | DN_OUT =>
	    declare
		SOURCE_NAME_S: TREE := D(AS_SOURCE_NAME_S, NODE);
	    begin

		-- insert source names in environment
		-- (other processing handled in enclosing declaration)
		WALK_SOURCE_NAME_S(SOURCE_NAME_S, H);
	    end;


	-- for a constant declaration
	when DN_CONSTANT_DECL =>
	    declare
		SOURCE_NAME_S: TREE := D(AS_SOURCE_NAME_S, NODE);
		EXP: TREE := D(AS_EXP, NODE);
		TYPE_DEF: TREE := D(AS_TYPE_DEF, NODE);

		TYPE_SPEC: TREE;
		TYPESET: TYPESET_TYPE;
	    begin

		-- insert names in the environment
		WALK_SOURCE_NAME_S(SOURCE_NAME_S, H);

		-- if declaration contains a constrained array definition
		if KIND(TYPE_DEF) = DN_CONSTRAINED_ARRAY_DEF then

		    -- evaluate the type definition
		    TYPE_SPEC := EVAL_TYPE_DEF
			    (TYPE_DEF, HEAD(LIST(SOURCE_NAME_S)), H);

		-- else -- since declaration contains a subtype indication
		else

		    -- evaluate and resolve the subtype indication
		    TYPE_SPEC := EVAL_SUBTYPE_INDICATION(TYPE_DEF);
		    RESOLVE_SUBTYPE_INDICATION(TYPE_DEF, TYPE_SPEC);
		    D(AS_TYPE_DEF, NODE, TYPE_DEF);
		    -- LRM 7.4.1: constant cannot have premature uncompleted private type (unconstrained array/record IS allowed!)
		    if TYPE_SPEC /= CONST_VOID and then CONTAINS_UNCOMPLETED_PRIVATE(TYPE_SPEC) then
			ERROR(D(LX_SRCPOS, TYPE_DEF), "Premature use of uncompleted private type");
		    end if;
		end if;

		-- evaluate and resolve expression (one must be given)
		EVAL_EXP_TYPES(EXP, TYPESET);
		REQUIRE_TYPE(GET_BASE_TYPE(TYPE_SPEC), EXP, TYPESET);
		REQUIRE_NONLIMITED_TYPE(EXP, TYPESET);
		if EXP /= CONST_VOID and then KIND(EXP) = DN_AGGREGATE
		and then not IS_EMPTY(TYPESET)
		and then TYPE_SPEC /= CONST_VOID and then KIND(TYPE_SPEC) = DN_CONSTRAINED_ARRAY then
		    EXP := RESOLVE_EXP(EXP, TYPE_SPEC);
		else
		    EXP := RESOLVE_EXP(EXP, TYPESET);
		end if;
		D(AS_EXP, NODE, EXP);
		CHECK_NO_OUT_READ(EXP);
		-- LRM 4.3.2(6) (bc3220b): check OTHERS context in array aggregate init of constant
		if EXP /= CONST_VOID and then KIND(EXP) = DN_AGGREGATE and then TYPE_SPEC /= CONST_VOID then
		    declare
			HAS_OTH: BOOLEAN := FALSE;
			HAS_OTHER_CH: BOOLEAN := FALSE;
			AL: SEQ_TYPE := LIST(D(AS_GENERAL_ASSOC_S, EXP));
			IT: TREE;
		    begin
			while not IS_EMPTY(AL) loop
			    POP(AL, IT);
			    if KIND(IT) = DN_ASSOC or else KIND(IT) = DN_NAMED then
				declare
				    CS: SEQ_TYPE := LIST(D(AS_CHOICE_S, IT));
				    CH: TREE;
				begin
				    while not IS_EMPTY(CS) loop
					POP(CS, CH);
					if KIND(CH) = DN_CHOICE_OTHERS then HAS_OTH := TRUE;
					else HAS_OTHER_CH := TRUE;
					end if;
				    end loop;
				end;
			    else
				HAS_OTHER_CH := TRUE;
			    end if;
			end loop;
			if HAS_OTH then
			    if KIND(TYPE_SPEC) = DN_ARRAY then
				ERROR(D(LX_SRCPOS, EXP), "OTHERS not allowed in unconstrained array aggregate");
			    elsif HAS_OTHER_CH and then KIND(TYPE_SPEC) = DN_CONSTRAINED_ARRAY
			    and then D(SM_INDEX_SUBTYPE_S, TYPE_SPEC) /= CONST_VOID then
				declare
				    IL: SEQ_TYPE := LIST(D(SM_INDEX_SUBTYPE_S, TYPE_SPEC));
				    IDX: TREE;
				begin
				    while not IS_EMPTY(IL) loop
					POP(IL, IDX);
					if not CHKSTAT.IS_STATIC_SUBTYPE(IDX) then
					    ERROR(D(LX_SRCPOS, EXP), "OTHERS with other choices requires static array bounds");
					    exit;
					end if;
				    end loop;
				end;
			    end if;
			end if;
		    end;
		end if;
		if H.REGION_DEF = CONST_VOID or else KIND(D(XD_SOURCE_NAME, H.REGION_DEF)) not in CLASS_TYPE_NAME then
		    FREEZE_TYPE(TYPE_SPEC);
		end if;

		-- complete source_name definitions and make visible
		INSERT_OBJ_TYPE_AND_INIT_EXP_IN_S(SOURCE_NAME_S
				, OBJ_TYPE => TYPE_SPEC
				, INIT_EXP => EXP);

		-- if type definition is a constrained array definition
		if KIND(TYPE_DEF) = DN_CONSTRAINED_ARRAY_DEF then

                    -- make distinct copies of array type_spec's
		    -- ... and generate predefined operators
		    FIXUP_CONSTRAINED_ARRAY_OBJECTS(SOURCE_NAME_S, H);
		end if;
	    end;


	-- for a variable declaration
	when DN_VARIABLE_DECL =>
	    declare
		SOURCE_NAME_S: TREE := D(AS_SOURCE_NAME_S, NODE);
		EXP: TREE := D(AS_EXP, NODE);
		TYPE_DEF: TREE := D(AS_TYPE_DEF, NODE);

		TYPE_SPEC: TREE;
		TYPESET: TYPESET_TYPE;
	    begin
		-- insert names in the environment
		WALK_SOURCE_NAME_S(SOURCE_NAME_S, H);

		-- if declaration contains a constrained array definition
		if KIND(TYPE_DEF) = DN_CONSTRAINED_ARRAY_DEF then

		    -- evaluate the type definition
		    TYPE_SPEC := EVAL_TYPE_DEF
			    (TYPE_DEF, HEAD(LIST(SOURCE_NAME_S)), H);

		-- else -- since declaration contains a subtype indication
		else

		    -- evaluate and resolve the subtype indication
		    TYPE_SPEC := EVAL_SUBTYPE_INDICATION(TYPE_DEF);
		    RESOLVE_SUBTYPE_INDICATION(TYPE_DEF, TYPE_SPEC);
		    D(AS_TYPE_DEF, NODE, TYPE_DEF);
		    -- LRM 3.6.1 / 3.7.2 / 7.4.1: variable subtype must be constrained and not premature uncompleted private
		    if TYPE_SPEC /= CONST_VOID then
			declare
			    TBS: constant TREE := GET_BASE_STRUCT(TYPE_SPEC);
			begin
			    if KIND(TYPE_SPEC) = DN_ARRAY then
				ERROR(D(LX_SRCPOS, TYPE_DEF), "Variable subtype must be constrained");
			    elsif KIND(TYPE_SPEC) not in CLASS_CONSTRAINED
			    and then TBS /= CONST_VOID
			    and then (KIND(TBS) = DN_RECORD or else KIND(TBS) in CLASS_PRIVATE_SPEC)
			    and then D(SM_DISCRIMINANT_S, TBS) /= CONST_VOID
			    and then not IS_EMPTY(LIST(D(SM_DISCRIMINANT_S, TBS)))
			    and then D(AS_EXP, HEAD(LIST(D(SM_DISCRIMINANT_S, TBS)))) = CONST_VOID then
				ERROR(D(LX_SRCPOS, TYPE_DEF), "Variable subtype must be constrained");
			    elsif (H.REGION_DEF = CONST_VOID
				   or else D(XD_SOURCE_NAME, H.REGION_DEF) = CONST_VOID
				   or else KIND(D(XD_SOURCE_NAME, H.REGION_DEF)) not in CLASS_TYPE_NAME)
			    and then CONTAINS_UNCOMPLETED_PRIVATE(TYPE_SPEC) then
				ERROR(D(LX_SRCPOS, TYPE_DEF), "Premature use of uncompleted private type");
			    end if;
			end;
		    end if;
		end if;

		-- if an expression is given
		if EXP /= CONST_VOID then
		    declare
			IS_COMP_DEF: constant BOOLEAN :=
			    H.REGION_DEF /= CONST_VOID
			    and then D(XD_SOURCE_NAME, H.REGION_DEF) /= CONST_VOID
			    and then KIND(D(XD_SOURCE_NAME, H.REGION_DEF)) in CLASS_TYPE_NAME;
			PREV_DEF_E: constant BOOLEAN := IN_DEFAULT_EXP;
			PREV_ALLOW_DC: constant BOOLEAN := ALLOW_DEFERRED_CONST;
		    begin
			if IS_COMP_DEF then
			    IN_DEFAULT_EXP := TRUE;
			    ALLOW_DEFERRED_CONST := TRUE;
			end if;
			-- evaluate and resolve expression
			EVAL_EXP_TYPES(EXP, TYPESET);
			REQUIRE_TYPE(GET_BASE_TYPE(TYPE_SPEC), EXP, TYPESET);
			REQUIRE_NONLIMITED_TYPE(EXP, TYPESET);
			if EXP /= CONST_VOID and then KIND(EXP) = DN_AGGREGATE
			and then not IS_EMPTY(TYPESET)
			and then TYPE_SPEC /= CONST_VOID and then KIND(TYPE_SPEC) = DN_CONSTRAINED_ARRAY then
			    EXP := RESOLVE_EXP(EXP, TYPE_SPEC);
			else
			    EXP := RESOLVE_EXP(EXP, TYPESET);
			end if;
			D(AS_EXP, NODE, EXP);
			IN_DEFAULT_EXP := PREV_DEF_E;
			ALLOW_DEFERRED_CONST := PREV_ALLOW_DC;
			if not IS_COMP_DEF then
			    CHECK_NO_OUT_READ(EXP);
			end if;
		    end;
		    -- LRM 4.3.2(6) (bc3220b): check OTHERS context in array aggregate init of variable/component
		    if EXP /= CONST_VOID and then KIND(EXP) = DN_AGGREGATE and then TYPE_SPEC /= CONST_VOID then
			declare
			    HAS_OTH: BOOLEAN := FALSE;
			    HAS_OTHER_CH: BOOLEAN := FALSE;
			    AL: SEQ_TYPE := LIST(D(AS_GENERAL_ASSOC_S, EXP));
			    IT: TREE;
			begin
			    while not IS_EMPTY(AL) loop
				POP(AL, IT);
				if KIND(IT) = DN_ASSOC or else KIND(IT) = DN_NAMED then
				    declare
					CS: SEQ_TYPE := LIST(D(AS_CHOICE_S, IT));
					CH: TREE;
				    begin
					while not IS_EMPTY(CS) loop
					    POP(CS, CH);
					    if KIND(CH) = DN_CHOICE_OTHERS then HAS_OTH := TRUE;
					    else HAS_OTHER_CH := TRUE;
					    end if;
					end loop;
				    end;
				else
				    HAS_OTHER_CH := TRUE;
				end if;
			    end loop;
			    if HAS_OTH and then HAS_OTHER_CH and then KIND(TYPE_SPEC) = DN_CONSTRAINED_ARRAY
			    and then D(SM_INDEX_SUBTYPE_S, TYPE_SPEC) /= CONST_VOID then
				declare
				    IL: SEQ_TYPE := LIST(D(SM_INDEX_SUBTYPE_S, TYPE_SPEC));
				    IDX: TREE;
				begin
				    while not IS_EMPTY(IL) loop
					POP(IL, IDX);
					if not CHKSTAT.IS_STATIC_SUBTYPE(IDX) then
					    ERROR(D(LX_SRCPOS, EXP), "OTHERS with other choices requires static array bounds");
					    exit;
					end if;
				    end loop;
				end;
			    end if;
			end;
		    end if;
		end if;
		if H.REGION_DEF = CONST_VOID
		or else D(XD_SOURCE_NAME, H.REGION_DEF) = CONST_VOID
		or else KIND(D(XD_SOURCE_NAME, H.REGION_DEF)) not in CLASS_TYPE_NAME then
		    FREEZE_TYPE(TYPE_SPEC);
		end if;

		-- complete source_name definitions and make visible
		INSERT_OBJ_TYPE_AND_INIT_EXP_IN_S(SOURCE_NAME_S
				, OBJ_TYPE => TYPE_SPEC
				, INIT_EXP => EXP);

		-- if type definition is a constrained array definition
		if KIND(TYPE_DEF) = DN_CONSTRAINED_ARRAY_DEF then

                    -- make distinct copies of array type_spec's
		    -- ... and generate predefined operators
		    FIXUP_CONSTRAINED_ARRAY_OBJECTS(SOURCE_NAME_S, H);
		end if;
	    end;


	-- for a number declaration
	when DN_NUMBER_DECL =>
	    declare
		SOURCE_NAME_S: TREE := D(AS_SOURCE_NAME_S, NODE);
		EXP: TREE := D(AS_EXP, NODE);

		TYPE_SPEC: TREE;
		TYPESET: TYPESET_TYPE;
	    begin
		-- insert names in the environment
		WALK_SOURCE_NAME_S(SOURCE_NAME_S, H);

		-- evaluate and resolve [universal] subtype
		EVAL_EXP_TYPES(EXP, TYPESET);
		REQUIRE_UNIVERSAL_TYPE(EXP, TYPESET);
		REQUIRE_UNIQUE_TYPE(EXP, TYPESET);
		TYPE_SPEC := GET_THE_TYPE(TYPESET);
		EXP := RESOLVE_EXP(EXP, TYPE_SPEC);
		if TYPE_SPEC /= CONST_VOID and then EXP /= CONST_VOID
		and then KIND(EXP) /= DN_NUMERIC_LITERAL
		and then GET_STATIC_VALUE(EXP) = CONST_VOID then
		    ERROR(D(LX_SRCPOS, EXP), "Static expression required for number declaration");
		end if;

		-- complete source_name definitions and make visible
		INSERT_OBJ_TYPE_AND_INIT_EXP_IN_S(SOURCE_NAME_S
				, OBJ_TYPE => TYPE_SPEC
				, INIT_EXP => EXP);
	    end;


	when DN_EXCEPTION_DECL =>
	    declare
		SOURCE_NAME_S: TREE := D(AS_SOURCE_NAME_S, NODE);
	    begin
		-- add names to environment
		WALK_SOURCE_NAME_S(SOURCE_NAME_S, H);

		-- check for unique names and make visible
		CHECK_UNIQUE_SOURCE_NAME_S(SOURCE_NAME_S);
	    end;


	when DN_DEFERRED_CONSTANT_DECL =>
	    declare
		SOURCE_NAME_S: TREE := D(AS_SOURCE_NAME_S, NODE);
		NAME: TREE := D(AS_NAME, NODE);

		TYPE_SPEC: TREE;
		TYPESET: TYPESET_TYPE;
	    begin

		-- insert names in the environment
		WALK_SOURCE_NAME_S(SOURCE_NAME_S, H);

		-- evaluate and resolve subtype
		TYPE_SPEC := EVAL_TYPE_MARK(NAME);
		if TYPE_SPEC /= CONST_VOID then
		    -- get subtype spec for the type mark
		    TYPE_SPEC := D(SM_TYPE_SPEC, GET_NAME_DEFN(NAME));
		end if;
		NAME := RESOLVE_TYPE_MARK(NAME);
		D(AS_NAME, NODE, NAME);

		-- check that current declaration is in visible part
		-- ... and that type is private type declared in this region (uncompleted)
		declare
		    BT: constant TREE := GET_BASE_TYPE(TYPE_SPEC);
		    BT_ID: TREE := CONST_VOID;
		begin
		    if BT /= CONST_VOID and then KIND(BT) in CLASS_PRIVATE_SPEC then
			BT_ID := D(XD_SOURCE_NAME, BT);
		    end if;
		    if not H.IS_IN_SPEC
		    or else KIND(BT) not in CLASS_PRIVATE_SPEC
		    or else D(SM_TYPE_SPEC, BT) /= CONST_VOID
		    or else BT_ID = CONST_VOID
		    or else H.REGION_DEF = CONST_VOID
		    or else D(XD_REGION, BT_ID) /= D(XD_SOURCE_NAME, H.REGION_DEF)
		    then
			ERROR(D(LX_SRCPOS,NODE), "Deferred constant not allowed");
		    end if;
		end;

		-- complete source_name definitions and make visible
		INSERT_OBJ_TYPE_AND_INIT_EXP_IN_S(SOURCE_NAME_S
				, OBJ_TYPE => TYPE_SPEC
				, INIT_EXP => CONST_VOID);
	    end;


	when DN_TYPE_DECL =>
	    declare
		SOURCE_NAME: TREE := D(AS_SOURCE_NAME, NODE);
		DSCRMT_DECL_S: TREE := D(AS_DSCRMT_DECL_S, NODE);
		TYPE_DEF: TREE := D(AS_TYPE_DEF, NODE);

		SOURCE_DEF: TREE := MAKE_DEF_FOR_ID(SOURCE_NAME, H);
		TYPE_SPEC: TREE;

		PRIOR_DEF: TREE;
		PRIOR_NAME: TREE;
		PRIOR_SPEC: TREE := CONST_VOID;
		NEW_DSCRMT_DECL_S: TREE := DSCRMT_DECL_S;
		H: H_TYPE := WALK.H;
		S: S_TYPE;
	    begin

		-- if there is a prior definition of the type name
		PRIOR_DEF := GET_PRIOR_DEF(SOURCE_DEF);
		if PRIOR_DEF /= CONST_VOID then

		    -- get the corresponding id
		    PRIOR_NAME := D(XD_SOURCE_NAME, PRIOR_DEF);

		    -- if it is a [limited] private type id
		    if KIND(PRIOR_NAME)
				 in DN_PRIVATE_TYPE_ID .. DN_L_PRIVATE_TYPE_ID
		    then

			-- get the [limited] private type spec
			PRIOR_SPEC := D(SM_TYPE_SPEC, PRIOR_NAME);

			-- if full type already declared
			-- ... or we are in the visible part of a package
			if D(SM_TYPE_SPEC,PRIOR_SPEC) /= CONST_VOID
			or else H.IS_IN_SPEC then

			    -- remember that this one is in error
			    PRIOR_SPEC := CONST_VOID;
			end if;

		    -- else if it is a type id
		    elsif KIND(PRIOR_NAME) = DN_TYPE_ID then

			-- get the corresponding type spec
			PRIOR_SPEC := D(SM_TYPE_SPEC, PRIOR_NAME);

			-- if it is not an incomplete type spec
			-- ... or full type already declared
			if KIND(PRIOR_SPEC) /= DN_INCOMPLETE
			or else D(XD_FULL_TYPE_SPEC, PRIOR_SPEC) /= CONST_VOID
			then

			    -- remember that this one is in error
			    PRIOR_SPEC := CONST_VOID;
			end if;
		    end if;

		    -- if it is not a possible full type def
		    if KIND(TYPE_DEF)
				not in DN_ENUMERATION_DEF .. DN_RECORD_DEF
		    then

			-- it is in error
			PRIOR_SPEC := CONST_VOID;
		    end if;

		    -- if redeclaration is illegal
		    if PRIOR_SPEC = CONST_VOID then

			-- emit message
                        ERROR(D(LX_SRCPOS,NODE), "Redeclaration of type name");

			-- make the prior def in error
			MAKE_DEF_IN_ERROR(PRIOR_DEF);

			-- pretend there was no prior def
			PRIOR_DEF := CONST_VOID;
		    end if;
		end if;

		-- if discriminants were given
		if DSCRMT_DECL_S /= CONST_VOID
		and then not IS_EMPTY(LIST(DSCRMT_DECL_S)) then
		    declare
			DL: SEQ_TYPE := LIST(DSCRMT_DECL_S);
			DD: TREE;
			HAS_DEF: BOOLEAN := FALSE;
			HAS_NODEF: BOOLEAN := FALSE;
			IN_GEN_FRM: constant BOOLEAN := IN_GENERIC_FORMALS;
		    begin
			if IN_GEN_FRM and then KIND(TYPE_DEF) not in DN_PRIVATE_DEF .. DN_L_PRIVATE_DEF then
			    ERROR(D(LX_SRCPOS, NODE),
				  "Discriminant part not allowed for this generic formal type");
			end if;
			while not IS_EMPTY(DL) loop
			    POP(DL, DD);
			    if KIND(DD) = DN_DSCRMT_DECL then
				if D(AS_EXP, DD) /= CONST_VOID then
				    HAS_DEF := TRUE;
				    if IN_GEN_FRM then
					ERROR(D(LX_SRCPOS, DD),
					      "Default value not allowed for generic formal discriminant");
				    end if;
				else
				    HAS_NODEF := TRUE;
				end if;
			    end if;
			end loop;
			if HAS_DEF and then HAS_NODEF then
			    ERROR(D(LX_SRCPOS, DSCRMT_DECL_S),
				  "All or none of the discriminants must have default values");
			end if;
		    end;

		    -- walk the discriminants
                    -- ... (in the record's declarative region)
		    ENTER_REGION(SOURCE_DEF, H, S);
		    --WALK_ITEM_S(DSCRMT_DECL_S, H);
		    FINISH_PARAM_S(DSCRMT_DECL_S, H);
		    LEAVE_REGION(SOURCE_DEF, S);
		    H := WALK.H;

		    if KIND(TYPE_DEF) not in DN_ACCESS_DEF .. DN_L_PRIVATE_DEF
		    and then TYPE_DEF /= CONST_VOID
		    then
			ERROR(D(LX_SRCPOS,DSCRMT_DECL_S),
                                    "Discriminants not allowed");
		    elsif PRIOR_DEF /= CONST_VOID then
			if D(SM_DISCRIMINANT_S,PRIOR_SPEC) = CONST_VOID
			or else IS_EMPTY(LIST(D(SM_DISCRIMINANT_S,PRIOR_SPEC)))
			then
			    ERROR(D(LX_SRCPOS,DSCRMT_DECL_S)
                                   , "First declaration had no discriminants");
			else
			    NEW_DSCRMT_DECL_S
					:= D(SM_DISCRIMINANT_S, PRIOR_SPEC);
			    CONFORM_PARAMETER_LISTS
					( NEW_DSCRMT_DECL_S
					, DSCRMT_DECL_S );
			    NEW_DSCRMT_DECL_S
					:= D(SM_DISCRIMINANT_S, PRIOR_SPEC);
			    if KIND(TYPE_DEF) /= DN_RECORD_DEF then
				ERROR(D(LX_SRCPOS,DSCRMT_DECL_S)
                                            , "Full type must be record");
			    end if;
			end if;
		    end if;
		end if;

		if PRIOR_DEF /= CONST_VOID then
		    D(SM_FIRST, SOURCE_NAME, PRIOR_NAME);
		else
		    PRIOR_DEF := SOURCE_DEF;
		    PRIOR_NAME := SOURCE_NAME;
		end if;

		if TYPE_DEF = CONST_VOID then
		    ENTER_REGION(PRIOR_DEF, H, S);
		    TYPE_SPEC := MAKE_INCOMPLETE
				( SM_DISCRIMINANT_S => NEW_DSCRMT_DECL_S
				, XD_SOURCE_NAME => SOURCE_NAME );
		    LEAVE_REGION(PRIOR_DEF, S);
		else
		    TYPE_SPEC := EVAL_TYPE_DEF
				(TYPE_DEF, PRIOR_NAME, H, NEW_DSCRMT_DECL_S);
		    if KIND(TYPE_DEF) = DN_DERIVED_DEF then
			REMEMBER_DERIVED_DECL(NODE);
		    end if;
		end if;

		D(SM_TYPE_SPEC, SOURCE_NAME, TYPE_SPEC);
		if TYPE_SPEC /= CONST_VOID then
		    if PRIOR_DEF /= SOURCE_DEF then
			REMOVE_DEF_FROM_ENVIRONMENT(SOURCE_DEF);
			if PRIOR_SPEC /= CONST_VOID then
			    if KIND(PRIOR_SPEC) = DN_INCOMPLETE then
				D(XD_FULL_TYPE_SPEC, PRIOR_SPEC, TYPE_SPEC);
			    else
				if KIND(PRIOR_NAME) = DN_PRIVATE_TYPE_ID
				and then IS_LIMITED_TYPE(TYPE_SPEC) then
				    ERROR(D(LX_SRCPOS, TYPE_DEF),
					  "Full declaration of non-limited private type cannot be limited");
				end if;
				if KIND(PRIOR_SPEC) in CLASS_PRIVATE_SPEC
				and then TYPE_CONTAINS_TARGET(TYPE_SPEC, PRIOR_SPEC, 0) then
				    ERROR(D(LX_SRCPOS, TYPE_DEF),
					  "Circular private type declaration");
				else
				    D(SM_TYPE_SPEC, PRIOR_SPEC, TYPE_SPEC);
				    if KIND(PRIOR_NAME) = DN_L_PRIVATE_TYPE_ID then
					for K in 1 .. LP_OUT_COUNT loop
					    if LP_OUT_SPECS(K) = PRIOR_SPEC then
						if IS_LIMITED_TYPE(TYPE_SPEC) then
						    ERROR(D(LX_SRCPOS, TYPE_DEF),
							  "Limited private type used as OUT parameter cannot have limited full type");
						end if;
						exit;
					    end if;
					end loop;
				    end if;
				    -- LRM 7.4.2(7): regenerate predefined operators for visible composite types
				    -- containing this newly completed private type so "=" is available in the private part.
				    if H.REGION_DEF /= CONST_VOID
				    and then D(XD_SOURCE_NAME, H.REGION_DEF) /= CONST_VOID
				    and then (KIND(D(XD_SOURCE_NAME, H.REGION_DEF)) = DN_PACKAGE_ID
					      or else KIND(D(XD_SOURCE_NAME, H.REGION_DEF)) = DN_GENERIC_ID)
				    and then D(SM_SPEC, D(XD_SOURCE_NAME, H.REGION_DEF)) /= CONST_VOID
				    and then KIND(D(SM_SPEC, D(XD_SOURCE_NAME, H.REGION_DEF))) = DN_PACKAGE_SPEC then
					declare
					    VL: SEQ_TYPE := LIST(D(AS_DECL_S1, D(SM_SPEC, D(XD_SOURCE_NAME, H.REGION_DEF))));
					    VD: TREE;
					begin
					    while not IS_EMPTY(VL) loop
						POP(VL, VD);
						if KIND(VD) = DN_TYPE_DECL
						and then (KIND(D(AS_TYPE_DEF, VD)) = DN_RECORD_DEF
							  or else KIND(D(AS_TYPE_DEF, VD))
								  in DN_CONSTRAINED_ARRAY_DEF .. DN_UNCONSTRAINED_ARRAY_DEF) then
						    PREFCNS.GEN_PREDEFINED_OPERATORS
							    (D(SM_TYPE_SPEC, D(AS_SOURCE_NAME, VD)), H);
						end if;
					    end loop;
					end;
				    end if;
				end if;
			    end if;
			end if;
		    else
			MAKE_DEF_VISIBLE(SOURCE_DEF);
		    end if;
		    PREFCNS.GEN_PREDEFINED_OPERATORS
				(GET_BASE_TYPE(TYPE_SPEC), H);
		else
		    MAKE_DEF_IN_ERROR(SOURCE_DEF);
		end if;
	    end;


	when DN_SUBTYPE_DECL =>
	    declare
		SOURCE_NAME: TREE := D(AS_SOURCE_NAME, NODE);
		SUBTYPE_INDICATION: TREE := D(AS_SUBTYPE_INDICATION, NODE);

		SOURCE_DEF: TREE := MAKE_DEF_FOR_ID(SOURCE_NAME, H);
		PRIOR_DEF: TREE;
		TYPE_SPEC: TREE;
	    begin
		TYPE_SPEC := EVAL_TYPE_DEF(SUBTYPE_INDICATION, SOURCE_NAME, H);
		D(SM_TYPE_SPEC, SOURCE_NAME, TYPE_SPEC);
		PRIOR_DEF := GET_PRIOR_DEF(SOURCE_DEF);
		if PRIOR_DEF /= CONST_VOID then
		    ERROR(D(LX_SRCPOS, SOURCE_NAME),
			  "Duplicate declaration - " & PRINTNAME(D(LX_SYMREP, SOURCE_NAME)));
		    MAKE_DEF_IN_ERROR(SOURCE_DEF);
		elsif TYPE_SPEC /= CONST_VOID then
		    MAKE_DEF_VISIBLE(SOURCE_DEF);
		else
		    MAKE_DEF_IN_ERROR(SOURCE_DEF);
		end if;
	    end;


	when DN_TASK_DECL =>
	    declare
		SOURCE_NAME: TREE := D(AS_SOURCE_NAME, NODE);
		DECL_S: TREE := D(AS_DECL_S, NODE);

		H: H_TYPE := WALK.H;
		S: S_TYPE;
		SOURCE_DEF: TREE := MAKE_DEF_FOR_ID(SOURCE_NAME,H);
		PRIOR_DEF: TREE;

		TASK_SPEC: TREE := MAKE_TASK_SPEC
			( SM_DECL_S => DECL_S
			, XD_SOURCE_NAME => SOURCE_NAME );
	    begin
		if KIND(SOURCE_NAME) = DN_TYPE_ID then
		    D(SM_FIRST, SOURCE_NAME, SOURCE_NAME);
		    D(SM_TYPE_SPEC, SOURCE_NAME, TASK_SPEC);
		    PRIOR_DEF := GET_PRIOR_DEF(SOURCE_DEF);
		    if PRIOR_DEF /= CONST_VOID then
			if KIND(D(XD_SOURCE_NAME,PRIOR_DEF))
				 = DN_L_PRIVATE_TYPE_ID
			then
			    REMOVE_DEF_FROM_ENVIRONMENT(SOURCE_DEF);
			    D(SM_FIRST, SOURCE_NAME
				     , D(XD_SOURCE_NAME, PRIOR_DEF));
			    D(SM_TYPE_SPEC
				    , D(SM_TYPE_SPEC
					    , D(XD_SOURCE_NAME, PRIOR_DEF) )
				    , TASK_SPEC);
			    SOURCE_DEF := PRIOR_DEF;
			elsif ( KIND(D(XD_SOURCE_NAME,PRIOR_DEF)) = DN_TYPE_ID
				and then KIND(D(SM_TYPE_SPEC
					    , D(XD_SOURCE_NAME,PRIOR_DEF) ))
					= DN_INCOMPLETE )
			then
			    REMOVE_DEF_FROM_ENVIRONMENT(SOURCE_DEF);
			    D(SM_FIRST, SOURCE_NAME
				     , D(XD_SOURCE_NAME, PRIOR_DEF));
			    D(XD_FULL_TYPE_SPEC
				    , D(SM_TYPE_SPEC
					    , D(XD_SOURCE_NAME, PRIOR_DEF) )
				    , TASK_SPEC);
			    SOURCE_DEF := PRIOR_DEF;
			else
			    ERROR(D(LX_SRCPOS,SOURCE_NAME),
                                        "Duplicate name for task - "
					& PRINTNAME(D(LX_SYMREP,SOURCE_NAME)) );
			    MAKE_DEF_IN_ERROR(SOURCE_DEF);
			end if;
			D(XD_SOURCE_NAME
				, TASK_SPEC
				, D(XD_SOURCE_NAME, SOURCE_DEF) );
		    else
			MAKE_DEF_VISIBLE(SOURCE_DEF);
		    end if;
		else
		    D(SM_OBJ_TYPE, SOURCE_NAME, TASK_SPEC);
		    CHECK_UNIQUE_DEF(SOURCE_DEF);
		end if;

		ENTER_REGION(SOURCE_DEF, H, S);
		WALK_ITEM_S(DECL_S, H);
		LEAVE_REGION(SOURCE_DEF, S);
	    end;


	when DN_GENERIC_DECL =>
	    declare
		SOURCE_NAME: TREE := D(AS_SOURCE_NAME, NODE);
		HEADER: TREE := D(AS_HEADER, NODE);
		ITEM_S: TREE := D(AS_ITEM_S, NODE);
		ITEM_LIST: SEQ_TYPE := LIST(ITEM_S);
		ITEM: TREE;

		H: H_TYPE := WALK.H;
		S: S_TYPE;
		SOURCE_DEF: TREE := MAKE_DEF_FOR_ID(SOURCE_NAME,H);
	    begin
		D(SM_FIRST, SOURCE_NAME, SOURCE_NAME);
		D(SM_SPEC, SOURCE_NAME, HEADER);
		D(SM_GENERIC_PARAM_S, SOURCE_NAME, ITEM_S);

		CHECK_UNIQUE_DEF(SOURCE_DEF);

		ENTER_REGION(SOURCE_DEF, H, S);
		declare
		    PREV_IGF: constant BOOLEAN := IN_GENERIC_FORMALS;
		begin
		    IN_GENERIC_FORMALS := TRUE;
		    while not IS_EMPTY(ITEM_LIST) loop
			POP(ITEM_LIST, ITEM);
			WALK(ITEM, H);
			if KIND(ITEM) in CLASS_PARAM then
			    FINISH_PARAM_DECL(ITEM,H);
			    if KIND(ITEM) = DN_IN then
				declare
				    SN_L: constant SEQ_TYPE := LIST(D(AS_SOURCE_NAME_S, ITEM));
				    SN_1: TREE;
				begin
				    if not IS_EMPTY(SN_L) then
					SN_1 := HEAD(SN_L);
					if D(SM_OBJ_TYPE, SN_1) /= CONST_VOID
					and then IS_LIMITED_TYPE(D(SM_OBJ_TYPE, SN_1)) then
					    ERROR(D(LX_SRCPOS, ITEM),
						  "Generic formal IN object cannot have limited type");
					end if;
				    end if;
				end;
			    end if;
			end if;
		    end loop;
		    IN_GENERIC_FORMALS := PREV_IGF;
		end;
		H.SUBP_SYMREP := D(LX_SYMREP, SOURCE_NAME);
		--if KIND(HEADER) in CLASS_SUBP_ENTRY_HEADER then
		--    WALK_ITEM_S(D(AS_PARAM_S,HEADER), H);
		--end if;
		WALK_HEADER(HEADER, H);
		LEAVE_REGION(SOURCE_DEF, S);
		if GET_PRIOR_DEF(SOURCE_DEF) /= CONST_VOID then
		    ERROR(D(LX_SRCPOS, SOURCE_NAME),
			  "Duplicate generic declaration - " & PRINTNAME(D(LX_SYMREP, SOURCE_NAME)));
		    MAKE_DEF_IN_ERROR(SOURCE_DEF);
		else
		    -- LRM 8.3(1), 12.1(4): generic units are not overloadable and cannot be called uninstantiated
		    MAKE_DEF_VISIBLE(SOURCE_DEF);
		end if;
	    end;


	when DN_SUBPROG_ENTRY_DECL =>
	    declare		SOURCE_NAME: TREE := D(AS_SOURCE_NAME, NODE);
		HEADER: TREE := D(AS_HEADER, NODE);
		UNIT_KIND: TREE := D(AS_UNIT_KIND, NODE);

		H: H_TYPE := WALK.H;
		S: S_TYPE;
		SOURCE_DEF: TREE;
		PRIOR_DEF: TREE;
	    begin
		if KIND(SOURCE_NAME) = DN_OPERATOR_ID then
		    FORCE_UPPER_CASE(SOURCE_NAME);
		    declare
			OP: constant STRING := PRINTNAME(D(LX_SYMREP, SOURCE_NAME));
		    begin
			if OP /= """AND""" and then OP /= """OR""" and then OP /= """XOR"""
			and then OP /= """=""" and then OP /= """/="""
			and then OP /= """<""" and then OP /= """<="""
			and then OP /= """>""" and then OP /= """>="""
			and then OP /= """+""" and then OP /= """-""" and then OP /= """&"""
			and then OP /= """*""" and then OP /= """/"""
			and then OP /= """MOD""" and then OP /= """REM""" and then OP /= """**"""
			and then OP /= """ABS""" and then OP /= """NOT""" then
			    ERROR(D(LX_SRCPOS, SOURCE_NAME), "Invalid operator symbol - " & OP);
			end if;
		    end;
		end if;
		SOURCE_DEF := MAKE_DEF_FOR_ID(SOURCE_NAME,H);
		D(SM_SPEC, SOURCE_NAME, HEADER);
		if KIND(SOURCE_NAME) /= DN_ENTRY_ID then
		    D(SM_FIRST, SOURCE_NAME, SOURCE_NAME);
		    D(SM_UNIT_DESC, SOURCE_NAME, UNIT_KIND);
		end if;

		if HEADER /= CONST_VOID then
		    ENTER_REGION(SOURCE_DEF, H, S);
		    H.SUBP_SYMREP := D(LX_SYMREP, SOURCE_NAME);
		    --WALK_ITEM_S(D(AS_PARAM_S,HEADER), H);
		    WALK_HEADER(HEADER, H);
		    LEAVE_REGION(SOURCE_DEF, S);
		    H := WALK.H;
		end if;
		WALK_UNIT_DESC(SOURCE_NAME, UNIT_KIND, H, HEADER);
		HEADER := D(SM_SPEC, SOURCE_NAME); -- in case instantiation
		if KIND(HEADER) = DN_ENTRY
		and then D(AS_DISCRETE_RANGE, HEADER) /= CONST_VOID then
		    -- it is an entry family
		    MAKE_DEF_VISIBLE(SOURCE_DEF);
		    PRIOR_DEF := GET_PRIOR_DEF(SOURCE_DEF);
		else
		    MAKE_DEF_VISIBLE(SOURCE_DEF, HEADER);
		    PRIOR_DEF := GET_PRIOR_HOMOGRAPH_DEF(SOURCE_DEF);
		end if;
		if PRIOR_DEF /= CONST_VOID then
		    if D(XD_HEADER, PRIOR_DEF) /= CONST_FALSE then
			ERROR(D(LX_SRCPOS,SOURCE_NAME)
                                    , "Duplicate def for subprogram name - "
				      &  PRINTNAME(D(LX_SYMREP,SOURCE_NAME)) );
		    end if;
		    MAKE_DEF_IN_ERROR(SOURCE_DEF);
		else
		    CHECK_EQUALITY_OPERATOR(SOURCE_NAME, H);
		end if;
	    end;


	when DN_PACKAGE_DECL =>
	    declare
		SOURCE_NAME: TREE := D(AS_SOURCE_NAME, NODE);
		HEADER: TREE := D(AS_HEADER, NODE);
		UNIT_KIND: TREE := D(AS_UNIT_KIND, NODE);

		H: H_TYPE := WALK.H;
		S: S_TYPE;
		SOURCE_DEF: TREE := MAKE_DEF_FOR_ID(SOURCE_NAME,H);
	    begin
		D(SM_FIRST, SOURCE_NAME, SOURCE_NAME);
		D(SM_SPEC, SOURCE_NAME, HEADER);
		D(SM_UNIT_DESC, SOURCE_NAME, UNIT_KIND);

		if UNIT_KIND /= CONST_VOID and then KIND(UNIT_KIND) = DN_RENAMES_UNIT then
		    WALK_UNIT_DESC(SOURCE_NAME, UNIT_KIND, H);
		    CHECK_UNIQUE_DEF(SOURCE_DEF);
		else
		    CHECK_UNIQUE_DEF(SOURCE_DEF);
		    WALK_UNIT_DESC(SOURCE_NAME, UNIT_KIND, H);
		end if;
		MAKE_DEF_VISIBLE(SOURCE_DEF);
		if HEADER /= CONST_VOID then
		    ENTER_REGION(SOURCE_DEF, H, S);
		    WALK_HEADER(HEADER, H);
		    LEAVE_REGION(SOURCE_DEF, S);
		end if;
	    end;

	-- for a renaming declaration for an object
	when DN_RENAMES_OBJ_DECL =>
	    declare
		SOURCE_NAME: TREE := D(AS_SOURCE_NAME, NODE);
		NAME: TREE := D(AS_NAME, NODE);
		TYPE_MARK_NAME: TREE := D(AS_TYPE_MARK_NAME, NODE);

		SOURCE_DEF: TREE := MAKE_DEF_FOR_ID(SOURCE_NAME, H);
		BASE_TYPE: TREE;
		TYPESET: TYPESET_TYPE;
	    begin
		-- evaluate and resolve the type mark
		BASE_TYPE := GET_BASE_TYPE(EVAL_TYPE_MARK(TYPE_MARK_NAME));
		TYPE_MARK_NAME := RESOLVE_TYPE_MARK(TYPE_MARK_NAME);
		D(AS_TYPE_MARK_NAME, NODE, TYPE_MARK_NAME);
		if TYPE_MARK_NAME /= CONST_VOID and then GET_NAME_DEFN(TYPE_MARK_NAME) /= CONST_VOID
		and then KIND(GET_NAME_DEFN(TYPE_MARK_NAME)) in CLASS_TYPE_NAME
		and then CONTAINS_UNCOMPLETED_PRIVATE(D(SM_TYPE_SPEC, GET_NAME_DEFN(TYPE_MARK_NAME))) then
		    ERROR(D(LX_SRCPOS, TYPE_MARK_NAME), "Premature use of uncompleted private type in object renaming");
		end if;

		-- evaluate the name being redefined; require same base type
		EVAL_EXP_TYPES(NAME, TYPESET);
		REQUIRE_TYPE(BASE_TYPE, NAME, TYPESET);
		NAME := RESOLVE_EXP(NAME, TYPESET);
		-- LRM 8.5(5): object renaming requires an object name (not literal, named number,
		-- attribute, aggregate, qualified expr, allocator, or discriminant-dependent
		-- subcomponent of an unconstrained variable with defaulted discriminants).
		if NAME /= CONST_VOID then
		    if KIND(NAME) = DN_STRING_LITERAL then
			ERROR(D(LX_SRCPOS, NAME), "Cannot rename a string literal");
		    elsif KIND(NAME) = DN_NUMERIC_LITERAL
		    or else KIND(NAME) = DN_NULL_ACCESS
		    or else KIND(NAME) = DN_AGGREGATE
		    or else KIND(NAME) = DN_QUALIFIED
		    or else KIND(NAME) = DN_CONVERSION
		    or else KIND(NAME) = DN_FUNCTION_CALL
		    or else KIND(NAME) = DN_NULLARY_CALL
		    or else KIND(NAME) = DN_SHORT_CIRCUIT
		    or else KIND(NAME) = DN_RANGE_MEMBERSHIP
		    or else KIND(NAME) = DN_TYPE_MEMBERSHIP
		    or else KIND(NAME) = DN_QUALIFIED_ALLOCATOR
		    or else KIND(NAME) = DN_SUBTYPE_ALLOCATOR
		    or else KIND(NAME) = DN_ATTRIBUTE
		    or else KIND(NAME) = DN_USED_CHAR
		    or else KIND(NAME) = DN_PARENTHESIZED then
			ERROR(D(LX_SRCPOS, NAME), "Object name required in object renaming");
		    else
			declare
			    CUR: TREE := NAME;
			    DEP_DISCR: BOOLEAN := FALSE;
			    UNCON_DEP: BOOLEAN := FALSE;
			    function EXPR_USES_DISCR(E: TREE) return BOOLEAN is
			    begin
				if E = CONST_VOID then return FALSE; end if;
				case KIND(E) is
				when DN_USED_OBJECT_ID =>
				    return D(SM_DEFN, E) /= CONST_VOID
					   and then KIND(D(SM_DEFN, E)) = DN_DISCRIMINANT_ID;
				when DN_PARENTHESIZED =>
				    return EXPR_USES_DISCR(D(AS_EXP, E));
				when DN_CONVERSION =>
				    return EXPR_USES_DISCR(D(AS_EXP, E));
				when DN_QUALIFIED =>
				    return EXPR_USES_DISCR(D(AS_EXP, E));
				when DN_FUNCTION_CALL =>
				    declare
					AL: SEQ_TYPE := LIST(D(AS_GENERAL_ASSOC_S, E));
					A: TREE;
				    begin
					while not IS_EMPTY(AL) loop
					    POP(AL, A);
					    if KIND(A) = DN_ASSOC then
						if EXPR_USES_DISCR(D(AS_EXP, A)) then return TRUE; end if;
					    else
						if EXPR_USES_DISCR(A) then return TRUE; end if;
					    end if;
					end loop;
				    end;
				    return FALSE;
				when others =>
				    return FALSE;
				end case;
			    end EXPR_USES_DISCR;

			    function TYPE_DEP_ON_DISCR(CT: TREE) return BOOLEAN is
			    begin
				if CT = CONST_VOID then return FALSE; end if;
				if KIND(CT) = DN_CONSTRAINED_RECORD then
				    declare
					DS_N: constant TREE := D(SM_NORMALIZED_DSCRMT_S, CT);
					EL: SEQ_TYPE := MAKE;
					E: TREE;
				    begin
					if DS_N /= CONST_VOID then EL := LIST(DS_N); end if;
					while not IS_EMPTY(EL) loop
					    POP(EL, E);
					    if EXPR_USES_DISCR(E) then
						return TRUE;
					    end if;
					end loop;
				    end;
				elsif KIND(CT) = DN_CONSTRAINED_ARRAY then
				    declare
					IS_N: constant TREE := D(SM_INDEX_SUBTYPE_S, CT);
					IL: SEQ_TYPE := MAKE;
					IT: TREE;
				    begin
					if IS_N /= CONST_VOID then IL := LIST(IS_N); end if;
					while not IS_EMPTY(IL) loop
					    POP(IL, IT);
					    if IT /= CONST_VOID and then D(SM_RANGE, IT) /= CONST_VOID
					    and then KIND(D(SM_RANGE, IT)) = DN_RANGE then
						if EXPR_USES_DISCR(D(AS_EXP1, D(SM_RANGE, IT)))
						or else EXPR_USES_DISCR(D(AS_EXP2, D(SM_RANGE, IT))) then
						    return TRUE;
						end if;
					    end if;
					end loop;
				    end;
				elsif KIND(CT) = DN_CONSTRAINED_ACCESS then
				    return TYPE_DEP_ON_DISCR(D(SM_DESIG_TYPE, CT));
				end if;
				return FALSE;
			    end TYPE_DEP_ON_DISCR;

			    function COMP_VAR_OR_DEP(REC_TS, COMP_ID: TREE) return BOOLEAN is
				BT: constant TREE := GET_BASE_STRUCT(REC_TS);
				CL: TREE;
				CT: TREE;
			    begin
				if BT = CONST_VOID or else KIND(BT) /= DN_RECORD then return FALSE; end if;
				CL := D(SM_COMP_LIST, BT);
				if CL /= CONST_VOID and then D(AS_VARIANT_PART, CL) /= CONST_VOID then
				    declare
					DL: SEQ_TYPE := LIST(D(AS_DECL_S, CL));
					IT: TREE;
					IN_F: BOOLEAN := FALSE;
				    begin
					while not IS_EMPTY(DL) loop
					    POP(DL, IT);
					    if KIND(IT) = DN_VARIABLE_DECL then
						declare
						    NS: SEQ_TYPE := LIST(D(AS_SOURCE_NAME_S, IT));
						    SN: TREE;
						begin
						    while not IS_EMPTY(NS) loop
							POP(NS, SN);
							if SN = COMP_ID then IN_F := TRUE; exit; end if;
						    end loop;
						end;
					    end if;
					    exit when IN_F;
					end loop;
					if not IN_F then return TRUE; end if;
				    end;
				end if;
				CT := D(SM_OBJ_TYPE, COMP_ID);
				if CT /= CONST_VOID and then D(SM_DISCRIMINANT_S, BT) /= CONST_VOID
				and then not IS_EMPTY(LIST(D(SM_DISCRIMINANT_S, BT))) then
				    return TYPE_DEP_ON_DISCR(CT);
				end if;
				return FALSE;
			    end COMP_VAR_OR_DEP;
			begin
			    -- Reject renaming of named numbers and enumeration literals
			    declare
				HEAD_DEFN: TREE := CONST_VOID;
				HEAD_NODE: TREE := NAME;
			    begin
				if KIND(HEAD_NODE) = DN_SELECTED then
				    HEAD_NODE := D(AS_DESIGNATOR, HEAD_NODE);
				end if;
				if HEAD_NODE /= CONST_VOID
				and then (KIND(HEAD_NODE) = DN_USED_OBJECT_ID
					  or else KIND(HEAD_NODE) in CLASS_USED_NAME) then
				    HEAD_DEFN := D(SM_DEFN, HEAD_NODE);
				end if;
				if HEAD_DEFN /= CONST_VOID
				and then (KIND(HEAD_DEFN) = DN_NUMBER_ID
					  or else KIND(HEAD_DEFN) = DN_ENUMERATION_ID
					  or else KIND(HEAD_DEFN) = DN_CHARACTER_ID) then
				    ERROR(D(LX_SRCPOS, NAME), "Cannot rename a literal or named number");
				end if;
			    end;
			    while CUR /= CONST_VOID loop
				case KIND(CUR) is
				when DN_SELECTED =>
				    declare
					PFX: constant TREE := D(AS_NAME, CUR);
					DES: constant TREE := D(AS_DESIGNATOR, CUR);
					DF: TREE := CONST_VOID;
				    begin
					if DES /= CONST_VOID and then (KIND(DES) in CLASS_USED_NAME or else KIND(DES) in CLASS_USED_OBJECT) then
					    DF := D(SM_DEFN, DES);
					end if;
					if DF /= CONST_VOID and then KIND(DF) = DN_COMPONENT_ID then
					    if PFX /= CONST_VOID and then D(SM_EXP_TYPE, PFX) /= CONST_VOID then
						declare
						    PT: constant TREE := D(SM_EXP_TYPE, PFX);
						    PB: constant TREE := GET_BASE_STRUCT(PT);
						begin
						    if KIND(PB) = DN_ACCESS then
							UNCON_DEP := FALSE;
							DEP_DISCR := FALSE;
							exit;
						    end if;
						    if COMP_VAR_OR_DEP(PT, DF) then
							DEP_DISCR := TRUE;
						    end if;
						    if DEP_DISCR then
							if KIND(PT) /= DN_CONSTRAINED_RECORD
							and then PB /= CONST_VOID and then KIND(PB) = DN_RECORD
							and then D(SM_DISCRIMINANT_S, PB) /= CONST_VOID
							and then not IS_EMPTY(LIST(D(SM_DISCRIMINANT_S, PB)))
							and then D(AS_EXP, HEAD(LIST(D(SM_DISCRIMINANT_S, PB)))) /= CONST_VOID then
							    UNCON_DEP := TRUE;
							end if;
						    end if;
						end;
					    end if;
					    CUR := PFX;
					else
					    CUR := DES;
					end if;
				    end;
				when DN_INDEXED | DN_SLICE =>
				    declare
					PFX: constant TREE := D(AS_NAME, CUR);
				    begin
					if PFX /= CONST_VOID and then D(SM_EXP_TYPE, PFX) /= CONST_VOID
					and then KIND(GET_BASE_STRUCT(D(SM_EXP_TYPE, PFX))) = DN_ACCESS then
					    UNCON_DEP := FALSE;
					    DEP_DISCR := FALSE;
					    exit;
					end if;
					CUR := PFX;
				    end;
				when DN_CONVERSION =>
				    ERROR(D(LX_SRCPOS, NAME), "Cannot rename a type conversion");
				    exit;
				when DN_FUNCTION_CALL | DN_NULLARY_CALL =>
				    ERROR(D(LX_SRCPOS, NAME), "Cannot rename a subcomponent of a function call value");
				    exit;
				when DN_ALL =>
				    UNCON_DEP := FALSE;
				    DEP_DISCR := FALSE;
				    exit;
				when DN_USED_OBJECT_ID =>
				    if DEP_DISCR then
					declare
					    DF: constant TREE := D(SM_DEFN, CUR);
					begin
					    if DF /= CONST_VOID
					    and then (KIND(DF) = DN_VARIABLE_ID or else KIND(DF) = DN_IN_OUT_ID or else KIND(DF) = DN_OUT_ID) then
						if UNCON_DEP
						or else (KIND(DF) = DN_IN_OUT_ID
							 and then D(XD_REGION, DF) /= CONST_VOID
							 and then KIND(D(XD_REGION, DF)) = DN_GENERIC_ID) then
						    ERROR(D(LX_SRCPOS, NAME),
							  "Cannot rename discriminant-dependent component of unconstrained variable");
						end if;
					    end if;
					end;
				    end if;
				    exit;
				when others =>
				    exit;
				end case;
			    end loop;
			end;
		    end if;
		end if;

		-- if a constant (or in parameter) is being renamed
		if IS_CONSTANT_EXP(NAME) then

		    -- replace variable_id with constant_id
		    -- sm_first added 8-17-91 wbe
		    SOURCE_NAME := MAKE_CONSTANT_ID
			    ( LX_SRCPOS => D(LX_SRCPOS, SOURCE_NAME)
			    , LX_SYMREP => D(LX_SYMREP, SOURCE_NAME)
			    , XD_REGION => D(XD_REGION, SOURCE_NAME) );
		    D(SM_FIRST, SOURCE_NAME, SOURCE_NAME);
		    D(AS_SOURCE_NAME, NODE, SOURCE_NAME);
		    -- fix up def to point to newly-created constant_id
		    D(XD_SOURCE_NAME, SOURCE_DEF, SOURCE_NAME);
		end if;

		-- store remaining attributes of source name
		D(SM_INIT_EXP, SOURCE_NAME, NAME);
		DB(SM_RENAMES_OBJ, SOURCE_NAME, TRUE);
		D(SM_OBJ_TYPE, SOURCE_NAME, D(SM_EXP_TYPE, NAME));

		-- check that source name is unique and make it visible
		CHECK_UNIQUE_DEF(SOURCE_DEF);
	    end;


	when DN_RENAMES_EXC_DECL =>
	    declare
		SOURCE_NAME: TREE := D(AS_SOURCE_NAME, NODE);
		NAME: TREE := D(AS_NAME, NODE);

		SOURCE_DEF: TREE := MAKE_DEF_FOR_ID(SOURCE_NAME, H);
	    begin

		-- walk the redefined exception name
		NAME := WALK_NAME(DN_EXCEPTION_ID, NAME);
		D(AS_NAME, NODE, NAME);

		-- $$$$ what about when name is a renamed exception ?

		-- insert redefined name in source name
		if KIND(NAME) = DN_SELECTED then
		    NAME := D(AS_DESIGNATOR, NAME);
		end if;
		D(SM_RENAMES_EXC, SOURCE_NAME, D(SM_DEFN,NAME));

                -- added 6/29/90 (omitted.  why wasn't it found by acvc?)
		-- check for unique names and make visible
		CHECK_UNIQUE_DEF(SOURCE_DEF);
	    end;


	when DN_NULL_COMP_DECL =>
	    declare
	    begin
		null;
	    end;


	when DN_LENGTH_ENUM_REP =>
	    declare
		NAME: TREE := D(AS_NAME, NODE);
		EXP: TREE := D(AS_EXP, NODE);
	    begin
		-- if it is a length clause
		if KIND(NAME) = DN_ATTRIBUTE then
		    REPCLAU.RESOLVE_LENGTH_REP(NAME,EXP,H);
		    D(AS_EXP, NODE, EXP);

		-- else -- it is an enumeration representation clause
		-- ... (by syntax -- name is used_object_id, exp is aggregate)
		else
		    REPCLAU.RESOLVE_ENUM_REP(NAME,EXP,H);
		    D(AS_NAME, NODE, NAME);
		end if;
	    end;


	when DN_ADDRESS =>
	    declare
		NAME: TREE := D(AS_NAME, NODE);
		EXP: TREE := D(AS_EXP, NODE);
	    begin
		REPCLAU.RESOLVE_ADDRESS_REP(NAME,EXP,H);
		D(AS_NAME, NODE, NAME);
		D(AS_EXP, NODE, EXP);
	    end;


	when DN_RECORD_REP =>
	    declare
		NAME: TREE := D(AS_NAME, NODE);
		ALIGNMENT_CLAUSE: TREE := D(AS_ALIGNMENT_CLAUSE, NODE);
		COMP_REP_S: TREE := D(AS_COMP_REP_S, NODE);
	    begin
		REPCLAU.RESOLVE_RECORD_REP(NAME,ALIGNMENT_CLAUSE,COMP_REP_S,H);
		D(AS_NAME, NODE, NAME);
		D(AS_ALIGNMENT_CLAUSE, NODE, ALIGNMENT_CLAUSE);
		D(AS_COMP_REP_S, NODE, COMP_REP_S);
		if KIND(D(SM_DEFN,NAME)) in CLASS_TYPE_NAME
		and KIND(GET_BASE_TYPE(NAME)) = DN_RECORD then
		    D(SM_REPRESENTATION, GET_BASE_TYPE(NAME), NODE);
		end if;
	    end;


	-- for a use clause (not part of a context clause)
	when DN_USE =>
	    declare
		NAME_S: TREE := D(AS_NAME_S, NODE);

		NAME_LIST: SEQ_TYPE := LIST(NAME_S);
		NAME: TREE;
		NAME_DEFN: TREE;
		NEW_NAME_LIST: SEQ_TYPE := MAKE;
		PACKAGE_DEF: TREE;
	    begin

		-- for each used name
		while not IS_EMPTY(NAME_LIST) loop
		    POP(NAME_LIST, NAME);

		    -- evaluate and resolve package name
		    NAME := WALK_NAME(DN_PACKAGE_ID, NAME);
		    NEW_NAME_LIST := APPEND(NEW_NAME_LIST, NAME);

		    -- get the package id of the original (unrenamed) package
		    loop
			if KIND(NAME) = DN_SELECTED then
			    NAME := D(AS_DESIGNATOR, NAME);
			end if;
			NAME_DEFN := D(SM_DEFN, NAME);
			exit
			    when KIND(NAME_DEFN) /= DN_PACKAGE_ID
			    or else KIND(D(SM_UNIT_DESC, NAME_DEFN))
					/= DN_RENAMES_UNIT;
			NAME := D(AS_NAME, D(SM_UNIT_DESC, NAME_DEFN));
		    end loop;

		    -- if it is indeed a package id (or enclosing generic package)
		    if KIND(NAME_DEFN) = DN_PACKAGE_ID
		    or else (KIND(NAME_DEFN) = DN_GENERIC_ID
			     and then D(SM_SPEC, NAME_DEFN) /= CONST_VOID
			     and then KIND(D(SM_SPEC, NAME_DEFN)) = DN_PACKAGE_SPEC) then

			-- get the def corresponding to the package
			PACKAGE_DEF := GET_DEF_FOR_ID(NAME_DEFN);

			-- if it is not an enclosing region and not used
			if DI(XD_LEX_LEVEL, PACKAGE_DEF) <= 0
			and then not DB(XD_IS_USED, PACKAGE_DEF) then

			    -- mark it used
			    DB(XD_IS_USED, PACKAGE_DEF, TRUE);

			    -- add it to list of used regions
			    SU.USED_PACKAGE_LIST
				    := INSERT(SU.USED_PACKAGE_LIST,PACKAGE_DEF);
			end if;
		    end if;
		end loop;

		-- replace name list with list of resolved names
		LIST(NAME_S, NEW_NAME_LIST);
	    end;


	when DN_PRAGMA =>
	    declare
		USED_NAME_ID: TREE := D(AS_USED_NAME_ID, NODE);
		GENERAL_ASSOC_S: TREE := D(AS_GENERAL_ASSOC_S, NODE);
	    begin
		WALK_PRAGMA(USED_NAME_ID, GENERAL_ASSOC_S, H);
	    end;


	when DN_SUBPROGRAM_BODY =>
	    declare
		SOURCE_NAME: TREE := D(AS_SOURCE_NAME, NODE);
		FIRST_NAME: TREE := D(SM_FIRST, SOURCE_NAME);
		BODY_NODE: TREE := D(AS_BODY, NODE);
		FIRST_HEADER: TREE := CONST_VOID;
		HEADER: TREE := D(AS_HEADER, NODE);
		IS_SEPARATE_CU: constant BOOLEAN := (FIRST_NAME /= SOURCE_NAME);

		H: H_TYPE := WALK.H;
		S: S_TYPE;
		SOURCE_DEF: TREE;
		PRIOR_DEF: TREE;
	    begin
		if KIND(SOURCE_NAME) = DN_OPERATOR_ID then
		    FORCE_UPPER_CASE(SOURCE_NAME);
		    declare
			OP: constant STRING := PRINTNAME(D(LX_SYMREP, SOURCE_NAME));
		    begin
			if OP /= """AND""" and then OP /= """OR""" and then OP /= """XOR"""
			and then OP /= """=""" and then OP /= """/="""
			and then OP /= """<""" and then OP /= """<="""
			and then OP /= """>""" and then OP /= """>="""
			and then OP /= """+""" and then OP /= """-""" and then OP /= """&"""
			and then OP /= """*""" and then OP /= """/"""
			and then OP /= """MOD""" and then OP /= """REM""" and then OP /= """**"""
			and then OP /= """ABS""" and then OP /= """NOT""" then
			    ERROR(D(LX_SRCPOS, SOURCE_NAME), "Invalid operator symbol - " & OP);
			end if;
		    end;
		end if;
		SOURCE_DEF := MAKE_DEF_FOR_ID(SOURCE_NAME,H);
		D(SM_SPEC, SOURCE_NAME, HEADER);
		D(SM_UNIT_DESC, SOURCE_NAME, CONST_VOID);
		--D(XD_BODY, SOURCE_NAME, BODY_NODE);

		if FIRST_NAME = SOURCE_NAME then
		    PRIOR_DEF := GET_PRIOR_DEF(SOURCE_DEF);
		    if PRIOR_DEF /= CONST_VOID
		    and then KIND(D(XD_SOURCE_NAME,PRIOR_DEF)) = DN_GENERIC_ID
		    then
			FIRST_NAME := D(XD_SOURCE_NAME,PRIOR_DEF);
			PRIOR_DEF := GET_DEF_FOR_ID(FIRST_NAME);
		    else
			PRIOR_DEF := SOURCE_DEF;
		    end if;
		else
		    PRIOR_DEF := GET_DEF_FOR_ID(FIRST_NAME);
		    -- library unit with existing subprogram spec
		    -- $$$$ worry about killing prior body in this compilation
		    D(XD_REGION_DEF, PRIOR_DEF, H.REGION_DEF);
		end if;

		if SOURCE_DEF /= PRIOR_DEF
		and then D(SM_SPEC,D(XD_SOURCE_NAME,SOURCE_DEF))
				= D(SM_SPEC,D(XD_SOURCE_NAME,PRIOR_DEF))
		then
		    -- (spec was generated in libphase; do not redo it)
		    null;
		else
		    ENTER_REGION(SOURCE_DEF, H, S);
		    --WALK_ITEM_S(D(AS_PARAM_S,HEADER), H);
		    H.SUBP_SYMREP := D(LX_SYMREP, SOURCE_NAME);
		    if SOURCE_DEF /= PRIOR_DEF
                    and then KIND(FIRST_NAME) = DN_GENERIC_ID then
			-- (spec is generic) - $$$$
                        SWITCH_REGION(FIRST_NAME, SOURCE_DEF);
  		        WALK_HEADER(HEADER, H);
                        SWITCH_REGION(FIRST_NAME, PRIOR_DEF);
                    else
  		        WALK_HEADER(HEADER, H);
		    end if;
	            LEAVE_REGION(SOURCE_DEF, S);
		    H := WALK.H;
		end if;

		if FIRST_NAME = SOURCE_NAME then
		    -- (look for a subprogram declaration)
		    MAKE_DEF_VISIBLE(SOURCE_DEF, HEADER);
		    PRIOR_DEF := GET_PRIOR_HOMOGRAPH_DEF(SOURCE_DEF);
		    if PRIOR_DEF /= CONST_VOID then
			REMOVE_DEF_FROM_ENVIRONMENT(SOURCE_DEF);
			FIRST_NAME := D(XD_SOURCE_NAME, PRIOR_DEF);
		    end if;
		end if;
		if PRIOR_DEF = CONST_VOID then
		    MAKE_DEF_VISIBLE(SOURCE_DEF, HEADER);
		    CHECK_EQUALITY_OPERATOR(SOURCE_NAME, H);
		else
		    if KIND(FIRST_NAME) in CLASS_SUBPROG_NAME
		    or KIND(FIRST_NAME) = DN_GENERIC_ID then
			FIRST_HEADER := D(SM_SPEC, FIRST_NAME);
		    end if;
		    if KIND(FIRST_HEADER) /= KIND(HEADER) then
			if D(XD_HEADER, PRIOR_DEF) /= CONST_FALSE then
			    ERROR(D(LX_SRCPOS,SOURCE_NAME)
                                    , "Duplicate def for subprogram name - "
				      &  PRINTNAME(D(LX_SYMREP,SOURCE_NAME)) );
			end if;
			MAKE_DEF_IN_ERROR(SOURCE_DEF);
			FIRST_NAME := SOURCE_NAME;
		    else
			D(SM_FIRST, SOURCE_NAME, FIRST_NAME);
		    end if;
		end if;

		if FIRST_NAME /= SOURCE_NAME then
		    if not IS_SEPARATE_CU and then HAS_RECORDED_BODY(FIRST_NAME) then
			ERROR(D(LX_SRCPOS, NODE),
			      "Duplicate body for subprogram - "
			      & PRINTNAME(D(LX_SYMREP, SOURCE_NAME)));
		    end if;
		    RECORD_BODY(FIRST_NAME);
		    if KIND(FIRST_NAME) in CLASS_SUBPROG_NAME
		    and then D(SM_INTERFACE, FIRST_NAME) /= CONST_VOID then
			ERROR(D(LX_SRCPOS, NODE), "Body not allowed for interfaced subprogram");
		    elsif KIND(FIRST_NAME) in CLASS_SUBPROG_NAME
		    and then D(SM_UNIT_DESC, FIRST_NAME) /= CONST_VOID
		    and then (KIND(D(SM_UNIT_DESC, FIRST_NAME)) = DN_RENAMES_UNIT
			      or else KIND(D(SM_UNIT_DESC, FIRST_NAME)) = DN_INSTANTIATION) then
			ERROR(D(LX_SRCPOS, NODE), "Body not allowed for subprogram renaming or instantiation");
		    end if;
		    --D(XD_BODY, FIRST_NAME, BODY_NODE);
		    D(SM_SPEC, SOURCE_NAME, D(SM_SPEC, FIRST_NAME));
		    CONFORM_PARAMETER_LISTS
				( D(AS_PARAM_S, D(SM_SPEC, FIRST_NAME))
				, D(AS_PARAM_S, HEADER) );
		    if KIND(HEADER) = DN_FUNCTION_SPEC
		    and then KIND(D(SM_SPEC, FIRST_NAME)) = DN_FUNCTION_SPEC
		    and then not IS_COMPATIBLE_EXPRESSION
				( D(AS_NAME, D(SM_SPEC, FIRST_NAME))
				, D(AS_NAME, HEADER) ) then
			ERROR(D(LX_SRCPOS, HEADER), "Return subtype does not conform to specification");
		    end if;
		    REMOVE_DEF_FROM_ENVIRONMENT(SOURCE_DEF);
		    SOURCE_DEF := PRIOR_DEF;
		end if;

		ENTER_BODY(SOURCE_DEF, H, S);
		if KIND(FIRST_NAME) = DN_GENERIC_ID then
		    MAKE_DEF_VISIBLE(SOURCE_DEF, D(SM_SPEC, FIRST_NAME));
		end if;
		declare
		    PREV_HAS_RET: constant BOOLEAN := FUNC_HAS_RETURN;
		    PREV_CAN_RET: constant BOOLEAN := CAN_RETURN;
		    PREV_IN_HND:  constant BOOLEAN := IN_HANDLER;
		    PREV_STM_B:   constant NATURAL := STM_BARRIER;
		    PREV_LOOP_B:  constant NATURAL := LOOP_BARRIER;
		    IS_FUNC_BODY: BOOLEAN := FALSE;
		begin
		    CAN_RETURN := TRUE;
		    IN_HANDLER := FALSE;
		    STM_BARRIER := STM_SP;
		    LOOP_BARRIER := LOOP_SP;
		    if KIND(D(XD_HEADER,SOURCE_DEF)) = DN_FUNCTION_SPEC then
			H.RETURN_TYPE := GET_BASE_TYPE
					(D(AS_NAME,D(XD_HEADER,SOURCE_DEF)));
			IS_FUNC_BODY := (KIND(BODY_NODE) = DN_BLOCK_BODY);
			FUNC_HAS_RETURN := FALSE;
		    end if;
		    WALK_UNIT_DESC(SOURCE_NAME, BODY_NODE, H);
		    if IS_FUNC_BODY and then not FUNC_HAS_RETURN then
			ERROR(D(LX_SRCPOS, NODE), "Function body must contain a return statement");
		    end if;
		    FUNC_HAS_RETURN := PREV_HAS_RET;
		    CAN_RETURN := PREV_CAN_RET;
		    IN_HANDLER := PREV_IN_HND;
		    STM_BARRIER := PREV_STM_B;
		    LOOP_BARRIER := PREV_LOOP_B;
		end;
		if KIND(FIRST_NAME) = DN_GENERIC_ID then
		    MAKE_DEF_VISIBLE(SOURCE_DEF);
		    if GEN_BODY_CNT < 256 then
			GEN_BODY_CNT := GEN_BODY_CNT + 1;
			GEN_BODY_ID(GEN_BODY_CNT) := FIRST_NAME;
			GEN_BODY_NODE(GEN_BODY_CNT) := NODE;
		    end if;
		    for PI in 1 .. PEND_UNCON_CNT loop
			if PEND_UNCON_GEN(PI) = FIRST_NAME then
			    INSTANT.CHECK_GEN_BODY_UNCON(FIRST_NAME, PEND_UNCON_FRM(PI), NODE, PEND_UNCON_POS(PI));
			end if;
		    end loop;
		    -- Cross-unit pending unconstrained checks persisted by instant.a (bc3204c, bc3205d)
		    declare
			F: TEXT_IO.FILE_TYPE;
			BUF: STRING(1 .. 160);
			BLEN: NATURAL;
			GNAME: constant STRING := PRINTNAME(D(LX_SYMREP, FIRST_NAME));
			GLEN: constant NATURAL := GNAME'LENGTH;
			GPS: constant TREE := D(SM_GENERIC_PARAM_S, FIRST_NAME);
			GPL: SEQ_TYPE;
			GP: TREE;
			FID: TREE;
		    begin
			if GPS /= CONST_VOID then
			    begin
				TEXT_IO.OPEN(F, TEXT_IO.IN_FILE, "ADA__LIB/GEN_UNCON.TXT");
				while not TEXT_IO.END_OF_FILE(F) loop
				    TEXT_IO.GET_LINE(F, BUF, BLEN);
				    if BLEN > GLEN + 1 and then BUF(1 .. GLEN) = GNAME and then BUF(GLEN + 1) = ' ' then
					GPL := LIST(GPS);
					while not IS_EMPTY(GPL) loop
					    POP(GPL, GP);
					    if KIND(GP) = DN_TYPE_DECL then
						FID := D(AS_SOURCE_NAME, GP);
						if FID /= CONST_VOID and then PRINTNAME(D(LX_SYMREP, FID)) = BUF(GLEN + 2 .. BLEN) then
						    INSTANT.CHECK_GEN_BODY_UNCON(FIRST_NAME, FID, NODE, D(LX_SRCPOS, NODE));
						end if;
					    end if;
					end loop;
				    end if;
				end loop;
				TEXT_IO.CLOSE(F);
			    exception
				when others =>
				    if TEXT_IO.IS_OPEN(F) then TEXT_IO.CLOSE(F); end if;
			    end;
			end if;
		    end;
		end if;
		LEAVE_BODY(SOURCE_DEF, S);
	    end;


	when DN_PACKAGE_BODY =>
	    declare
		SOURCE_NAME: TREE := D(AS_SOURCE_NAME, NODE);
		BODY_NODE: TREE := D(AS_BODY, NODE);

		FIRST_NAME: TREE;
		H: H_TYPE := WALK.H;
		S: S_TYPE;
		SOURCE_DEF: TREE;
	    begin
		-- check for library unit with existing package spec
		-- $$$$ worry about killing prior body in this compilation
		FIRST_NAME := D(SM_FIRST, SOURCE_NAME);
		if FIRST_NAME /= SOURCE_NAME then
		    SOURCE_DEF := GET_DEF_FOR_ID(D(SM_FIRST, SOURCE_NAME));
		    D(XD_REGION_DEF, SOURCE_DEF, H.REGION_DEF);
		end if;

		SOURCE_DEF := GET_DEF_IN_REGION(SOURCE_NAME, H);
		if SOURCE_DEF = CONST_VOID then
		    ERROR(D(LX_SRCPOS,NODE)
                                , "No specification found for package - "
				  & PRINTNAME(D(LX_SYMREP,SOURCE_NAME)) );
		    SOURCE_DEF := MAKE_DEF_FOR_ID(SOURCE_NAME, H);
                    D(SM_SPEC, SOURCE_NAME, CONST_VOID); -- avoid crash
		    MAKE_DEF_IN_ERROR(SOURCE_DEF);
		else
		    FIRST_NAME := D(XD_SOURCE_NAME, SOURCE_DEF);
		    if KIND(FIRST_NAME) /= DN_PACKAGE_ID
		    and then (KIND(FIRST_NAME) /= DN_GENERIC_ID
			      or else KIND(D(SM_SPEC,FIRST_NAME))
					/= DN_PACKAGE_SPEC)
		    then
			ERROR(D(LX_SRCPOS,NODE)
                                    , "Duplicate name for package - "
				      & PRINTNAME(D(LX_SYMREP,SOURCE_NAME)) );
			SOURCE_DEF := MAKE_DEF_FOR_ID(SOURCE_NAME, H);
			MAKE_DEF_IN_ERROR(SOURCE_DEF);
			FIRST_NAME := SOURCE_NAME;
		    elsif KIND(FIRST_NAME) = DN_PACKAGE_ID
		    and then D(SM_UNIT_DESC, FIRST_NAME) /= CONST_VOID
		    and then (KIND(D(SM_UNIT_DESC, FIRST_NAME)) = DN_INSTANTIATION
			      or else KIND(D(SM_UNIT_DESC, FIRST_NAME)) = DN_RENAMES_UNIT)
		    then
			ERROR(D(LX_SRCPOS, NODE), "Body not allowed for package instantiation or renaming");
		    elsif D(XD_BODY, FIRST_NAME) /= CONST_VOID
		    or else (D(SM_FIRST, SOURCE_NAME) = SOURCE_NAME
			     and then HAS_RECORDED_BODY(FIRST_NAME)) then
			ERROR(D(LX_SRCPOS,NODE)
                                    , "Duplicate body for package - "
				      & PRINTNAME(D(LX_SYMREP,SOURCE_NAME)) );
		    end if;
		end if;

		D(SM_FIRST, SOURCE_NAME, FIRST_NAME);
		D(SM_SPEC, SOURCE_NAME, D(SM_SPEC, FIRST_NAME));
		D(SM_UNIT_DESC, SOURCE_NAME, CONST_VOID);
		D(XD_REGION, SOURCE_NAME, D(XD_REGION, FIRST_NAME));
		RECORD_BODY(FIRST_NAME);
		if KIND(BODY_NODE) = DN_STUB then
		    WALK_UNIT_DESC(SOURCE_NAME, BODY_NODE, H);
		else
		    -- D(XD_BODY, FIRST_NAME, NODE);
		    -- D(XD_BODY, SOURCE_NAME, NODE);
		    -- D(XD_STUB, SOURCE_NAME, D(XD_STUB, FIRST_NAME));
		    ENTER_BODY(SOURCE_DEF, H, S);
		    -- LRM 3.8.1(5) / 7.4.2(7): activate deferred access-to-incomplete/private ops in body
		    for DAI in 1 .. DEF_ACC_CNT loop
			if DEF_ACC_REG(DAI) = SOURCE_DEF then
			    DEF_ACC_ACT(DAI) := TRUE;
			end if;
		    end loop;
		    -- scan spec for use clauses
		    declare
			SPEC: TREE := D(SM_SPEC, SOURCE_NAME);
		    begin
			if SPEC /= CONST_VOID then
			    REPROCESS_USE_CLAUSES(D(AS_DECL_S1,SPEC), H);
			    REPROCESS_USE_CLAUSES(D(AS_DECL_S2,SPEC), H);
			end if;
		    end;
		    declare
			PREV_CAN_RET: constant BOOLEAN := CAN_RETURN;
			PREV_IN_HND:  constant BOOLEAN := IN_HANDLER;
			PREV_STM_B:   constant NATURAL := STM_BARRIER;
			PREV_LOOP_B:  constant NATURAL := LOOP_BARRIER;
			SPEC: constant TREE := D(SM_SPEC, SOURCE_NAME);
		    begin
			CAN_RETURN := FALSE;
			IN_HANDLER := FALSE;
			STM_BARRIER := STM_SP;
			LOOP_BARRIER := LOOP_SP;
			WALK_UNIT_DESC(SOURCE_NAME, BODY_NODE, H);
			if SPEC /= CONST_VOID and then KIND(SPEC) = DN_PACKAGE_SPEC then
			    CHECK_COMPLETIONS(D(AS_DECL_S1, SPEC));
			    CHECK_COMPLETIONS(D(AS_DECL_S2, SPEC));
			end if;
			CAN_RETURN := PREV_CAN_RET;
			IN_HANDLER := PREV_IN_HND;
			STM_BARRIER := PREV_STM_B;
			LOOP_BARRIER := PREV_LOOP_B;
		    end;
		    LEAVE_BODY(SOURCE_DEF, S);
		    if KIND(FIRST_NAME) = DN_GENERIC_ID then
			if GEN_BODY_CNT < 256 then
			    GEN_BODY_CNT := GEN_BODY_CNT + 1;
			    GEN_BODY_ID(GEN_BODY_CNT) := FIRST_NAME;
			    GEN_BODY_NODE(GEN_BODY_CNT) := NODE;
			end if;
			for PI in 1 .. PEND_UNCON_CNT loop
			    if PEND_UNCON_GEN(PI) = FIRST_NAME then
				INSTANT.CHECK_GEN_BODY_UNCON(FIRST_NAME, PEND_UNCON_FRM(PI), NODE, PEND_UNCON_POS(PI));
			    end if;
			end loop;
			-- Cross-unit pending unconstrained checks persisted by instant.a (bc3204c, bc3205d)
			declare
			    F: TEXT_IO.FILE_TYPE;
			    BUF: STRING(1 .. 160);
			    BLEN: NATURAL;
			    GNAME: constant STRING := PRINTNAME(D(LX_SYMREP, FIRST_NAME));
			    GLEN: constant NATURAL := GNAME'LENGTH;
			    GPS: constant TREE := D(SM_GENERIC_PARAM_S, FIRST_NAME);
			    GPL: SEQ_TYPE;
			    GP: TREE;
			    FID: TREE;
			begin
			    if GPS /= CONST_VOID then
				begin
				    TEXT_IO.OPEN(F, TEXT_IO.IN_FILE, "ADA__LIB/GEN_UNCON.TXT");
				    while not TEXT_IO.END_OF_FILE(F) loop
					TEXT_IO.GET_LINE(F, BUF, BLEN);
					if BLEN > GLEN + 1 and then BUF(1 .. GLEN) = GNAME and then BUF(GLEN + 1) = ' ' then
					    GPL := LIST(GPS);
					    while not IS_EMPTY(GPL) loop
						POP(GPL, GP);
						if KIND(GP) = DN_TYPE_DECL then
						    FID := D(AS_SOURCE_NAME, GP);
						    if FID /= CONST_VOID and then PRINTNAME(D(LX_SYMREP, FID)) = BUF(GLEN + 2 .. BLEN) then
							INSTANT.CHECK_GEN_BODY_UNCON(FIRST_NAME, FID, NODE, D(LX_SRCPOS, NODE));
						    end if;
						end if;
					    end loop;
					end if;
				    end loop;
				    TEXT_IO.CLOSE(F);
				exception
				    when others =>
					if TEXT_IO.IS_OPEN(F) then TEXT_IO.CLOSE(F); end if;
				end;
			    end if;
			end;
		    end if;
		end if;
	    end;


	when DN_TASK_BODY =>
	    declare
		SOURCE_NAME: TREE := D(AS_SOURCE_NAME, NODE);
		BODY_NODE: TREE := D(AS_BODY, NODE);

		H: H_TYPE := WALK.H;
		S: S_TYPE;

		SOURCE_DEF: TREE := MAKE_DEF_FOR_ID(SOURCE_NAME,H);
		PRIOR_DEF: TREE;
		PRIOR_NAME: TREE;
		TASK_TYPE: TREE := CONST_VOID;
	    begin

		PRIOR_DEF := GET_PRIOR_DEF(SOURCE_DEF);
		if PRIOR_DEF /= CONST_VOID then
		    TASK_TYPE := GET_BASE_TYPE(D(XD_SOURCE_NAME,PRIOR_DEF));
		end if;

		D(SM_TYPE_SPEC, SOURCE_NAME, TASK_TYPE);
		D(SM_BODY, SOURCE_NAME, BODY_NODE);
		if KIND(TASK_TYPE) /= DN_TASK_SPEC then
                    ERROR(D(LX_SRCPOS,NODE), "No task [type] declaration");
		    MAKE_DEF_IN_ERROR(SOURCE_DEF);
		    PRIOR_NAME := SOURCE_NAME;
		    TASK_TYPE := CONST_VOID;
		else
		    REMOVE_DEF_FROM_ENVIRONMENT(SOURCE_DEF);
		    PRIOR_NAME := D(XD_SOURCE_NAME, PRIOR_DEF);
		    declare
			IS_SEP_T: constant BOOLEAN := (D(SM_FIRST, SOURCE_NAME) /= SOURCE_NAME);
		    begin
			D(SM_FIRST, SOURCE_NAME, PRIOR_NAME);
			if KIND(PRIOR_NAME) = DN_SUBTYPE_ID
			or else D(SM_DERIVED, TASK_TYPE) /= CONST_VOID then
			    ERROR(D(LX_SRCPOS, SOURCE_NAME),
				  "Task body not allowed for subtype or derived type");
			    TASK_TYPE := CONST_VOID;
			elsif D(XD_BODY, TASK_TYPE) /= CONST_VOID
			or else (not IS_SEP_T and then HAS_RECORDED_BODY(PRIOR_NAME))
			or else (D(XD_STUB, TASK_TYPE) /= CONST_VOID
				    and then KIND(BODY_NODE) = DN_STUB)
			then
			    ERROR(D(LX_SRCPOS,SOURCE_NAME),
					"Duplicate body or stub declaration");
			    TASK_TYPE := CONST_VOID;
			else
			    SOURCE_DEF := PRIOR_DEF;
			    --D(SM_BODY, TASK_TYPE, BODY_NODE);
			end if;
		    end;
		end if;

		if TASK_TYPE /= CONST_VOID then
		    RECORD_BODY(PRIOR_NAME);
		end if;
		if KIND(BODY_NODE) /= DN_STUB then
		    if TASK_TYPE /= CONST_VOID then
			null;
			-- D(XD_BODY, TASK_TYPE, BODY_NODE);
		    end if;
		else
		    if TASK_TYPE /= CONST_VOID then
			null;
			-- D(XD_STUB, TASK_TYPE, SOURCE_NAME);
		    end if;
		end if;

		ENTER_BODY(SOURCE_DEF, H, S);
		declare
		    PREV_CAN_RET: constant BOOLEAN := CAN_RETURN;
		    PREV_IN_HND:  constant BOOLEAN := IN_HANDLER;
		    PREV_STM_B:   constant NATURAL := STM_BARRIER;
		    PREV_LOOP_B:  constant NATURAL := LOOP_BARRIER;
		begin
		    CAN_RETURN := FALSE;
		    IN_HANDLER := FALSE;
		    STM_BARRIER := STM_SP;
		    LOOP_BARRIER := LOOP_SP;
		    WALK_UNIT_DESC(SOURCE_NAME, BODY_NODE, H);
		    CAN_RETURN := PREV_CAN_RET;
		    IN_HANDLER := PREV_IN_HND;
		    STM_BARRIER := PREV_STM_B;
		    LOOP_BARRIER := PREV_LOOP_B;
		end;
		LEAVE_BODY(SOURCE_DEF, S);
	    end;

	end case;

        PUT(" ret "); PUT_LINE(NODE_REP(NODE));

    end WALK;


    procedure WALK_SOURCE_NAME_S(SOURCE_NAME_S: TREE; H: H_TYPE) is
	SOURCE_NAME_LIST: SEQ_TYPE := LIST(SOURCE_NAME_S);
	SOURCE_NAME: TREE;
	DUMMY_DEF: TREE;
    begin
	while not IS_EMPTY(SOURCE_NAME_LIST) loop
	    POP(SOURCE_NAME_LIST, SOURCE_NAME);
	    DUMMY_DEF := MAKE_DEF_FOR_ID(SOURCE_NAME, H);
	end loop;
    end WALK_SOURCE_NAME_S;


    procedure WALK_HEADER(NODE: TREE; H: H_TYPE) is
    begin

        case CLASS_HEADER'(KIND(NODE)) is

	when DN_PROCEDURE_SPEC =>
	    declare
		PARAM_S: TREE := D(AS_PARAM_S, NODE);
	    begin
		FINISH_PARAM_S(PARAM_S, H);
	    end;


	when DN_FUNCTION_SPEC =>
	    declare
		PARAM_S: TREE := D(AS_PARAM_S, NODE);
		NAME: TREE := D(AS_NAME, NODE);
		DUMMY: TREE;
		P_LIST: SEQ_TYPE := LIST(PARAM_S);
		P_ITEM: TREE;
	    begin
		if NAME /= CONST_VOID then -- might be instantiation
		    DUMMY := EVAL_TYPE_MARK(NAME);
		    NAME := RESOLVE_TYPE_MARK(NAME);
		    D(AS_NAME, NODE, NAME);
		end if;
		while not IS_EMPTY(P_LIST) loop
		    POP(P_LIST, P_ITEM);
		    if KIND(P_ITEM) = DN_OUT or else KIND(P_ITEM) = DN_IN_OUT then
			ERROR(D(LX_SRCPOS, P_ITEM), "Function parameter must have mode IN");
		    end if;
		end loop;
		FINISH_PARAM_S(PARAM_S, H);
	    end;


	when DN_ENTRY =>
	    declare
		PARAM_S: TREE := D(AS_PARAM_S, NODE);
		DISCRETE_RANGE: TREE := D(AS_DISCRETE_RANGE, NODE);
		TYPESET: TYPESET_TYPE;
		TYPE_SPEC: TREE;
	    begin
		if DISCRETE_RANGE /= CONST_VOID then
		    EVAL_NON_UNIVERSAL_DISCRETE_RANGE(DISCRETE_RANGE, TYPESET);
		    REQUIRE_UNIQUE_TYPE(DISCRETE_RANGE,TYPESET);
		    TYPE_SPEC := GET_THE_TYPE(TYPESET);
		    if KIND(TYPE_SPEC) = DN_UNIVERSAL_INTEGER then
			--$$$$ check for valid bound expressions
			--$$$$ are we checking that it is discrete ?
			TYPE_SPEC := PREDEFINED_INTEGER;
		    end if;
		    DISCRETE_RANGE
			    := RESOLVE_DISCRETE_RANGE(DISCRETE_RANGE,TYPE_SPEC);
		    D(AS_DISCRETE_RANGE, NODE, DISCRETE_RANGE);
		else
		    TYPE_SPEC := CONST_VOID;
		end if;
		FINISH_PARAM_S(PARAM_S, H);
	    end;


	when DN_PACKAGE_SPEC =>
	    declare
		DECL_S1:	constant TREE := D(AS_DECL_S1, NODE);
		DECL_S2:	constant TREE := D(AS_DECL_S2, NODE);
		H: H_TYPE := WALK_HEADER.H;
	    begin
		DB(XD_BODY_IS_REQUIRED, NODE, FALSE);
		WALK_ITEM_S(DECL_S1, H);
		-- LRM 3.8.1(3): incomplete type declared in visible part must be completed in visible part
		if DECL_S1 /= CONST_VOID then
		    declare
			IL: SEQ_TYPE := LIST(DECL_S1);
			IT: TREE;
			SN: TREE;
		    begin
			while not IS_EMPTY(IL) loop
			    POP(IL, IT);
			    if KIND(IT) = DN_TYPE_DECL then
				SN := D(AS_SOURCE_NAME, IT);
				if SN /= CONST_VOID and then KIND(SN) in CLASS_TYPE_NAME
				and then D(SM_TYPE_SPEC, SN) /= CONST_VOID
				and then KIND(D(SM_TYPE_SPEC, SN)) = DN_INCOMPLETE
				and then D(XD_FULL_TYPE_SPEC, D(SM_TYPE_SPEC, SN)) = CONST_VOID then
				    ERROR(D(LX_SRCPOS, IT),
					  "Incomplete type in visible part must be completed in visible part");
				end if;
			    end if;
			end loop;
		    end;
		end if;
		H.IS_IN_SPEC := FALSE;
		WALK_ITEM_S(DECL_S2, H);
		-- LRM 3.8.1 / AI-00007 (b37212a/b): incomplete type constrained in private part cannot be deferred to body
		if H.REGION_DEF /= CONST_VOID and then D(XD_SOURCE_NAME, H.REGION_DEF) /= CONST_VOID then
		    declare
			PKG_ID: constant TREE := D(XD_SOURCE_NAME, H.REGION_DEF);
		    begin
			for I in 1 .. CONSTR_INC_CNT loop
			    if CONSTR_INC_TS(I) /= CONST_VOID
			    and then D(XD_FULL_TYPE_SPEC, CONSTR_INC_TS(I)) = CONST_VOID
			    and then D(XD_SOURCE_NAME, CONSTR_INC_TS(I)) /= CONST_VOID
			    and then D(XD_REGION, D(XD_SOURCE_NAME, CONSTR_INC_TS(I))) = PKG_ID then
				ERROR(CONSTR_INC_POS(I), "Discriminant constraint not allowed for incomplete type completed in body");
			    end if;
			end loop;
		    end;
		end if;
		DB(XD_BODY_IS_REQUIRED, NODE,
		   DECL_S_REQUIRES_BODY(DECL_S1, ALLOW_INCOMPLETE => FALSE)
		   or else DECL_S_REQUIRES_BODY(DECL_S2, ALLOW_INCOMPLETE => TRUE));
	    end;
	end case;
    end WALK_HEADER;


    procedure SWITCH_REGION (GENERIC_ID, REGION_DEF: TREE) is
        ITEM_LIST: SEQ_TYPE := LIST(D(SM_GENERIC_PARAM_S, GENERIC_ID));
        ITEM: TREE;
        NAME_LIST: SEQ_TYPE;
        NAME: TREE;
    begin
        while not IS_EMPTY(ITEM_LIST) loop
            POP (ITEM_LIST, ITEM);
            case CLASS_ITEM'(KIND(ITEM)) is
            when CLASS_DSCRMT_PARAM_DECL | CLASS_ID_S_DECL =>
                NAME_LIST := LIST(D(AS_SOURCE_NAME_S, ITEM));
                while not IS_EMPTY(NAME_LIST) loop
                    POP(NAME_LIST, NAME);
                    if KIND(D(LX_SYMREP,NAME)) = DN_SYMBOL_REP then
                        D(XD_REGION_DEF
                                , GET_DEF_FOR_ID(NAME)
                                , REGION_DEF );
                    end if; 
                end loop;
            when CLASS_ID_DECL =>
                if KIND(D(LX_SYMREP,D(AS_SOURCE_NAME,ITEM)))
                        = DN_SYMBOL_REP
                then
                    D(XD_REGION_DEF
                            , GET_DEF_FOR_ID(D(AS_SOURCE_NAME, ITEM))
                            , REGION_DEF );
                end if;
            when others =>
                null;
            end case;
        end loop;
    end;


    procedure WALK_UNIT_DESC
		( SOURCE_NAME:	TREE
		; NODE: TREE
		; H: H_TYPE
		; HEADER: TREE := CONST_VOID )
    is
    begin

	if NODE = CONST_VOID then
	    return;
	end if;

        case CLASS_UNIT_DESC'(KIND(NODE)) is

	when DN_RENAMES_UNIT | DN_NAME_DEFAULT =>
	    declare
		NAME: TREE := D(AS_NAME, NODE);
	    begin
		if KIND(SOURCE_NAME) = DN_PACKAGE_ID then
		    NAME := WALK_NAME(DN_PACKAGE_ID, NAME);
		else
		    NAME := WALK_HOMOGRAPH_UNIT
			    ( NAME
			    , HEADER );
		end if;
		D(AS_NAME, NODE, NAME);
	    end;


	when DN_INSTANTIATION =>
	    INSTANT.WALK_INSTANTIATION(SOURCE_NAME, NODE, H);


	when DN_BOX_DEFAULT | DN_NO_DEFAULT =>
	    null;


	when DN_BLOCK_BODY =>
	    -- $$$$ note - block statement treated separately
            -- ... but it doesn't have to be
	    declare
		ITEM_S: TREE := D(AS_ITEM_S, NODE);
		STM_S: TREE := D(AS_STM_S, NODE);
		ALTERNATIVE_S: TREE := D(AS_ALTERNATIVE_S, NODE);
		ALTERNATIVE_LIST: SEQ_TYPE;
		ALTERNATIVE: TREE;
	    begin
		WALK_ITEM_S(ITEM_S, H);
		CHECK_COMPLETIONS(ITEM_S);
		if STM_S /= CONST_VOID then
		    DECLARE_LABEL_BLOCK_LOOP_IDS(STM_S, H);
		end if;
		if ALTERNATIVE_S /= CONST_VOID then
		    ALTERNATIVE_LIST := LIST(ALTERNATIVE_S);
		    while not IS_EMPTY(ALTERNATIVE_LIST) loop
			POP(ALTERNATIVE_LIST, ALTERNATIVE);
			if KIND(ALTERNATIVE) = DN_ALTERNATIVE then
			    DECLARE_LABEL_BLOCK_LOOP_IDS
					(D(AS_STM_S,ALTERNATIVE) ,H);
			end if;
		    end loop;
		end if;
		if STM_S /= CONST_VOID then
		    WALK_STM_S(STM_S, H);
		end if;
		WALK_ALTERNATIVE_S(ALTERNATIVE_S, H);
	    end;


	when DN_STUB =>
	    declare
		ENC_REG: constant TREE := D(XD_REGION_DEF, H.REGION_DEF);
		SYM: constant TREE := D(LX_SYMREP, SOURCE_NAME);
		DUP_STUB: BOOLEAN := FALSE;
	    begin
		-- LRM 10.2(2): body stub only allowed in outermost declarative part of a compilation unit
		if H.LEX_LEVEL > COMPILATION_UNIT_LEX_LEVEL + 1 then
		    ERROR(D(LX_SRCPOS, NODE), "Body stub only allowed in outermost declarative part");
		end if;
		-- LRM 10.2(6): no two stubs in same declarative part may have the same simple name
		for K in 1 .. STUB_COUNT loop
		    if STUB_REGIONS(K) = ENC_REG and then STUB_SYMS(K) = SYM then
			DUP_STUB := TRUE;
			exit;
		    end if;
		end loop;
		if DUP_STUB then
		    ERROR(D(LX_SRCPOS, NODE), "Duplicate body stub name in same declarative part");
		elsif STUB_COUNT < MAX_STUBS then
		    STUB_COUNT := STUB_COUNT + 1;
		    STUB_REGIONS(STUB_COUNT) := ENC_REG;
		    STUB_SYMS(STUB_COUNT) := SYM;
		end if;
	    end;


	when DN_IMPLICIT_NOT_EQ | DN_DERIVED_SUBPROG =>
            QUIT("Walk_Unit_Desc: Invalid node");

	end case;
    end WALK_UNIT_DESC;


    procedure ENTER_REGION(DEF: TREE; H: in out H_TYPE; S: out S_TYPE) is
    begin
	S.SB := SB;
	S.SU := SU;
	H.REGION_DEF := DEF;
	H.LEX_LEVEL := H.LEX_LEVEL + 1;
	DI(XD_LEX_LEVEL, DEF, H.LEX_LEVEL);
	H.IS_IN_SPEC := TRUE;
	H.IS_IN_BODY := FALSE;
	H.RETURN_TYPE := CONST_VOID;
	SU.USED_PACKAGE_LIST := MAKE;
	if REGION_SP < REGION_STACK'LAST then
	    REGION_SP := REGION_SP + 1;
	    REGION_STACK(REGION_SP) := DEF;
	    CURRENT_REGION_DEF := DEF;
	end if;
    end ENTER_REGION;

    procedure LEAVE_REGION(DEF: TREE; S: S_TYPE) is
	PACKAGE_DEF: TREE;
    begin
	if REGION_SP > 0 then
	    REGION_SP := REGION_SP - 1;
	    if REGION_SP > 0 then
		CURRENT_REGION_DEF := REGION_STACK(REGION_SP);
	    else
		CURRENT_REGION_DEF := CONST_VOID;
	    end if;
	end if;
	DI(XD_LEX_LEVEL, DEF, 0);
	while not IS_EMPTY(SU.USED_PACKAGE_LIST) loop
	    POP(SU.USED_PACKAGE_LIST, PACKAGE_DEF);
	    DB(XD_IS_USED, PACKAGE_DEF, FALSE);
	end loop;
	SB := S.SB;
	SU := S.SU;
    end LEAVE_REGION;

    procedure ENTER_BODY(DEF: TREE; H: in out H_TYPE; S: out S_TYPE) is
    begin
	ENTER_REGION(DEF, H, S);
	H.IS_IN_SPEC := FALSE;
	H.IS_IN_BODY := TRUE;
	if KIND(D(XD_SOURCE_NAME, DEF)) = DN_GENERIC_ID
	and then D(XD_HEADER, DEF) /= CONST_FALSE then
	    MAKE_DEF_VISIBLE(DEF, D(SM_SPEC,D(XD_SOURCE_NAME,DEF)));
	end if;
    end ENTER_BODY;

    procedure LEAVE_BODY(DEF: TREE; S: S_TYPE) is
    begin
	LEAVE_REGION(DEF, S);
	if KIND(D(XD_SOURCE_NAME, DEF)) = DN_GENERIC_ID
	and then D(XD_HEADER, DEF) /= CONST_FALSE then
	    MAKE_DEF_VISIBLE(DEF);
	end if;
    end LEAVE_BODY;


    procedure INSERT_OBJ_TYPE_AND_INIT_EXP_IN_S
		( SOURCE_NAME_S:	TREE
		; OBJ_TYPE:		TREE
		; INIT_EXP:		TREE := CONST_VOID
		; DEFER_VISIBLE:	BOOLEAN := FALSE )
    is
	SOURCE_NAME_LIST:	SEQ_TYPE := LIST(SOURCE_NAME_S);
	SOURCE_NAME:		TREE;
	SOURCE_DEF:		TREE;
	PRIOR_NAME:		TREE;
	PRIOR_DEF:		TREE;

	TEMP_OBJ_TYPE:		TREE := OBJ_TYPE;
	TEMP_INIT_EXP:		TREE := INIT_EXP;
    begin
	while not IS_EMPTY(SOURCE_NAME_LIST) loop
	    POP(SOURCE_NAME_LIST, SOURCE_NAME);
	    SOURCE_DEF := GET_DEF_FOR_ID(SOURCE_NAME);
	    if not DEFER_VISIBLE then
		MAKE_DEF_VISIBLE(SOURCE_DEF);
	    end if;
	    PRIOR_DEF := GET_PRIOR_DEF(SOURCE_DEF);
	    D(SM_OBJ_TYPE, SOURCE_NAME, TEMP_OBJ_TYPE);
	    if TEMP_INIT_EXP /= CONST_VOID then
		D(SM_INIT_EXP, SOURCE_NAME, TEMP_INIT_EXP);
	    end if;

	    if OBJ_TYPE = CONST_VOID then
		MAKE_DEF_IN_ERROR(SOURCE_DEF);
	    elsif PRIOR_DEF /= CONST_VOID then
		if KIND(SOURCE_NAME) = DN_CONSTANT_ID then
		    PRIOR_NAME := D(XD_SOURCE_NAME, PRIOR_DEF);
		    if KIND(PRIOR_NAME) = DN_CONSTANT_ID
		    and then D(SM_INIT_EXP,PRIOR_NAME) = CONST_VOID
		    and then GET_BASE_TYPE(D(SM_OBJ_TYPE,PRIOR_NAME))
				= GET_BASE_TYPE(TEMP_OBJ_TYPE)
		    then
			REMOVE_DEF_FROM_ENVIRONMENT(SOURCE_DEF);
			D(SM_FIRST, SOURCE_NAME, PRIOR_NAME);
			-- (Leave type private)
			--D(SM_OBJ_TYPE, PRIOR_NAME, TEMP_OBJ_TYPE);
			D(SM_INIT_EXP, PRIOR_NAME, TEMP_INIT_EXP);
		    else
			ERROR(D(LX_SRCPOS,SOURCE_NAME)
                                    , "Duplicate declaration of constant - "
				      & PRINTNAME(D(LX_SYMREP,SOURCE_NAME)) );
			MAKE_DEF_IN_ERROR(SOURCE_DEF);
		    end if;
		else
		    ERROR(D(LX_SRCPOS,SOURCE_NAME)
                                , "Duplicate declaration - "
				  & PRINTNAME(D(LX_SYMREP,SOURCE_NAME)) );
		    MAKE_DEF_IN_ERROR(SOURCE_DEF);
		end if;
	    elsif not DEFER_VISIBLE then
		MAKE_DEF_VISIBLE(SOURCE_DEF);
	    end if;

	end loop;
    end INSERT_OBJ_TYPE_AND_INIT_EXP_IN_S;


    procedure FINISH_PARAM_S(DECL_S: TREE; H: H_TYPE) is
	DECL_LIST:	SEQ_TYPE := LIST(DECL_S);
	DECL:		TREE;
	SN_LIST:	SEQ_TYPE;
	SN:		TREE;
	SDEF:		TREE;
    begin
	-- LRM 8.3(16) + 6.1(10): walk each param declaration sequentially, deferring
	-- visibility until the end of the formal part so earlier params cannot be
	-- referenced in later defaults, while outer homographs remain visible until
	-- the inner parameter declaration begins.
	while not IS_EMPTY(DECL_LIST) loop
	    POP(DECL_LIST, DECL);
	    WALK(DECL, H);
	    FINISH_PARAM_DECL(DECL, H, DEFER_VISIBLE => TRUE);
	end loop;
	DECL_LIST := LIST(DECL_S);
	while not IS_EMPTY(DECL_LIST) loop
	    POP(DECL_LIST, DECL);
	    SN_LIST := LIST(D(AS_SOURCE_NAME_S, DECL));
	    while not IS_EMPTY(SN_LIST) loop
		POP(SN_LIST, SN);
		SDEF := GET_DEF_FOR_ID(SN);
		if D(XD_HEADER, SDEF) /= CONST_FALSE then
		    MAKE_DEF_VISIBLE(SDEF);
		end if;
	    end loop;
	end loop;
    end FINISH_PARAM_S;


    procedure FINISH_PARAM_DECL
		( NODE: TREE
		; H: H_TYPE
		; DEFER_VISIBLE: BOOLEAN := FALSE ) is
	SOURCE_NAME_S: TREE := D(AS_SOURCE_NAME_S, NODE);
	EXP: TREE := D(AS_EXP, NODE);
	NAME: TREE := D(AS_NAME, NODE);

	TYPE_SPEC: TREE;
	TYPESET: TYPESET_TYPE;
    begin
	TYPE_SPEC := EVAL_TYPE_MARK(NAME);
	NAME := RESOLVE_TYPE_MARK(NAME);
	D(AS_NAME, NODE, NAME);
	declare
	    IS_GEN_FORMAL_OBJ: constant BOOLEAN :=
		IN_GENERIC_FORMALS
		and then H.REGION_DEF /= CONST_VOID
		and then D(XD_SOURCE_NAME, H.REGION_DEF) /= CONST_VOID
		and then KIND(D(XD_SOURCE_NAME, H.REGION_DEF)) = DN_GENERIC_ID;
	begin
	    if IS_GEN_FORMAL_OBJ and then NAME /= CONST_VOID and then GET_NAME_DEFN(NAME) /= CONST_VOID
	    and then KIND(GET_NAME_DEFN(NAME)) in CLASS_TYPE_NAME then
		if CONTAINS_UNCOMPLETED_PRIVATE(D(SM_TYPE_SPEC, GET_NAME_DEFN(NAME))) then
		    ERROR(D(LX_SRCPOS, NAME), "Premature use of uncompleted private type in generic formal");
		end if;
		FREEZE_TYPE(D(SM_TYPE_SPEC, GET_NAME_DEFN(NAME)));
	    end if;

	    if EXP /= CONST_VOID then
		if KIND(NODE) = DN_OUT or else KIND(NODE) = DN_IN_OUT then
		    ERROR(D(LX_SRCPOS, EXP), "Default expression only allowed for IN parameter");
		end if;
		declare
		    PREV_DEF_E: constant BOOLEAN := IN_DEFAULT_EXP;
		    PREV_ALLOW_DC: constant BOOLEAN := ALLOW_DEFERRED_CONST;
		begin
		    IN_DEFAULT_EXP := TRUE;
		    if not IS_GEN_FORMAL_OBJ then
			ALLOW_DEFERRED_CONST := TRUE;
		    end if;
		    EVAL_EXP_TYPES(EXP, TYPESET);
		    REQUIRE_TYPE(GET_BASE_TYPE(TYPE_SPEC), EXP, TYPESET);
		    declare
			SUB_T: TREE := TYPE_SPEC;
		    begin
			if SUB_T /= CONST_VOID and then NAME /= CONST_VOID and then GET_NAME_DEFN(NAME) /= CONST_VOID then
			    SUB_T := D(SM_TYPE_SPEC, GET_NAME_DEFN(NAME));
			end if;
			if EXP /= CONST_VOID and then KIND(EXP) = DN_AGGREGATE
			and then not IS_EMPTY(TYPESET)
			and then SUB_T /= CONST_VOID and then KIND(SUB_T) = DN_CONSTRAINED_ARRAY then
			    EXP := RESOLVE_EXP(EXP, SUB_T);
			else
			    EXP := RESOLVE_EXP(EXP, TYPESET);
			end if;
		    end;
		    IN_DEFAULT_EXP := PREV_DEF_E;
		    ALLOW_DEFERRED_CONST := PREV_ALLOW_DC;
		end;
	    end if;
	end;

	-- get subtype for object
	if TYPE_SPEC /= CONST_VOID then
	    TYPE_SPEC := D(SM_TYPE_SPEC, GET_NAME_DEFN(NAME));
	end if;

	-- LRM 7.4.4(4): OUT parameter may not have a limited type except limited private
	-- declared in the visible part of the same package (or enclosing visible part),
	-- generic formal subprogram, or subprogram renaming.
	if KIND(NODE) = DN_OUT and then TYPE_SPEC /= CONST_VOID
	and then IS_LIMITED_TYPE(TYPE_SPEC) then
	    declare
		BS: constant TREE := GET_BASE_STRUCT(TYPE_SPEC);
		H_SN: TREE := CONST_VOID;
		ENC_REG: TREE := CONST_VOID;
		ALLOWED: BOOLEAN := FALSE;
	    begin
		if H.REGION_DEF /= CONST_VOID then
		    H_SN := D(XD_SOURCE_NAME, H.REGION_DEF);
		    ENC_REG := D(XD_REGION_DEF, H.REGION_DEF);
		end if;
		-- Generic formal subprogram or subprogram renaming: allowed for any limited type
		if H_SN /= CONST_VOID and then KIND(H_SN) in CLASS_SUBPROG_NAME then
		    if D(SM_UNIT_DESC, H_SN) /= CONST_VOID
		    and then (KIND(D(SM_UNIT_DESC, H_SN)) = DN_RENAMES_UNIT
			      or else KIND(D(SM_UNIT_DESC, H_SN)) in DN_BOX_DEFAULT .. DN_NO_DEFAULT)
		    then
			ALLOWED := TRUE;
		    end if;
		end if;
		-- Limited private type in visible part of enclosing package (including nested visible packages/tasks/generics)
		if not ALLOWED and then KIND(BS) = DN_L_PRIVATE
		and then D(SM_DERIVED, BS) = CONST_VOID
		and then D(XD_SOURCE_NAME, BS) /= CONST_VOID then
		    declare
			LP_REG: constant TREE := D(XD_REGION_DEF, GET_DEF_FOR_ID(D(XD_SOURCE_NAME, BS)));
			CHILD: TREE := H.REGION_DEF;
			PARENT: TREE := ENC_REG;
			PSN: TREE;
		    begin
			while CHILD /= CONST_VOID and then PARENT /= CONST_VOID loop
			    if PARENT = LP_REG then
				if DB(XD_IS_IN_SPEC, CHILD) then
				    ALLOWED := TRUE;
				    if LP_OUT_COUNT < MAX_LP_OUT then
					LP_OUT_COUNT := LP_OUT_COUNT + 1;
					LP_OUT_SPECS(LP_OUT_COUNT) := BS;
				    end if;
				end if;
				exit;
			    end if;
			    PSN := D(XD_SOURCE_NAME, PARENT);
			    if KIND(PSN) = DN_PACKAGE_ID
			    or else KIND(PSN) = DN_GENERIC_ID
			    or else (KIND(PSN) in CLASS_TYPE_NAME
				     and then D(SM_TYPE_SPEC, PSN) /= CONST_VOID
				     and then KIND(GET_BASE_TYPE(PSN)) = DN_TASK_SPEC)
			    or else (KIND(PSN) = DN_VARIABLE_ID
				     and then D(SM_OBJ_TYPE, PSN) /= CONST_VOID
				     and then KIND(GET_BASE_STRUCT(D(SM_OBJ_TYPE, PSN))) = DN_TASK_SPEC)
			    then
				CHILD := PARENT;
				PARENT := D(XD_REGION_DEF, CHILD);
			    else
				exit;
			    end if;
			end loop;
		    end;
		end if;
		if not ALLOWED then
		    ERROR(D(LX_SRCPOS, NAME), "OUT parameter cannot have limited type");
		end if;
	    end;
	end if;

	INSERT_OBJ_TYPE_AND_INIT_EXP_IN_S(SOURCE_NAME_S
			, OBJ_TYPE => TYPE_SPEC
			, INIT_EXP => EXP
			, DEFER_VISIBLE => DEFER_VISIBLE);
    end FINISH_PARAM_DECL;


    procedure FINISH_VARIABLE_DECL(NODE: TREE; H: H_TYPE) is
	SOURCE_NAME_S: TREE := D(AS_SOURCE_NAME_S, NODE);
	EXP: TREE := D(AS_EXP, NODE);
	TYPE_DEF: TREE := D(AS_TYPE_DEF, NODE);

	TYPE_SPEC: TREE;
	TYPESET: TYPESET_TYPE;
    begin
	TYPE_SPEC := EVAL_SUBTYPE_INDICATION(TYPE_DEF);
	RESOLVE_SUBTYPE_INDICATION(TYPE_DEF, TYPE_SPEC);
	D(AS_TYPE_DEF, NODE, TYPE_DEF);

	-- LRM 3.6.1 / 3.7.2: record component subtype must be constrained (no unconstrained array or record without default discriminants)
	if TYPE_SPEC /= CONST_VOID then
	    declare
		TBS: constant TREE := GET_BASE_STRUCT(TYPE_SPEC);
	    begin
		if KIND(TYPE_SPEC) = DN_ARRAY then
		    ERROR(D(LX_SRCPOS, TYPE_DEF), "Component subtype must be constrained");
		elsif KIND(TYPE_SPEC) not in CLASS_CONSTRAINED
		and then TBS /= CONST_VOID
		and then (KIND(TBS) = DN_RECORD or else KIND(TBS) in CLASS_PRIVATE_SPEC)
		and then D(SM_DISCRIMINANT_S, TBS) /= CONST_VOID
		and then not IS_EMPTY(LIST(D(SM_DISCRIMINANT_S, TBS)))
		and then D(AS_EXP, HEAD(LIST(D(SM_DISCRIMINANT_S, TBS)))) = CONST_VOID then
		    ERROR(D(LX_SRCPOS, TYPE_DEF), "Component subtype must be constrained");
		end if;
	    end;
	end if;

	if EXP /= CONST_VOID then
	    if not IS_NONLIMITED_TYPE(TYPE_SPEC) then
                ERROR(D(LX_SRCPOS, TYPE_DEF), "Initial value for limited type");
		TYPE_SPEC := CONST_VOID;
	    end if;

	    EVAL_EXP_TYPES(EXP, TYPESET);
	    REQUIRE_TYPE(GET_BASE_TYPE(TYPE_SPEC), EXP, TYPESET);
	    if EXP /= CONST_VOID and then KIND(EXP) = DN_AGGREGATE
	    and then not IS_EMPTY(TYPESET)
	    and then TYPE_SPEC /= CONST_VOID and then KIND(TYPE_SPEC) = DN_CONSTRAINED_ARRAY then
		EXP := RESOLVE_EXP(EXP, TYPE_SPEC);
	    else
		EXP := RESOLVE_EXP(EXP, TYPESET);
	    end if;
	end if;

	INSERT_OBJ_TYPE_AND_INIT_EXP_IN_S(SOURCE_NAME_S
			, OBJ_TYPE => TYPE_SPEC
			, INIT_EXP => EXP);
    end FINISH_VARIABLE_DECL;


    function WALK_EXP_MUST_BE_NAME(NAME: TREE) return TREE is
	NAME_KIND: NODE_NAME := KIND(NAME);
	DEFSET: DEFSET_TYPE;
    begin
	if NAME_KIND = DN_USED_OBJECT_ID
	or NAME_KIND = DN_SELECTED then
	    FIND_VISIBILITY(NAME, DEFSET);
	    REQUIRE_UNIQUE_DEF(NAME, DEFSET);
	    return RESOLVE_NAME(NAME, GET_THE_ID(DEFSET));
	else
            ERROR(D(LX_SRCPOS, NAME), "Name required");
	    return WALK_ERRONEOUS_EXP(NAME);
	end if;
    end WALK_EXP_MUST_BE_NAME;


    function WALK_NAME(ID_KIND: NODE_NAME; NAME: TREE) return TREE is
	NEW_NAME: constant TREE := WALK_EXP_MUST_BE_NAME(NAME);
	NAME_DEFN: TREE := GET_NAME_DEFN(NEW_NAME);
    begin

	if NAME_DEFN = CONST_VOID or else KIND(NAME_DEFN) = ID_KIND then
            null;
        elsif id_kind = dn_package_id
        and then kind(name_defn) = dn_generic_id
        and then kind(d(sm_spec,name_defn)) = dn_package_spec
        and then di(xd_lex_level,get_def_for_id(name_defn)) > 0
        then
            null;
        else
            ERROR(D(LX_SRCPOS, NAME), "Name must be " & NODE_IMAGE(ID_KIND));
	    -- added wbe 9/21/90
	    -- clear defn if wrong kind
	    if KIND(NEW_NAME) = DN_SELECTED then
		D(SM_DEFN, D(AS_DESIGNATOR, NEW_NAME), CONST_VOID);
	    else
		D(SM_DEFN, NEW_NAME, CONST_VOID);
	    end if;
	end if;

	return NEW_NAME;
    end WALK_NAME;


    function WALK_TYPE_MARK(NAME: TREE) return TREE is
	NEW_NAME: constant TREE := WALK_EXP_MUST_BE_NAME(NAME);
	NAME_DEFN: TREE := GET_NAME_DEFN(NEW_NAME);
    begin

	if KIND(NAME_DEFN) not in CLASS_TYPE_NAME
	and then NAME_DEFN /= CONST_VOID then
            ERROR(D(LX_SRCPOS, NAME), "Type mark required");
	end if;

	return NEW_NAME;
    end WALK_TYPE_MARK;


    procedure WALK_DISCRETE_CHOICE_S(CHOICE_S: TREE; TYPE_SPEC: TREE) is
	CHOICE_LIST:	SEQ_TYPE := LIST(CHOICE_S);
	CHOICE: 	TREE;

	NEW_CHOICE_LIST: SEQ_TYPE := MAKE;
	EXP:		TREE;
	TYPESET:	TYPESET_TYPE;
	IS_SUBTYPE:	BOOLEAN;
    begin
	while not IS_EMPTY(CHOICE_LIST) loop
	    POP(CHOICE_LIST, CHOICE);

            case CLASS_CHOICE'(KIND(CHOICE)) is
	    when DN_CHOICE_EXP =>
		EXP := D(AS_EXP, CHOICE);
		EVAL_EXP_SUBTYPE_TYPES(EXP, TYPESET, IS_SUBTYPE);
		REQUIRE_TYPE(TYPE_SPEC, EXP, TYPESET);
		if not IS_SUBTYPE then
		    EXP := RESOLVE_EXP(EXP, GET_THE_TYPE(TYPESET));
		    D(AS_EXP, CHOICE, EXP);
		else
		    EXP := RESOLVE_DISCRETE_RANGE(EXP, GET_THE_TYPE(TYPESET));
		    CHOICE := MAKE_CHOICE_RANGE
				( LX_SRCPOS => D(LX_SRCPOS, CHOICE)
				, AS_DISCRETE_RANGE => EXP );

		end if;
	    when DN_CHOICE_RANGE =>
		EXP := D(AS_DISCRETE_RANGE, CHOICE);
		EVAL_DISCRETE_RANGE(EXP, TYPESET);
		REQUIRE_TYPE(TYPE_SPEC, EXP, TYPESET);
		EXP := RESOLVE_DISCRETE_RANGE(EXP, GET_THE_TYPE(TYPESET));
		D(AS_DISCRETE_RANGE, CHOICE, EXP);

	    when DN_CHOICE_OTHERS =>
		null;
	    end case;

	    NEW_CHOICE_LIST := APPEND(NEW_CHOICE_LIST, CHOICE);
	end loop;
	LIST(CHOICE_S, NEW_CHOICE_LIST);
    end WALK_DISCRETE_CHOICE_S;


    procedure WALK_ITEM_S (ITEM_S: TREE; H: H_TYPE) is
	ITEM_LIST: SEQ_TYPE := LIST(ITEM_S);
	ITEM: TREE;
    begin
	while not IS_EMPTY(ITEM_LIST) loop
	    POP(ITEM_LIST, ITEM);
	    WALK(ITEM,H);
	end loop;
    end WALK_ITEM_S;


    function IS_CONSTANT_EXP (EXP: TREE) return BOOLEAN is
	-- returns True if Exp is a name of a constant (or constant value)
	-- (for purposes of renames, LRM 3.2.1(12) / 8.5(5))
    begin
	if EXP = CONST_VOID then
	    return FALSE;
	end if;
	case KIND(EXP) is
	when DN_USED_OBJECT_ID =>
	    declare
		DF: constant TREE := D(SM_DEFN, EXP);
	    begin
		return DF /= CONST_VOID
		       and then (KIND(DF) = DN_CONSTANT_ID
				 or else KIND(DF) = DN_IN_ID
				 or else KIND(DF) = DN_ITERATION_ID
				 or else KIND(DF) = DN_DISCRIMINANT_ID
				 or else KIND(DF) = DN_NUMBER_ID
				 or else KIND(DF) = DN_ENUMERATION_ID
				 or else KIND(DF) = DN_CHARACTER_ID);
	    end;
	when DN_SELECTED =>
	    declare
		PFX: constant TREE := D(AS_NAME, EXP);
		DES: constant TREE := D(AS_DESIGNATOR, EXP);
		DF: TREE := CONST_VOID;
	    begin
		if DES /= CONST_VOID and then KIND(DES) = DN_USED_OBJECT_ID then
		    DF := D(SM_DEFN, DES);
		end if;
		if DF /= CONST_VOID and then KIND(DF) = DN_DISCRIMINANT_ID then
		    return TRUE;
		elsif DF /= CONST_VOID and then KIND(DF) = DN_COMPONENT_ID then
		    if PFX /= CONST_VOID and then D(SM_EXP_TYPE, PFX) /= CONST_VOID
		    and then KIND(GET_BASE_STRUCT(D(SM_EXP_TYPE, PFX))) = DN_ACCESS then
			return FALSE;
		    end if;
		    return IS_CONSTANT_EXP(PFX);
		else
		    return IS_CONSTANT_EXP(DES);
		end if;
	    end;
	when DN_INDEXED | DN_SLICE =>
	    declare
		PFX: constant TREE := D(AS_NAME, EXP);
	    begin
		if PFX /= CONST_VOID and then D(SM_EXP_TYPE, PFX) /= CONST_VOID
		and then KIND(GET_BASE_STRUCT(D(SM_EXP_TYPE, PFX))) = DN_ACCESS then
		    return FALSE;
		end if;
		return IS_CONSTANT_EXP(PFX);
	    end;
	when DN_ALL =>
	    return FALSE;
	when DN_CONVERSION =>
	    return IS_CONSTANT_EXP(D(AS_EXP, EXP));
	when DN_FUNCTION_CALL | DN_STRING_LITERAL | DN_AGGREGATE | DN_QUALIFIED
	   | DN_NUMERIC_LITERAL | DN_USED_CHAR | DN_ATTRIBUTE =>
	    return TRUE;
	when others =>
	    return FALSE;
	end case;
    end IS_CONSTANT_EXP;


    procedure REPROCESS_USE_CLAUSES(DECL_S: TREE; H: H_TYPE) is
	-- reprocesses use clauses in a package decl for visibility in body
	DECL_LIST: SEQ_TYPE;
	DECL: TREE;
	ITEM_LIST: SEQ_TYPE;
	ITEM: TREE;
	ITEM_DEFN: TREE;
	ITEM_DEF: TREE;
	HOPS: NATURAL;
    begin
	if DECL_S = CONST_VOID then
	    return;
	end if;

	DECL_LIST := LIST(DECL_S);
	while not IS_EMPTY(DECL_LIST) loop
	    POP(DECL_LIST, DECL);
	    if KIND(DECL) = DN_USE then
		ITEM_LIST := LIST(D(AS_NAME_S, DECL));
		while not IS_EMPTY(ITEM_LIST) loop
		    POP(ITEM_LIST, ITEM);
		    HOPS := 0;
		    loop
			if KIND(ITEM) = DN_SELECTED then
			    ITEM := D(AS_DESIGNATOR, ITEM);
			end if;
			if KIND(ITEM) = DN_USED_NAME_ID then
			    ITEM_DEFN := D(SM_DEFN, ITEM);
			else
			    ITEM_DEFN := CONST_VOID;
			end if;
			HOPS := HOPS + 1;
			exit when HOPS > 32
			    or else ITEM_DEFN = CONST_VOID
			    or else KIND(ITEM_DEFN) /= DN_PACKAGE_ID
			    or else D(SM_UNIT_DESC, ITEM_DEFN) = CONST_VOID
			    or else KIND(D(SM_UNIT_DESC, ITEM_DEFN))
					/= DN_RENAMES_UNIT;
			ITEM := D(AS_NAME, D(SM_UNIT_DESC, ITEM_DEFN));
		    end loop;
		    if ITEM_DEFN /= CONST_VOID and then KIND(ITEM_DEFN) = DN_PACKAGE_ID then
			ITEM_DEF := GET_DEF_FOR_ID(ITEM_DEFN);
			if DI(XD_LEX_LEVEL, ITEM_DEF) <= 0
			and then not DB(XD_IS_USED, ITEM_DEF) then
			    DB(XD_IS_USED, ITEM_DEF, TRUE);
			    SU.USED_PACKAGE_LIST
				    := INSERT(SU.USED_PACKAGE_LIST,ITEM_DEF);
			end if;
		    end if;
		end loop;
	    elsif KIND(DECL) = DN_TYPE_DECL
	    and then ( KIND(D(AS_TYPE_DEF, DECL)) = DN_RECORD_DEF
		    or else KIND(D(AS_TYPE_DEF, DECL))
			    in DN_CONSTRAINED_ARRAY_DEF
				    .. DN_UNCONSTRAINED_ARRAY_DEF )
	    then
		PREFCNS.GEN_PREDEFINED_OPERATORS
			(D(SM_TYPE_SPEC,D(AS_SOURCE_NAME,DECL)), H);
	    elsif KIND(DECL) in CLASS_OBJECT_DECL
	    and then KIND(D(AS_TYPE_DEF,DECL)) = DN_CONSTRAINED_ARRAY_DEF then
		declare
		    ID_LIST: SEQ_TYPE := LIST(D(AS_SOURCE_NAME_S,DECL));
		    ID: TREE;
		begin
		    while not IS_EMPTY(ID_LIST) loop
			POP(ID_LIST, ID);
			PREFCNS.GEN_PREDEFINED_OPERATORS(D(SM_OBJ_TYPE,ID), H);
		    end loop;
		end;
	    end if;
	end loop;
    end REPROCESS_USE_CLAUSES;


    procedure FIXUP_CONSTRAINED_ARRAY_OBJECTS(SOURCE_NAME_S: TREE; H: H_TYPE) is
        -- make distinct copies of array type_spec's
	-- ... and generate predefined operators
	SOURCE_NAME_LIST: SEQ_TYPE := LIST(SOURCE_NAME_S);
	SOURCE_NAME: TREE;
	OBJ_TYPE: TREE;
	EXP: TREE;
	CONSTRAINED_SPEC: TREE;
	UNCONSTRAINED_SPEC: TREE;
    begin

	-- get original object type and initialization expression
	POP(SOURCE_NAME_LIST, SOURCE_NAME);
	OBJ_TYPE := D(SM_OBJ_TYPE, SOURCE_NAME);
	EXP := D(SM_INIT_EXP, SOURCE_NAME);

	-- make predefined operators for first object type
	PREFCNS.GEN_PREDEFINED_OPERATORS
		( GET_BASE_TYPE(OBJ_TYPE)
		, H );

	-- for each source name except the first
	while not IS_EMPTY(SOURCE_NAME_LIST) loop
	    POP(SOURCE_NAME_LIST, SOURCE_NAME);

	    -- make copies of type and subtype spec
	    CONSTRAINED_SPEC := COPY_NODE(OBJ_TYPE);
	    UNCONSTRAINED_SPEC
		    := COPY_NODE
			    (D(SM_BASE_TYPE, CONSTRAINED_SPEC));
	    D(XD_SOURCE_NAME, CONSTRAINED_SPEC, SOURCE_NAME);
	    D(XD_SOURCE_NAME, UNCONSTRAINED_SPEC, SOURCE_NAME);
	    D(SM_BASE_TYPE
			, UNCONSTRAINED_SPEC
			, UNCONSTRAINED_SPEC );
	    D(SM_BASE_TYPE
			, CONSTRAINED_SPEC
			, UNCONSTRAINED_SPEC );
	    D(SM_OBJ_TYPE, SOURCE_NAME, CONSTRAINED_SPEC);

	    -- generate predefined operators for created type
	    PREFCNS.GEN_PREDEFINED_OPERATORS
		( GET_BASE_TYPE(UNCONSTRAINED_SPEC)
		, H );

	    -- if an initialization expression was given
	    if EXP /= CONST_VOID then

		-- make a copy of it with the new type
		EXP := COPY_NODE(EXP);
		D(SM_EXP_TYPE, EXP, CONSTRAINED_SPEC);
		D(SM_INIT_EXP, SOURCE_NAME, EXP);
	    end if;
	end loop;
    end FIXUP_CONSTRAINED_ARRAY_OBJECTS;


    procedure CHECK_EQUALITY_OPERATOR(OPERATOR_ID: TREE; H: H_TYPE) is
	SYMREP: TREE;
	NEW_ID: TREE;
    begin
	if KIND(OPERATOR_ID) /= DN_OPERATOR_ID then
	    return;
	end if;

	if EQUAL_SYM = CONST_VOID then
            EQUAL_SYM := STORESYM("""=""");
            NOT_EQUAL_SYM := STORESYM("""/=""");
	end if;

	SYMREP := D(LX_SYMREP, OPERATOR_ID);
	if SYMREP = NOT_EQUAL_SYM then
            ERROR(D(LX_SRCPOS,OPERATOR_ID), "Definition of ""/="" operator");
	end if;

	-- LRM 6.7(2): operator declarations may not have default parameter values and must have valid arity
	declare
	    OP_STR: constant STRING := PRINTNAME(SYMREP);
	    F_SPEC: constant TREE := D(SM_SPEC, OPERATOR_ID);
	    P_LIST: SEQ_TYPE;
	    P_DECL: TREE;
	    SN_LIST: SEQ_TYPE;
	    SN: TREE;
	    P_CNT: NATURAL := 0;
	begin
	    if F_SPEC /= CONST_VOID and then KIND(F_SPEC) = DN_FUNCTION_SPEC then
		P_LIST := LIST(D(AS_PARAM_S, F_SPEC));
		while not IS_EMPTY(P_LIST) loop
		    POP(P_LIST, P_DECL);
		    if D(AS_EXP, P_DECL) /= CONST_VOID then
			ERROR(D(LX_SRCPOS, P_DECL), "Default expression not allowed for operator parameter");
		    end if;
		    SN_LIST := LIST(D(AS_SOURCE_NAME_S, P_DECL));
		    while not IS_EMPTY(SN_LIST) loop
			POP(SN_LIST, SN);
			P_CNT := P_CNT + 1;
		    end loop;
		end loop;
		if OP_STR = """NOT""" or else OP_STR = """ABS""" then
		    if P_CNT /= 1 then
			ERROR(D(LX_SRCPOS, OPERATOR_ID), "Unary operator must have exactly one parameter");
		    end if;
		elsif OP_STR = """+""" or else OP_STR = """-""" then
		    if P_CNT /= 1 and then P_CNT /= 2 then
			ERROR(D(LX_SRCPOS, OPERATOR_ID), "Operator must have one or two parameters");
		    end if;
		elsif SYMREP /= EQUAL_SYM and then SYMREP /= NOT_EQUAL_SYM then
		    if P_CNT /= 2 then
			ERROR(D(LX_SRCPOS, OPERATOR_ID), "Binary operator must have exactly two parameters");
		    end if;
		end if;
	    end if;
	end;

	if SYMREP = EQUAL_SYM then
	    -- LRM 6.7(4) / 8.5(11): explicit "=" requires two parameters of same type
	    -- returning Boolean; non-renaming declarations also require a limited type.
	    declare
		IS_RENAMING: constant BOOLEAN :=
		    D(SM_UNIT_DESC, OPERATOR_ID) /= CONST_VOID
		    and then KIND(D(SM_UNIT_DESC, OPERATOR_ID)) = DN_RENAMES_UNIT;
		F_SPEC: constant TREE := D(SM_SPEC, OPERATOR_ID);
		P_LIST: SEQ_TYPE;
		P_DECL: TREE;
		SN_LIST: SEQ_TYPE;
		SN: TREE;
		P_CNT: NATURAL := 0;
		T1, T2: TREE := CONST_VOID;
		RET_T: TREE := CONST_VOID;
		STILL_LIMITED: BOOLEAN := FALSE;
	    begin
		if F_SPEC /= CONST_VOID and then KIND(F_SPEC) = DN_FUNCTION_SPEC then
		    if D(AS_NAME, F_SPEC) /= CONST_VOID then
			RET_T := GET_BASE_TYPE(D(AS_NAME, F_SPEC));
		    end if;
		    P_LIST := LIST(D(AS_PARAM_S, F_SPEC));
		    while not IS_EMPTY(P_LIST) loop
			POP(P_LIST, P_DECL);
			SN_LIST := LIST(D(AS_SOURCE_NAME_S, P_DECL));
			while not IS_EMPTY(SN_LIST) loop
			    POP(SN_LIST, SN);
			    P_CNT := P_CNT + 1;
			    if P_CNT = 1 then
				T1 := GET_BASE_TYPE(D(SM_OBJ_TYPE, SN));
			    elsif P_CNT = 2 then
				T2 := GET_BASE_TYPE(D(SM_OBJ_TYPE, SN));
			    end if;
			end loop;
		    end loop;
		    if T1 /= CONST_VOID and then KIND(T1) = DN_ARRAY
		    and then D(SM_COMP_TYPE, T1) /= CONST_VOID
		    and then KIND(D(SM_COMP_TYPE, T1)) = DN_L_PRIVATE
		    and then D(XD_SOURCE_NAME, T1) /= CONST_VOID
		    and then D(XD_REGION_DEF, GET_DEF_FOR_ID(D(XD_SOURCE_NAME, T1))) /= H.REGION_DEF
		    then
			STILL_LIMITED := TRUE;
		    end if;
		    if P_CNT /= 2 then
			ERROR(D(LX_SRCPOS, OPERATOR_ID),
			      "Explicit ""="" requires two parameters of same limited type returning Boolean");
		    elsif T1 /= CONST_VOID and then T2 /= CONST_VOID and then RET_T /= CONST_VOID
		    and then (T1 /= T2
			      or else RET_T /= PREDEFINED_BOOLEAN
			      or else (not IS_RENAMING and then IS_NONLIMITED_TYPE(T1) and then not STILL_LIMITED))
		    then
			ERROR(D(LX_SRCPOS, OPERATOR_ID),
			      "Explicit ""="" requires two parameters of same limited type returning Boolean");
		    end if;
		end if;
	    end;
	    NEW_ID := COPY_NODE(OPERATOR_ID);
	    -- set sm_first to the created id
	    D(SM_FIRST, NEW_ID, NEW_ID);
	    D(LX_SYMREP, NEW_ID, NOT_EQUAL_SYM);
	    D(SM_UNIT_DESC
		    , NEW_ID
		    ,  MAKE_IMPLICIT_NOT_EQ
				(SM_EQUAL => OPERATOR_ID) );
	    MAKE_DEF_VISIBLE
		    ( MAKE_DEF_FOR_ID(NEW_ID, H)
		    , D(XD_HEADER, GET_DEF_FOR_ID(OPERATOR_ID)) );
	    D(XD_NOT_EQUAL
		    , OPERATOR_ID
		    , NEW_ID );
            -- construct new formal parameter id's
	    declare
		SPEC: TREE := COPY_NODE(D(SM_SPEC, NEW_ID));
		PARAM_S: TREE := COPY_NODE(D(AS_PARAM_S, SPEC));
		PARAM_LIST: SEQ_TYPE := LIST(PARAM_S);
		PARAM: TREE;
		ID_S: TREE;
		ID_LIST: SEQ_TYPE;
		ID: TREE;
		NEW_ID_LIST: SEQ_TYPE;
		NEW_PARAM_LIST: SEQ_TYPE := MAKE;
	    begin
		while not IS_EMPTY(PARAM_LIST) loop
		    POP(PARAM_LIST, PARAM);
		    PARAM := COPY_NODE(PARAM);
		    ID_S := COPY_NODE(D(AS_SOURCE_NAME_S, PARAM));
		    ID_LIST := LIST(ID_S);
		    NEW_ID_LIST := MAKE;
		    while not IS_EMPTY(ID_LIST) loop
			POP(ID_LIST, ID);
			ID := COPY_NODE(ID);
			D(SM_FIRST, ID, ID);
			NEW_ID_LIST := APPEND(NEW_ID_LIST, ID);
		    end loop;
		    LIST(ID_S, NEW_ID_LIST);
		    D(AS_SOURCE_NAME_S, PARAM, ID_S);
		    NEW_PARAM_LIST := APPEND(NEW_PARAM_LIST, PARAM);
		end loop;
		LIST(PARAM_S, NEW_PARAM_LIST);
		D(AS_PARAM_S, SPEC, PARAM_S);
		D(SM_SPEC, NEW_ID, SPEC);
	    end;
	end if;
    end CHECK_EQUALITY_OPERATOR;

end NODWALK;
