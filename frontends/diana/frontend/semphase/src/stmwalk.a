with TEXT2_IO; use TEXT2_IO; -- for debug
with DIANA, DIANAMAN, DIANATTR; use DIANA, DIANATTR, DIANAMAN;
with DEFUTIL; use DEFUTIL;
with VISUTIL; use VISUTIL;
with SETUTIL; use SETUTIL;
with REQUTIL; use REQUTIL;
with EXPTYPE, EXPRESO; use EXPTYPE, EXPRESO;
with SEMGLOB; use SEMGLOB;
with NODWALK; use NODWALK;
with MAKENOD; use MAKENOD;
with REDSUBP; use REDSUBP;
with DEFWALK; use DEFWALK;
with UARITH;
with CHKSTAT;

package body STMWALK is

    -- count used to generate unique names for blocks and loops without names
    GEN_BLOCK_LOOP_COUNT: NATURAL := 0;

    -- Label owning-stm_s table and active stm_s / loop stacks for goto/exit checks
    MAX_LABELS: constant NATURAL := 1024;
    LBL_IDS: array (1 .. MAX_LABELS) of TREE;
    LBL_STM_S: array (1 .. MAX_LABELS) of TREE;
    LBL_CNT: NATURAL := 0;

    MAX_ACTIVE_STM: constant NATURAL := 256;
    ACTIVE_STM_S: array (1 .. MAX_ACTIVE_STM) of TREE;

    MAX_ACTIVE_LOOPS: constant NATURAL := 256;
    ACTIVE_LOOPS: array (1 .. MAX_ACTIVE_LOOPS) of TREE;

    ------------------------------------------------------------------------
    --		Declare_Label_Block_Loop_Ids				  --
    ------------------------------------------------------------------------

    procedure DECLARE_ONE_LABEL_BLOCK_LOOP_ID
		( SOURCE_NAME:	TREE
		; STM:		TREE
		; H:		H_TYPE );


    procedure CHECK_DUMMY_BLOCK_LOOP_NAME(ID: TREE; PREFIX_TEXT: STRING);
    function TRIM(A: STRING) return STRING;

    procedure DECLARE_LABEL_BLOCK_LOOP_IDS(STM_S: TREE; H: H_TYPE) is
        -- For a sequence of statements, scan for label_id's and
        -- ... block_loop_id's and create def nodes for them. (Label_is's
        -- ... and block_loop_id's are implicitly declared at the end
	-- ... of the declarative part of a block or unit)

	STM_LIST:	SEQ_TYPE := LIST(STM_S);
	STM:		TREE;
    begin

	-- for each statement in the stm_s
	while not IS_EMPTY(STM_LIST) loop
	    POP(STM_LIST, STM);

	    -- if this statement has labels
	    if KIND(STM) = DN_LABELED then
		declare
		    SOURCE_NAME_S: constant TREE := D(AS_SOURCE_NAME_S, STM);
		    STM_NODE: constant TREE := D(AS_STM, STM);

		    SOURCE_NAME_LIST: SEQ_TYPE := LIST(SOURCE_NAME_S);
		    SOURCE_NAME: TREE;
		begin
		    -- for each label on this statement
		    while not IS_EMPTY(SOURCE_NAME_LIST) loop
			POP(SOURCE_NAME_LIST, SOURCE_NAME);

			-- define the label
			DECLARE_ONE_LABEL_BLOCK_LOOP_ID
					(SOURCE_NAME, STM_NODE, H);
			if LBL_CNT < MAX_LABELS then
			    LBL_CNT := LBL_CNT + 1;
			    LBL_IDS(LBL_CNT) := SOURCE_NAME;
			    LBL_STM_S(LBL_CNT) := STM_S;
			end if;
		    end loop;

		    -- strip labels from the statement
		    STM := STM_NODE;
		end;
	    end if;

	    -- Stm now has labels stripped off
	    -- Define block and loop names
	    --	 and scan subordinate statements for labels and names

	    case KIND(STM) is

	    -- for a case statement
	    when DN_CASE =>
		declare
		    ALTERNATIVE_S: constant TREE := D(AS_ALTERNATIVE_S, STM);

		    ALTERNATIVE_LIST: SEQ_TYPE := LIST(ALTERNATIVE_S);
		    ALTERNATIVE: TREE;
		begin

		    -- for each alternative
		    while not IS_EMPTY(ALTERNATIVE_LIST) loop
			POP(ALTERNATIVE_LIST, ALTERNATIVE);

			-- if it is an alternative (rather than a pragma)
			if KIND(ALTERNATIVE) = DN_ALTERNATIVE then

			    -- scan for labels in the sequence of statements
			    DECLARE_LABEL_BLOCK_LOOP_IDS
					( D(AS_STM_S, ALTERNATIVE), H);
			end if;
		    end loop;
		end;

	    -- for an accept statement
	    when DN_ACCEPT =>
		declare
		    STM_S: constant TREE := D(AS_STM_S, STM);
		begin
		    -- scan for labels in the sequence of statements
		    DECLARE_LABEL_BLOCK_LOOP_IDS(STM_S, H);
		end;

	    -- for a loop statement
	    when DN_LOOP =>
		declare
		    SOURCE_NAME: constant TREE := D(AS_SOURCE_NAME, STM);
		    SOURCE_DEF: TREE;
		    STM_S: constant TREE := D(AS_STM_S, STM);
		begin
		    -- make sure there is a name
                    CHECK_DUMMY_BLOCK_LOOP_NAME(SOURCE_NAME, "Loop__");

		    -- define the label
		    DECLARE_ONE_LABEL_BLOCK_LOOP_ID(SOURCE_NAME, STM, H);
		    SOURCE_DEF := GET_DEF_FOR_ID(SOURCE_NAME);

		    -- scan for labels in the sequence of statements
		    DECLARE_LABEL_BLOCK_LOOP_IDS(STM_S, H);
		end;

	    -- for a block statement
	    when DN_BLOCK =>
		declare
		    SOURCE_NAME: constant TREE := D(AS_SOURCE_NAME, STM);
		    BLOCK_BODY: constant TREE := D(AS_BLOCK_BODY, STM);
		begin
		    -- make sure there is a name
                    CHECK_DUMMY_BLOCK_LOOP_NAME(SOURCE_NAME, "Block__");

		    -- define the label
		    DECLARE_ONE_LABEL_BLOCK_LOOP_ID(SOURCE_NAME, STM, H);
		end;

	    -- for a conditional entry call or timed entry call
	    when DN_COND_ENTRY | DN_TIMED_ENTRY =>
		declare
		    STM_S1: constant TREE := D(AS_STM_S1, STM);
		    STM_S2: constant TREE := D(AS_STM_S2, STM);
		begin
		    -- scan for labels in both sequences of statements
		    DECLARE_LABEL_BLOCK_LOOP_IDS(STM_S1, H);
		    DECLARE_LABEL_BLOCK_LOOP_IDS(STM_S2, H);
		end;

	    -- for an if statement or a selective wait statement
	    when DN_IF | DN_SELECTIVE_WAIT =>
		declare
		    TEST_CLAUSE_ELEM_S: constant TREE
				    := D(AS_TEST_CLAUSE_ELEM_S, STM);
		    STM_S: constant TREE := D(AS_STM_S, STM);

		    TEST_CLAUSE_ELEM_LIST: SEQ_TYPE := LIST(TEST_CLAUSE_ELEM_S);
		    TEST_CLAUSE_ELEM: TREE;
		begin

		    -- for each test_clause_elem
		    while not IS_EMPTY(TEST_CLAUSE_ELEM_LIST) loop
			POP(TEST_CLAUSE_ELEM_LIST, TEST_CLAUSE_ELEM);

			-- if it is a test_clause (rather than a pragma)
			if KIND(TEST_CLAUSE_ELEM) in CLASS_TEST_CLAUSE then

			    -- scan for labels in the sequence of statements
			    DECLARE_LABEL_BLOCK_LOOP_IDS
					( D(AS_STM_S, TEST_CLAUSE_ELEM), H);
			end if;
		    end loop;

		    -- scan for labels in the if/wait sequence of statements
		    DECLARE_LABEL_BLOCK_LOOP_IDS(STM_S, H);
		end;

	    when others =>
		null;
	    end case;
	end loop;
    end DECLARE_LABEL_BLOCK_LOOP_IDS;


    procedure DECLARE_ONE_LABEL_BLOCK_LOOP_ID
		( SOURCE_NAME:	TREE
		; STM:		TREE
		; H:		H_TYPE )
    is
	-- (called only by declare_label_block_loop_ids)
	-- creates def node for the source name and sets its sm_stm
	-- ... attribute to the statement referred to

	SOURCE_DEF: TREE := MAKE_DEF_FOR_ID(SOURCE_NAME, H);
	PRIOR_DEF: TREE;
    begin
	PRIOR_DEF := GET_PRIOR_DEF(SOURCE_DEF);
	if PRIOR_DEF /= CONST_VOID then
	    ERROR(D(LX_SRCPOS, SOURCE_NAME),
		  "Duplicate label or identifier - "
		  & PRINTNAME(D(LX_SYMREP, SOURCE_NAME)));
	    MAKE_DEF_IN_ERROR(SOURCE_DEF);
	else
	    MAKE_DEF_VISIBLE(SOURCE_DEF);
	end if;
	D(SM_STM, SOURCE_NAME, STM);
    end DECLARE_ONE_LABEL_BLOCK_LOOP_ID;

    procedure CHECK_DUMMY_BLOCK_LOOP_NAME(ID: TREE; PREFIX_TEXT: STRING) is
    begin
	if D(LX_SYMREP, ID) = CONST_VOID then
	    GEN_BLOCK_LOOP_COUNT := GEN_BLOCK_LOOP_COUNT + 1;
	    D(LX_SYMREP, ID,
		     STORESYM( PREFIX_TEXT
                               & TRIM(INTEGER'IMAGE(GEN_BLOCK_LOOP_COUNT)) ) );
	end if;
    end CHECK_DUMMY_BLOCK_LOOP_NAME;

    function TRIM(A: STRING) return STRING is
        FIRST: NATURAL := A'FIRST;
        LAST: NATURAL := A'LAST;
    begin
        while LAST > 0 and then (A(LAST) = ' ' or A(LAST) = ASCII.HT) loop
	    LAST := LAST - 1;
	end loop;
	if LAST >= FIRST then
            while A(FIRST) = ' ' or A(FIRST) = ASCII.HT loop
		FIRST := FIRST + 1;
	    end loop;
	end if;
	declare
	    RESULT: STRING(1 .. LAST - FIRST + 1) := A(FIRST .. LAST);
	begin
	    return RESULT;
	end;
    end TRIM;

    ------------------------------------------------------------------------
    --		Walk_Stm_S						  --
    ------------------------------------------------------------------------

    procedure WALK_STM_S(STM_S: TREE; H: H_TYPE) is
	STM_LIST: SEQ_TYPE := LIST(STM_S);
	STM: TREE;

	NEW_STM_LIST: SEQ_TYPE := MAKE;
    begin
	if STM_SP < MAX_ACTIVE_STM then
	    STM_SP := STM_SP + 1;
	    ACTIVE_STM_S(STM_SP) := STM_S;
	end if;
	-- for each stm in the sequence of statements
	while not IS_EMPTY(STM_LIST) loop
	    POP(STM_LIST, STM);

	    -- walk the statement and add to new statement list
	    NEW_STM_LIST := APPEND(NEW_STM_LIST, WALK_STM(STM, H));
	end loop;

	-- replace statement list with new statement list
	LIST(STM_S, NEW_STM_LIST);
	if STM_SP > 0 then
	    STM_SP := STM_SP - 1;
	end if;
    end WALK_STM_S;

    ------------------------------------------------------------------------
    --		Walk_Alternative_S					  --
    ------------------------------------------------------------------------

    procedure WALK_ALTERNATIVE_S(ALTERNATIVE_S: TREE; H: H_TYPE) is
	ALTERNATIVE_LIST: SEQ_TYPE;
	ALTERNATIVE_ELEM: TREE;

	CHOICE_S: TREE;
	CHOICE_LIST: SEQ_TYPE;
	CHOICE: TREE;
	CHOICE_EXP: TREE;
	STM_S: TREE;
    begin
	-- if there is no exception part
	if ALTERNATIVE_S = CONST_VOID then

	    -- do nothing and return
	    return;
	end if;

	-- for each element of the alternative list
	declare
	    SEEN_EXCS: array (1 .. 128) of TREE;
	    SEEN_EXC_CNT: NATURAL := 0;
	    HAS_EXC_OTHERS: BOOLEAN := FALSE;
	    EXC_ID: TREE;
	    CAN_EXC: TREE;
	    PREV_IN_H: constant BOOLEAN := IN_HANDLER;
	begin
	ALTERNATIVE_LIST := LIST(ALTERNATIVE_S);
	while not IS_EMPTY(ALTERNATIVE_LIST) loop
	    POP(ALTERNATIVE_LIST, ALTERNATIVE_ELEM);

	    -- if it is an alternative
	    if KIND(ALTERNATIVE_ELEM) = DN_ALTERNATIVE then
		if HAS_EXC_OTHERS then
		    ERROR(D(LX_SRCPOS, ALTERNATIVE_ELEM), "OTHERS exception handler must be last");
		end if;

		-- for each choice
		CHOICE_S := D(AS_CHOICE_S, ALTERNATIVE_ELEM);
		CHOICE_LIST := LIST(CHOICE_S);
		declare
		    CHOICE_CNT: NATURAL := 0;
		    THIS_HAS_OTHERS: BOOLEAN := FALSE;
		begin
		while not IS_EMPTY(CHOICE_LIST) loop
		    POP(CHOICE_LIST, CHOICE);
		    CHOICE_CNT := CHOICE_CNT + 1;

		    -- if it is an others choice
		    if KIND(CHOICE) = DN_CHOICE_OTHERS then
			if HAS_EXC_OTHERS then
			    ERROR(D(LX_SRCPOS, CHOICE), "Duplicate OTHERS exception handler");
			elsif CHOICE_CNT > 1 then
			    ERROR(D(LX_SRCPOS, CHOICE), "OTHERS must be the only choice in exception handler");
			end if;
			HAS_EXC_OTHERS := TRUE;
			THIS_HAS_OTHERS := TRUE;

		    -- else if it is an expression choice
		    elsif KIND(CHOICE) = DN_CHOICE_EXP then
			if THIS_HAS_OTHERS then
			    ERROR(D(LX_SRCPOS, CHOICE), "OTHERS must be the only choice in exception handler");
			end if;

			-- resolve exception name
			CHOICE_EXP := D(AS_EXP, CHOICE);
			CHOICE_EXP := WALK_NAME(DN_EXCEPTION_ID, CHOICE_EXP);
			D(AS_EXP, CHOICE, CHOICE_EXP);

			-- LRM 11.2(4): check duplicate exception choice (chasing renamings)
			EXC_ID := GET_NAME_DEFN(CHOICE_EXP);
			if EXC_ID /= CONST_VOID and then KIND(EXC_ID) = DN_EXCEPTION_ID then
			    CAN_EXC := EXC_ID;
			    for STEP in 1 .. 16 loop
				exit when D(SM_RENAMES_EXC, CAN_EXC) = CONST_VOID;
				declare
				    RN: constant TREE := D(SM_RENAMES_EXC, CAN_EXC);
				    NEXT_ID: TREE := CONST_VOID;
				begin
				    if KIND(RN) = DN_EXCEPTION_ID then
					NEXT_ID := RN;
				    elsif KIND(RN) = DN_SELECTED
				    or else KIND(RN) in CLASS_DESIGNATOR then
					NEXT_ID := GET_NAME_DEFN(RN);
				    end if;
				    exit when NEXT_ID = CONST_VOID or else NEXT_ID = CAN_EXC;
				    CAN_EXC := NEXT_ID;
				end;
			    end loop;
			    for K in 1 .. SEEN_EXC_CNT loop
				if SEEN_EXCS(K) = CAN_EXC then
				    ERROR(D(LX_SRCPOS, CHOICE), "Duplicate exception handler choice");
				    exit;
				end if;
			    end loop;
			    if SEEN_EXC_CNT < 128 then
				SEEN_EXC_CNT := SEEN_EXC_CNT + 1;
				SEEN_EXCS(SEEN_EXC_CNT) := CAN_EXC;
			    end if;
			end if;

		    -- else
		    else

			-- it cannot be a valid choice
                        ERROR(D(LX_SRCPOS,CHOICE), "Invalid choice");
		    end if;

		-- walk the statement sequence
		end loop;
		end;
		STM_S := D(AS_STM_S, ALTERNATIVE_ELEM);
		IN_HANDLER := TRUE;
		WALK_STM_S(STM_S, H);
		IN_HANDLER := PREV_IN_H;

	    -- else -- since it must be a pragma
	    else

		-- walk the pragma
		WALK(D(AS_PRAGMA, ALTERNATIVE_ELEM), H);

	    end if;
	end loop;
	end;

    end WALK_ALTERNATIVE_S;

    ------------------------------------------------------------------------
    --		Walk_Stm						  --
    ------------------------------------------------------------------------

    function WALK_STM (STM_IN: TREE; H: H_TYPE) return TREE is
	STM: TREE := STM_IN;
	STM_KIND: NODE_NAME := KIND(STM);
    begin

        PUT("Wstm "); PUT(NODE_REP(STM)); NEW_LINE;
	if STM_KIND not in CLASS_STM_ELEM then
            QUIT("Walk_Stm: Not a stm_elem node");
	end if;


        case CLASS_STM_ELEM'(STM_KIND) is

	-- for terminate or null statement
	when  DN_TERMINATE | DN_NULL_STM =>

	    -- nothing needs to be done
	    null;


	-- for a labeled statement
	when DN_LABELED =>
	    declare
		--SOURCE_NAME_S: constant TREE := D(AS_SOURCE_NAME_S, stm);
		PRAGMA_S: constant TREE := D(AS_PRAGMA_S, STM);
		STM_NODE: TREE := D(AS_STM, STM);
	    begin
		-- $$$$ need to check for duplicate def in unit
		--WALK(SOURCE_NAME_S, H);

		-- walk pragmas between the labels and the statement
		WALK_ITEM_S(PRAGMA_S, H);

		-- walk the statement
		STM_NODE := WALK_STM(STM_NODE, H);
		D(AS_STM, STM, STM_NODE);
	    end;


	-- for an abort statement
	when DN_ABORT =>
	    declare
		NAME_S: constant TREE := D(AS_NAME_S, STM);

		NAME_LIST: SEQ_TYPE := LIST(NAME_S);
		NAME: TREE;
		TYPESET: TYPESET_TYPE;
		NEW_NAME_LIST: SEQ_TYPE := MAKE;
	    begin
		-- for each name in the sequence of names
		while not IS_EMPTY(NAME_LIST) loop
		    POP(NAME_LIST, NAME);

		    -- process the name
		    EVAL_EXP_TYPES(NAME, TYPESET);
		    REQUIRE_TASK_TYPE(NAME, TYPESET);
		    REQUIRE_UNIQUE_TYPE(NAME, TYPESET);
		    NAME := RESOLVE_EXP(NAME, TYPESET);

		    -- add to new name list
		    NEW_NAME_LIST := APPEND(NEW_NAME_LIST, NAME);

		-- replace name list with new name list
		end loop;
		LIST(NAME_S, NEW_NAME_LIST);
	    end;


	-- for a return statement
	when DN_RETURN =>
	    declare
		EXP: TREE := D(AS_EXP, STM);

		TYPESET: TYPESET_TYPE;
	    begin
		if not CAN_RETURN then
		    ERROR(D(LX_SRCPOS, STM), "Return statement not allowed here");
		end if;

		-- if an expression is given
		if EXP /= CONST_VOID then

		    if H.RETURN_TYPE = CONST_VOID then
			ERROR(D(LX_SRCPOS, STM), "Return expression only allowed in function");
		    else
			FUNC_HAS_RETURN := TRUE;
			-- resolve the expression
			EVAL_EXP_TYPES(EXP, TYPESET);
			REQUIRE_TYPE(H.RETURN_TYPE, EXP, TYPESET);
			EXP := RESOLVE_EXP(EXP, TYPESET);
			D(AS_EXP, STM, EXP);
		    end if;

		else -- since there is no expression given

		    if H.RETURN_TYPE /= CONST_VOID then
			ERROR(D(LX_SRCPOS, STM), "Return statement in function requires expression");
		    end if;

		end if;
	    end;


	-- for a delay statement
	when DN_DELAY =>
	    declare
		EXP: TREE := D(AS_EXP, STM);

		TYPESET: TYPESET_TYPE;
	    begin

		-- require expression to be of type duration
		EVAL_EXP_TYPES(EXP, TYPESET);
		REQUIRE_TYPE(GET_BASE_TYPE(PREDEFINED_DURATION), EXP, TYPESET);
		EXP := RESOLVE_EXP(EXP, TYPESET);
		D(AS_EXP, STM, EXP);
	    end;


	-- for an assignment statement
	when DN_ASSIGN =>
	    declare
		EXP: TREE := D(AS_EXP, STM);
		NAME: TREE := D(AS_NAME, STM);

		NAME_TYPESET: TYPESET_TYPE;
		EXP_TYPESET: TYPESET_TYPE;
		TYPESET: TYPESET_TYPE;
	    begin
		-- require same nonlimited type
		EVAL_EXP_TYPES(NAME, NAME_TYPESET);
		EVAL_EXP_TYPES(EXP, EXP_TYPESET);
		REQUIRE_NONLIMITED_TYPE(NAME, NAME_TYPESET);
		REQUIRE_SAME_TYPES
			( NAME, NAME_TYPESET
			, EXP, EXP_TYPESET
			, TYPESET );

		-- resolve exp
		EXP := RESOLVE_EXP(EXP, TYPESET);
		D(AS_EXP, STM, EXP);

		-- resolve name
		NAME := RESOLVE_EXP(NAME, TYPESET);
		D(AS_NAME, STM, NAME);

		-- LRM 6.2(5): RHS of assignment cannot read an OUT parameter (b62006b/e, b85007b, b95074a)
		CHECK_NO_OUT_READ(EXP);
		-- Also cannot implicitly/explicitly dereference an OUT access param or read OUT param in LHS indices
		declare
		    L_CUR: TREE := NAME;
		begin
		    while L_CUR /= CONST_VOID loop
			case KIND(L_CUR) is
			when DN_SELECTED =>
			    declare
				PFX: constant TREE := D(AS_NAME, L_CUR);
			    begin
				if PFX /= CONST_VOID and then KIND(PFX) in CLASS_EXP
				and then KIND(PFX) /= DN_USED_NAME_ID
				and then KIND(PFX) /= DN_USED_OP
				and then KIND(PFX) /= DN_USED_CHAR
				and then D(SM_EXP_TYPE, PFX) /= CONST_VOID
				and then KIND(GET_BASE_STRUCT(D(SM_EXP_TYPE, PFX))) = DN_ACCESS then
				    CHECK_NO_OUT_READ(PFX);
				    exit;
				end if;
				L_CUR := PFX;
			    end;
			when DN_INDEXED =>
			    if D(AS_EXP_S, L_CUR) /= CONST_VOID then
				declare
				    IL: SEQ_TYPE := LIST(D(AS_EXP_S, L_CUR));
				    IT: TREE;
				begin
				    while not IS_EMPTY(IL) loop
					POP(IL, IT);
					CHECK_NO_OUT_READ(IT);
				    end loop;
				end;
			    end if;
			    declare
				PFX: constant TREE := D(AS_NAME, L_CUR);
			    begin
				if PFX /= CONST_VOID and then KIND(PFX) in CLASS_EXP
				and then KIND(PFX) /= DN_USED_NAME_ID
				and then KIND(PFX) /= DN_USED_OP
				and then KIND(PFX) /= DN_USED_CHAR
				and then D(SM_EXP_TYPE, PFX) /= CONST_VOID
				and then KIND(GET_BASE_STRUCT(D(SM_EXP_TYPE, PFX))) = DN_ACCESS then
				    CHECK_NO_OUT_READ(PFX);
				    exit;
				end if;
				L_CUR := PFX;
			    end;
			when DN_SLICE =>
			    if D(AS_DISCRETE_RANGE, L_CUR) /= CONST_VOID
			    and then KIND(D(AS_DISCRETE_RANGE, L_CUR)) = DN_RANGE then
				CHECK_NO_OUT_READ(D(AS_EXP1, D(AS_DISCRETE_RANGE, L_CUR)));
				CHECK_NO_OUT_READ(D(AS_EXP2, D(AS_DISCRETE_RANGE, L_CUR)));
			    end if;
			    declare
				PFX: constant TREE := D(AS_NAME, L_CUR);
			    begin
				if PFX /= CONST_VOID and then KIND(PFX) in CLASS_EXP
				and then KIND(PFX) /= DN_USED_NAME_ID
				and then KIND(PFX) /= DN_USED_OP
				and then KIND(PFX) /= DN_USED_CHAR
				and then D(SM_EXP_TYPE, PFX) /= CONST_VOID
				and then KIND(GET_BASE_STRUCT(D(SM_EXP_TYPE, PFX))) = DN_ACCESS then
				    CHECK_NO_OUT_READ(PFX);
				    exit;
				end if;
				L_CUR := PFX;
			    end;
			when DN_ALL =>
			    CHECK_NO_OUT_READ(D(AS_NAME, L_CUR));
			    exit;
			when others =>
			    exit;
			end case;
		    end loop;
		end;

		-- Check that target name is a variable (not constant, in param, loop var, function call, etc.)
		declare
		    BASE_N: TREE := NAME;
		    BAD_LHS: Boolean := False;
		begin
		    while BASE_N /= CONST_VOID loop
			case KIND(BASE_N) is
			when DN_INDEXED | DN_SLICE =>
			    declare
				PFX: constant TREE := D(AS_NAME, BASE_N);
				PT: TREE := CONST_VOID;
			    begin
				if PFX /= CONST_VOID then
				    PT := D(SM_EXP_TYPE, PFX);
				end if;
				if PT /= CONST_VOID and then KIND(GET_BASE_STRUCT(PT)) = DN_ACCESS then
				    exit; -- Implicit .all dereference is always an assignable variable
				end if;
				BASE_N := PFX;
			    end;
			when DN_SELECTED =>
			    declare
				PFX: constant TREE := D(AS_NAME, BASE_N);
				DES: constant TREE := D(AS_DESIGNATOR, BASE_N);
				DF: TREE := CONST_VOID;
			    begin
				if DES /= CONST_VOID and then (KIND(DES) in CLASS_USED_NAME or else KIND(DES) in CLASS_USED_OBJECT) then
				    DF := D(SM_DEFN, DES);
				end if;
				if DF /= CONST_VOID and then KIND(DF) = DN_DISCRIMINANT_ID then
				    BAD_LHS := True;
				    exit;
				elsif DF /= CONST_VOID and then KIND(DF) = DN_COMPONENT_ID then
				    if PFX /= CONST_VOID and then D(SM_EXP_TYPE, PFX) /= CONST_VOID
				    and then KIND(GET_BASE_STRUCT(D(SM_EXP_TYPE, PFX))) = DN_ACCESS then
					exit; -- Implicit .all dereference of access-to-record is assignable
				    end if;
				    BASE_N := PFX;
				else
				    BASE_N := DES;
				end if;
			    end;
			when DN_ALL =>
			    -- Dereferenced access value is always assignable
			    exit;
			when DN_USED_OBJECT_ID =>
			    declare
				DF: constant TREE := D(SM_DEFN, BASE_N);
			    begin
				if DF /= CONST_VOID and then (
				    KIND(DF) = DN_CONSTANT_ID
				    or else KIND(DF) = DN_IN_ID
				    or else KIND(DF) = DN_ITERATION_ID
				    or else KIND(DF) = DN_NUMBER_ID
				    or else KIND(DF) = DN_ENUMERATION_ID
				    or else KIND(DF) = DN_CHARACTER_ID)
				then
				    BAD_LHS := True;
				end if;
			    end;
			    exit;
			when DN_FUNCTION_CALL | DN_NULLARY_CALL | DN_CONVERSION | DN_QUALIFIED | DN_ATTRIBUTE | DN_AGGREGATE | DN_NUMERIC_LITERAL | DN_STRING_LITERAL | DN_NULL_ACCESS =>
			    BAD_LHS := True;
			    exit;
			when others =>
			    exit;
			end case;
		    end loop;
		    if BAD_LHS then
			ERROR(D(LX_SRCPOS, NAME), "Target of assignment must be a variable");
		    end if;
		end;
	    end;


	-- for an exit statement
	when DN_EXIT =>
	    declare
		EXP: TREE := D(AS_EXP, STM);
		NAME: TREE := D(AS_NAME, STM);

		TYPESET: TYPESET_TYPE;
		LOOP_ID: TREE;
	    begin
		-- if an expression is given
		if EXP /= CONST_VOID then

		    -- require some boolean type
		    EVAL_EXP_TYPES(EXP, TYPESET);
		    REQUIRE_BOOLEAN_TYPE(EXP, TYPESET);
		    EXP := RESOLVE_EXP(EXP, TYPESET);
		    D(AS_EXP, STM, EXP);
		end if;

		-- if a loop name is given
		if NAME /= CONST_VOID then

		    -- require a block_loop_id for enclosing loop
		    NAME := WALK_NAME(DN_BLOCK_LOOP_ID, NAME);
		    LOOP_ID := GET_NAME_DEFN(NAME);

		    -- LRM 5.7(4): loop name must name an enclosing loop in current frame
		    if LOOP_ID /= CONST_VOID then
			declare
			    FOUND_LOOP: BOOLEAN := FALSE;
			begin
			    for K in LOOP_BARRIER + 1 .. LOOP_SP loop
				if ACTIVE_LOOPS(K) = LOOP_ID then
				    FOUND_LOOP := TRUE;
				    exit;
				end if;
			    end loop;
			    if not FOUND_LOOP then
				ERROR(D(LX_SRCPOS, STM), "Exit target is not an enclosing loop");
			    end if;
			end;
		    end if;

		-- else -- since no loop name is given
		else

		    -- use id of enclosing loop
		    if LOOP_SP > LOOP_BARRIER then
			LOOP_ID := ACTIVE_LOOPS(LOOP_SP);
		    else
			LOOP_ID := CONST_VOID;
		    end if;

		    -- check that there is one
		    if LOOP_ID = CONST_VOID then
			ERROR(D(LX_SRCPOS, STM)
                                    , "Exit statement not in a loop" );
		    end if;
		end if;

		-- if the proper enclosing loop has been found
		if LOOP_ID /= CONST_VOID then

		    -- copy pointer to the loop stm into the exit stm
		    D(SM_STM, STM, D(SM_STM, LOOP_ID));
		end if;
	    end;


	-- for a code statement
	when DN_CODE =>
	    declare
	    begin

		-- error -- not supported
                ERROR(D(LX_SRCPOS, STM), "Code statement not supported");
	    end;


	-- for a case statement
	when DN_CASE =>
	    declare
		EXP: TREE := D(AS_EXP, STM);
		ALTERNATIVE_S: constant TREE := D(AS_ALTERNATIVE_S, STM);

		TYPESET: TYPESET_TYPE;
		REQUIRED_TYPE: TREE;

		ALTERNATIVE_LIST: SEQ_TYPE := LIST(ALTERNATIVE_S);
		ALTERNATIVE: TREE;

	    begin

		-- resolve case expression (a complete context)
		EVAL_EXP_TYPES(EXP, TYPESET);
		REQUIRE_DISCRETE_TYPE(EXP, TYPESET);
		-- $$$$ REQUIRE_NOT_GENERIC_FORMAL_TYPE(EXP, TYPESET);
		-- ???? is this used in overload resolution?
		REQUIRE_UNIQUE_TYPE(EXP, TYPESET);
		REQUIRED_TYPE := GET_THE_TYPE(TYPESET);
		if REQUIRED_TYPE /= CONST_VOID
		and then KIND(REQUIRED_TYPE) in DN_ENUMERATION .. DN_INTEGER
		and then D(SM_RANGE, REQUIRED_TYPE) = CONST_VOID then
		    ERROR(D(LX_SRCPOS, EXP), "Case expression cannot be of generic formal type");
		end if;
		EXP := RESOLVE_EXP(EXP, REQUIRED_TYPE);
		D(AS_EXP, STM, EXP);

		-- for each element of the alternative list
		while not IS_EMPTY(ALTERNATIVE_LIST) loop
		    POP(ALTERNATIVE_LIST, ALTERNATIVE);

		    -- if it is a pragma
		    if KIND(ALTERNATIVE) = DN_ALTERNATIVE_PRAGMA then

			-- walk the pragma
			WALK(D(AS_PRAGMA, ALTERNATIVE), H);

		    -- else -- since it must be an alternative
		    else

			-- walk the list of choices
			WALK_DISCRETE_CHOICE_S
				( D(AS_CHOICE_S, ALTERNATIVE)
				, REQUIRED_TYPE );

			-- walk the sequence of statements for this choice
			WALK_STM_S( D(AS_STM_S, ALTERNATIVE), H);
		    end if;
		end loop;

		-- LRM 5.4: check case choices are static, non-overlapping, others is last/only, and complete
		if REQUIRED_TYPE /= CONST_VOID then
		    declare
			MAX_INTV: constant INTEGER := 512;
			LO_ARR: array (1 .. MAX_INTV) of TREE;
			HI_ARR: array (1 .. MAX_INTV) of TREE;
			N_INTV: INTEGER := 0;
			HAS_OTHERS: BOOLEAN := FALSE;
			NON_STATIC: BOOLEAN := FALSE;
			ALT_L: SEQ_TYPE := LIST(ALTERNATIVE_S);
			ALT: TREE;
			CH_L: SEQ_TYPE;
			CH: TREE;
			CH_COUNT: INTEGER;
			OTHERS_HERE: BOOLEAN;
			IS_LAST_ALT: BOOLEAN;
			C_LO, C_HI: TREE;
		    begin
			while not IS_EMPTY(ALT_L) loop
			    POP(ALT_L, ALT);
			    if KIND(ALT) /= DN_ALTERNATIVE_PRAGMA then
				-- Check if any remaining non-pragma alternatives follow
				declare
				    REM_L: SEQ_TYPE := ALT_L;
				    REM_A: TREE;
				begin
				    IS_LAST_ALT := TRUE;
				    while not IS_EMPTY(REM_L) loop
					POP(REM_L, REM_A);
					if KIND(REM_A) /= DN_ALTERNATIVE_PRAGMA then
					    IS_LAST_ALT := FALSE;
					    exit;
					end if;
				    end loop;
				end;
				CH_L := LIST(D(AS_CHOICE_S, ALT));
				CH_COUNT := 0;
				OTHERS_HERE := FALSE;
				while not IS_EMPTY(CH_L) loop
				    POP(CH_L, CH);
				    CH_COUNT := CH_COUNT + 1;
				    if KIND(CH) = DN_CHOICE_OTHERS then
					OTHERS_HERE := TRUE;
					HAS_OTHERS := TRUE;
					if not IS_LAST_ALT then
					    ERROR(D(LX_SRCPOS, CH), "OTHERS must be last alternative");
					end if;
				    elsif KIND(CH) = DN_CHOICE_EXP then
					C_LO := GET_STATIC_VALUE(D(AS_EXP, CH));
					if C_LO = CONST_VOID then
					    NON_STATIC := TRUE;
					    ERROR(D(LX_SRCPOS, CH), "Case choice must be static");
					else
					    C_HI := C_LO;
					    for K in 1 .. N_INTV loop
						if UARITH."<="(LO_ARR(K), C_HI)
						and then UARITH."<="(C_LO, HI_ARR(K)) then
						    ERROR(D(LX_SRCPOS, CH), "Duplicate case choice");
						    exit;
						end if;
					    end loop;
					    if N_INTV < MAX_INTV then
						N_INTV := N_INTV + 1;
						LO_ARR(N_INTV) := C_LO;
						HI_ARR(N_INTV) := C_HI;
					    end if;
					end if;
				    elsif KIND(CH) = DN_CHOICE_RANGE then
					declare
					    DR: constant TREE := D(AS_DISCRETE_RANGE, CH);
					    R_NODE: TREE := CONST_VOID;
					begin
					    if KIND(DR) = DN_RANGE then
						R_NODE := DR;
					    elsif KIND(DR) = DN_DISCRETE_SUBTYPE then
						declare
						    SI_N: constant TREE := D(AS_SUBTYPE_INDICATION, DR);
						    C_N: TREE := CONST_VOID;
						    NM: TREE := CONST_VOID;
						begin
						    if SI_N /= CONST_VOID and then KIND(SI_N) = DN_SUBTYPE_INDICATION then
							C_N := D(AS_CONSTRAINT, SI_N);
							if C_N /= CONST_VOID and then KIND(C_N) = DN_RANGE then
							    R_NODE := C_N;
							else
							    NM := D(AS_NAME, SI_N);
							    if NM /= CONST_VOID and then KIND(NM) = DN_SELECTED then
								NM := D(AS_DESIGNATOR, NM);
							    end if;
							    if NM /= CONST_VOID and then KIND(NM) = DN_USED_NAME_ID
							    and then D(SM_DEFN, NM) /= CONST_VOID
							    and then KIND(D(SM_DEFN, NM)) in CLASS_TYPE_NAME then
								declare
								    TS_N: constant TREE := D(SM_TYPE_SPEC, D(SM_DEFN, NM));
								begin
								    if TS_N /= CONST_VOID and then KIND(TS_N) in DN_ENUMERATION .. DN_INTEGER then
									R_NODE := D(SM_RANGE, TS_N);
								    end if;
								end;
							    end if;
							end if;
						    end if;
						end;
					    end if;
					    if R_NODE /= CONST_VOID and then KIND(R_NODE) = DN_RANGE then
						C_LO := GET_STATIC_VALUE(D(AS_EXP1, R_NODE));
						C_HI := GET_STATIC_VALUE(D(AS_EXP2, R_NODE));
						if C_LO = CONST_VOID or else C_HI = CONST_VOID then
						    NON_STATIC := TRUE;
						    ERROR(D(LX_SRCPOS, CH), "Case range must be static");
						elsif UARITH."<="(C_LO, C_HI) then
						    for K in 1 .. N_INTV loop
							if UARITH."<="(LO_ARR(K), C_HI)
							and then UARITH."<="(C_LO, HI_ARR(K)) then
							    ERROR(D(LX_SRCPOS, CH), "Overlapping case choice");
							    exit;
							end if;
						    end loop;
						    if N_INTV < MAX_INTV then
							N_INTV := N_INTV + 1;
							LO_ARR(N_INTV) := C_LO;
							HI_ARR(N_INTV) := C_HI;
						    end if;
						end if;
					    else
						NON_STATIC := TRUE;
					    end if;
					end;
				    end if;
				end loop;
				if OTHERS_HERE and then CH_COUNT > 1 then
				    ERROR(D(LX_SRCPOS, ALT), "OTHERS must appear alone");
				end if;
			    end if;
			end loop;

			-- LRM 5.4(5): determine applicable subtype and check range & completeness
			declare
			    EXP_T: constant TREE := D(SM_EXP_TYPE, EXP);
			    APP_T: TREE := CONST_VOID;
			    IS_UNIV: BOOLEAN := FALSE;
			    IS_STAT_SUB: BOOLEAN := FALSE;
			    RNG: TREE := CONST_VOID;
			    S_LO, S_HI: TREE := CONST_VOID;
			    TMP: TREE;
			    CUR_MAX: TREE;
			    COVERED: BOOLEAN := FALSE;
			begin
			    if KIND(EXP) = DN_NUMERIC_LITERAL
			    or else (EXP_T /= CONST_VOID and then KIND(EXP_T) = DN_UNIVERSAL_INTEGER) then
				IS_UNIV := TRUE;
			    end if;

			    -- LRM 5.4(5): applicable subtype is object/qualified/conversion subtype
			    -- if static, otherwise base type.
			    if not IS_UNIV then
				if KIND(EXP) = DN_USED_OBJECT_ID
				or else KIND(EXP) = DN_SELECTED
				or else KIND(EXP) = DN_INDEXED
				or else KIND(EXP) = DN_QUALIFIED
				or else KIND(EXP) = DN_CONVERSION then
				    APP_T := EXP_T;
				else
				    APP_T := REQUIRED_TYPE;
				end if;
				if APP_T /= CONST_VOID and then CHKSTAT.IS_STATIC_SUBTYPE(APP_T) then
				    IS_STAT_SUB := TRUE;
				    if KIND(APP_T) in DN_ENUMERATION .. DN_INTEGER then
					RNG := D(SM_RANGE, APP_T);
				    end if;
				else
				    APP_T := REQUIRED_TYPE;
				    if APP_T /= CONST_VOID and then KIND(APP_T) in DN_ENUMERATION .. DN_INTEGER then
					RNG := D(SM_RANGE, APP_T);
				    end if;
				end if;
				if RNG /= CONST_VOID and then KIND(RNG) = DN_RANGE then
				    S_LO := GET_STATIC_VALUE(D(AS_EXP1, RNG));
				    S_HI := GET_STATIC_VALUE(D(AS_EXP2, RNG));
				end if;
			    end if;

			    -- LRM 5.4(4): if expression has a static subtype, every non-null choice must lie in [S_LO, S_HI]
			    if IS_STAT_SUB and then S_LO /= CONST_VOID and then S_HI /= CONST_VOID then
				for K in 1 .. N_INTV loop
				    if UARITH."<="(LO_ARR(K), HI_ARR(K)) then
					if not UARITH."<="(S_LO, LO_ARR(K))
					or else not UARITH."<="(HI_ARR(K), S_HI) then
					    ERROR(D(LX_SRCPOS, STM), "Case choice outside static subtype range");
					    exit;
					end if;
				    end if;
				end loop;
			    end if;

			    -- Check completeness if no OTHERS and all choices were static
			    if not HAS_OTHERS and then not NON_STATIC and then N_INTV < MAX_INTV then
				if IS_UNIV then
				    ERROR(D(LX_SRCPOS, STM), "OTHERS required for universal integer case expression");
				elsif RNG = CONST_VOID or else KIND(RNG) /= DN_RANGE then
				    null;
				elsif S_LO = CONST_VOID or else S_HI = CONST_VOID then
				    ERROR(D(LX_SRCPOS, STM), "OTHERS required for non-static case subtype");
				elsif not UARITH."<="(S_LO, S_HI) then
				    -- Null subtype range: vacuously covered
				    null;
				elsif N_INTV = 0 then
				    ERROR(D(LX_SRCPOS, STM), "Missing case choices");
				else
				    -- Sort intervals by LO_ARR (insertion sort)
				    for I in 2 .. N_INTV loop
					for J in reverse 2 .. I loop
					    if UARITH.U_POS(UARITH."<"(LO_ARR(J), LO_ARR(J - 1))) /= 0 then
						TMP := LO_ARR(J); LO_ARR(J) := LO_ARR(J - 1); LO_ARR(J - 1) := TMP;
						TMP := HI_ARR(J); HI_ARR(J) := HI_ARR(J - 1); HI_ARR(J - 1) := TMP;
					    end if;
					end loop;
				    end loop;
				    -- Merge intervals to check coverage of [S_LO, S_HI]
				    if UARITH."<="(LO_ARR(1), S_LO) then
					CUR_MAX := HI_ARR(1);
					for I in 2 .. N_INTV loop
					    if UARITH."<="(LO_ARR(I), UARITH."+"(CUR_MAX, UARITH.U_VAL(1))) then
						if UARITH.U_POS(UARITH."<"(CUR_MAX, HI_ARR(I))) /= 0 then
						    CUR_MAX := HI_ARR(I);
						end if;
					    else
						exit;
					    end if;
					end loop;
					if UARITH."<="(S_HI, CUR_MAX) then
					    COVERED := TRUE;
					end if;
				    end if;
				    if not COVERED then
					ERROR(D(LX_SRCPOS, STM), "Case choices do not cover all values");
				    end if;
				end if;
			    end if;
			end;
		    end;
		end if;
	    end;


	-- for a goto statement
	when DN_GOTO =>
	    declare
		NAME: TREE := D(AS_NAME, STM);
		LBL_ID: TREE;
		OWN_S: TREE := CONST_VOID;
		FOUND_S: BOOLEAN := FALSE;
	    begin

		-- evaluate the label name
		NAME := WALK_NAME(DN_LABEL_ID, NAME);
		D(AS_NAME, STM, NAME);

		-- LRM 5.9: target label must be in an enclosing statement sequence of same frame
		LBL_ID := GET_NAME_DEFN(NAME);
		if LBL_ID /= CONST_VOID and then KIND(LBL_ID) = DN_LABEL_ID then
		    for K in reverse 1 .. LBL_CNT loop
			if LBL_IDS(K) = LBL_ID then
			    OWN_S := LBL_STM_S(K);
			    exit;
			end if;
		    end loop;
		    if OWN_S /= CONST_VOID then
			for K in STM_BARRIER + 1 .. STM_SP loop
			    if ACTIVE_STM_S(K) = OWN_S then
				FOUND_S := TRUE;
				exit;
			    end if;
			end loop;
			if not FOUND_S then
			    ERROR(D(LX_SRCPOS, STM), "Illegal goto target");
			end if;
		    end if;
		end if;
	    end;


	-- for a raise statement
	when DN_RAISE =>
	    declare
		NAME: TREE := D(AS_NAME, STM);
	    begin

		-- if an exception name is given
		if NAME /= CONST_VOID then

		    -- evaluate the exception name
		    NAME := WALK_NAME(DN_EXCEPTION_ID, NAME);
		    D(AS_NAME, STM, NAME);
		elsif not IN_HANDLER then
		    ERROR(D(LX_SRCPOS, STM), "Raise without exception name only allowed in handler");
		end if;
	    end;


	-- for an entry call or a procedure call
	when DN_PROCEDURE_CALL | DN_ENTRY_CALL =>
	    declare
		NAME: TREE := D(AS_NAME, STM);
		GENERAL_ASSOC_S: constant TREE := D(AS_GENERAL_ASSOC_S, STM);

		INDEX_LIST: SEQ_TYPE;
		INDEX: TREE := CONST_VOID;
		INDEX_TYPESET: TYPESET_TYPE;
		DISCRETE_RANGE: TREE;

		NAME_DEFSET: DEFSET_TYPE;
		NAME_ID: TREE;
	    begin
		-- if call is of the form ...(...)(...)
		if KIND(NAME) = DN_FUNCTION_CALL then

		    -- syntax only allows call of member of entry family
		    -- separate the index from the name
		    INDEX_LIST := LIST(D(AS_GENERAL_ASSOC_S, NAME));
		    POP(INDEX_LIST, INDEX);
		    NAME := D(AS_NAME, NAME);

		    -- if the index has named notation
		    if KIND(INDEX) = DN_ASSOC then

			-- report error
                        ERROR(D(LX_SRCPOS,INDEX), "Named notation for index");

			-- evaluate expression types anyway
			INDEX := D(AS_EXP, INDEX);
			EVAL_EXP_TYPES(INDEX, INDEX_TYPESET);

			-- and throw away all interpretations of the index
			INDEX_TYPESET := EMPTY_TYPESET;

		    -- else -- since index does not have named notation
		    else

			-- evaluate expression types
			EVAL_EXP_TYPES(INDEX, INDEX_TYPESET);
		    end if;

		    -- if there is more than one index expression
		    if not IS_EMPTY(INDEX_LIST) then

			-- report error
                        ERROR(D(LX_SRCPOS,INDEX), "More than one entry index");

			-- and throw away all interpretations of the index
			INDEX_TYPESET := EMPTY_TYPESET;
		    end if;

		    -- save index interpretations
		    STASH_TYPESET(INDEX, INDEX_TYPESET);
		end if;

		-- get visible procedure or entry names
		FIND_VISIBILITY(NAME, NAME_DEFSET);
		if KIND(STM) = DN_ENTRY_CALL
		or INDEX /= CONST_VOID then
		    REQUIRE_ENTRY_DEF(NAME, NAME_DEFSET);
		else
		    REQUIRE_PROC_OR_ENTRY_DEF(NAME, NAME_DEFSET);
		end if;

		-- check parameters of visible names
		REDUCE_APPLY_NAMES(NAME, NAME_DEFSET, GENERAL_ASSOC_S, INDEX);

		-- require unique name
		REQUIRE_UNIQUE_DEF(NAME, NAME_DEFSET);
		NAME_ID := GET_THE_ID(NAME_DEFSET);

		-- if it is an entry name
		if KIND(NAME_ID) = DN_ENTRY_ID then

		    -- force statement to be an entry call
		    if KIND(STM) /= DN_ENTRY_CALL then
			STM := MAKE_ENTRY_CALL
				( LX_SRCPOS => D(LX_SRCPOS, STM)
				, AS_NAME => NAME
				, AS_GENERAL_ASSOC_S => GENERAL_ASSOC_S );
		    end if;

		    -- if it is the name of an entry family
		    DISCRETE_RANGE := D(AS_DISCRETE_RANGE, D(SM_SPEC, NAME_ID));
		    if DISCRETE_RANGE /= CONST_VOID then

			-- if there was not an explicit parameter list
			if INDEX = CONST_VOID then

			    -- the (only) parameter is the index
			    INDEX := HEAD(LIST(GENERAL_ASSOC_S));
			    LIST(GENERAL_ASSOC_S, MAKE);
			end if;

			-- resolve the index
			INDEX  := RESOLVE_EXP
				    ( INDEX
				    , GET_BASE_TYPE(DISCRETE_RANGE) );
		    end if;
		end if;

		-- resolve the name
		if KIND(NAME_ID) = DN_ENTRY_ID
		and then KIND(NAME) = DN_SELECTED
		and then KIND(D(XD_REGION, NAME_ID)) = DN_TYPE_ID
                and then DI(XD_LEX_LEVEL, GET_DEF_FOR_ID(NAME_ID)) > 0 then
		    -- do not use Resolve_Name because prefix might be a
		    -- function call, indicating a member of an array of tasks
		    declare
			PREFIX: TREE := D(AS_NAME, NAME);
			DESIGNATOR: TREE := D(AS_DESIGNATOR, NAME);
			TASK_SPEC: TREE :=
				D(SM_TYPE_SPEC, D(XD_REGION, NAME_ID));
			TYPESET: TYPESET_TYPE := FETCH_TYPESET(PREFIX);
			TYPEINTERP: TYPEINTERP_TYPE;
			PREFIX_STRUCT: TREE;
			NEW_TYPESET: TYPESET_TYPE := EMPTY_TYPESET;
		    begin
			while not IS_EMPTY(TYPESET) loop
			    POP(TYPESET, TYPEINTERP);
			    PREFIX_STRUCT := GET_BASE_STRUCT
				    ( GET_TYPE(TYPEINTERP) );
			    if PREFIX_STRUCT = TASK_SPEC
			    or else (KIND(PREFIX_STRUCT) = DN_ACCESS
				    and then GET_BASE_STRUCT
					    ( D(SM_DESIG_TYPE, PREFIX_STRUCT) )
					= TASK_SPEC)
			    then
				ADD_TO_TYPESET(NEW_TYPESET, TYPEINTERP);
			    end if;
			end loop;
			REQUIRE_UNIQUE_TYPE(PREFIX, NEW_TYPESET);
			PREFIX :=  RESOLVE_EXP (PREFIX, NEW_TYPESET);
			D(AS_NAME, NAME, PREFIX);
			DESIGNATOR := RESOLVE_NAME(DESIGNATOR, NAME_ID);
			D(AS_DESIGNATOR, NAME, DESIGNATOR);
			D(SM_EXP_TYPE, NAME, CONST_VOID);
		    end;
		else
		    NAME := RESOLVE_NAME(NAME, NAME_ID);
		end if;

		if INDEX /= CONST_VOID then
		    NAME := MAKE_INDEXED
				( AS_NAME => NAME
				, AS_EXP_S => MAKE_EXP_S
						( LIST => SINGLETON(INDEX)
						, LX_SRCPOS
							=> D(LX_SRCPOS,INDEX) )
				, SM_EXP_TYPE => CONST_VOID
				, LX_SRCPOS => D(LX_SRCPOS,NAME) );
		end if;
		D(AS_NAME, STM, NAME);

		-- resolve parameters and store normalized list
		if IS_EMPTY(NAME_DEFSET) then
		    RESOLVE_ERRONEOUS_PARAM_S(GENERAL_ASSOC_S);
		else
		    D(SM_NORMALIZED_PARAM_S
			    , STM
			    , RESOLVE_SUBP_PARAMETERS
				    ( GET_DEF(HEAD(NAME_DEFSET))
				    , GENERAL_ASSOC_S) );
		end if;
	    end;


	-- for an accept statement
	when DN_ACCEPT =>
	    declare
		NAME: constant TREE := D(AS_NAME, STM);
		PARAM_S: TREE := D(AS_PARAM_S, STM);
		STM_S: constant TREE := D(AS_STM_S, STM);

		DESIGNATOR: TREE := NAME;
		INDEX: TREE := CONST_VOID;
		INDEX_TYPESET: TYPESET_TYPE;
		TEMP_ENTRY_DEF: TREE;
		UNIT_DEF: TREE := H.REGION_DEF;

		PRIOR_ENTRY_DEF: TREE;

		H: H_TYPE := WALK_STM.H;
		S: S_TYPE;
	    begin
		-- $$$$ make sure there is a param_s (should change diana.idl)
		if PARAM_S = CONST_VOID then
		    PARAM_S := MAKE_PARAM_S(LIST => MAKE);
		    D(AS_PARAM_S, STM, PARAM_S);
		end if;

		if KIND(NAME) = DN_INDEXED then
		    INDEX := HEAD(LIST(D(AS_EXP_S,NAME)));
		    D(SM_EXP_TYPE, NAME, CONST_VOID);
		    DESIGNATOR := D(AS_NAME, NAME);
		    EVAL_EXP_TYPES(INDEX, INDEX_TYPESET);
		end if;

		while KIND(D(XD_SOURCE_NAME,UNIT_DEF)) = DN_BLOCK_LOOP_ID
		or else (KIND(D(XD_SOURCE_NAME,UNIT_DEF))) = DN_ENTRY_ID loop
		    UNIT_DEF := D(XD_REGION_DEF, UNIT_DEF);
		end loop;

		-- LRM 9.5(8): ACCEPT statement only allowed inside a task body
		declare
		    U_SN: constant TREE := D(XD_SOURCE_NAME, UNIT_DEF);
		    IN_TASK: BOOLEAN := FALSE;
		begin
		    if KIND(U_SN) = DN_TASK_BODY_ID then
			IN_TASK := TRUE;
		    elsif KIND(U_SN) in CLASS_TYPE_NAME
		    and then D(SM_TYPE_SPEC, U_SN) /= CONST_VOID
		    and then KIND(GET_BASE_TYPE(U_SN)) = DN_TASK_SPEC then
			IN_TASK := TRUE;
		    elsif KIND(U_SN) = DN_VARIABLE_ID
		    and then D(SM_OBJ_TYPE, U_SN) /= CONST_VOID
		    and then KIND(GET_BASE_STRUCT(D(SM_OBJ_TYPE, U_SN))) = DN_TASK_SPEC then
			IN_TASK := TRUE;
		    end if;
		    if not IN_TASK then
			ERROR(D(LX_SRCPOS, STM), "Accept statement must be inside task body");
		    end if;
		end;

		H.REGION_DEF := UNIT_DEF;
		TEMP_ENTRY_DEF := MAKE_DEF_FOR_ID
			( MAKE_ENTRY_ID(LX_SYMREP => D(LX_SYMREP, DESIGNATOR))
			, H );
		ENTER_REGION(TEMP_ENTRY_DEF, H, S);
		declare
		    PREV_FORB: constant TREE := FORBIDDEN_SELECTOR_SYMREP;
		begin
		    FORBIDDEN_SELECTOR_SYMREP := D(LX_SYMREP, DESIGNATOR);
		    FINISH_PARAM_S(PARAM_S, H);
		    FORBIDDEN_SELECTOR_SYMREP := PREV_FORB;
		end;
		if INDEX = CONST_VOID then
		    PRIOR_ENTRY_DEF := GET_PRIOR_HOMOGRAPH_DEF
				( TEMP_ENTRY_DEF
				, PARAM_S );
		else
		    PRIOR_ENTRY_DEF := GET_PRIOR_DEF(TEMP_ENTRY_DEF);
		    if PRIOR_ENTRY_DEF /= CONST_VOID
		    and then KIND(D(XD_SOURCE_NAME,PRIOR_ENTRY_DEF))
				= DN_ENTRY_ID
		    then
			declare
			    SOURCE_NAME: TREE
				    := D(XD_SOURCE_NAME, PRIOR_ENTRY_DEF);
			    DISCRETE_RANGE: TREE
				    := D(AS_DISCRETE_RANGE
					    , D(SM_SPEC, SOURCE_NAME) );
			begin
			    if DISCRETE_RANGE /= CONST_VOID then
				REQUIRE_TYPE(GET_BASE_TYPE(DISCRETE_RANGE)
					, INDEX, INDEX_TYPESET );
				INDEX := RESOLVE_EXP(INDEX, INDEX_TYPESET);
			    else
				ERROR(D(LX_SRCPOS,INDEX),
                                        "Entry must be an entry family");
				INDEX := RESOLVE_EXP(INDEX, CONST_VOID);
			    end if;
			end;
			LIST(D(AS_EXP_S, NAME), SINGLETON(INDEX));
		    else
			PRIOR_ENTRY_DEF := CONST_VOID;
		    end if;
		end if;
		if PRIOR_ENTRY_DEF = CONST_VOID
		or else KIND(D(XD_SOURCE_NAME,PRIOR_ENTRY_DEF)) /= DN_ENTRY_ID
		then
                    ERROR(D(LX_SRCPOS, DESIGNATOR), "No entry for accept");
		    MAKE_DEF_IN_ERROR(TEMP_ENTRY_DEF);
		    PRIOR_ENTRY_DEF := TEMP_ENTRY_DEF;
		elsif D(SM_SPEC,(D(XD_SOURCE_NAME,PRIOR_ENTRY_DEF)))
				= CONST_VOID
		then
		    WARNING(D(LX_SRCPOS,STM),
                                "$$$$ sm-spec is void - "
				& NODE_REP(D(XD_SOURCE_NAME,PRIOR_ENTRY_DEF)) );
		    REMOVE_DEF_FROM_ENVIRONMENT(TEMP_ENTRY_DEF);
		else
		    D(SM_DEFN, DESIGNATOR, D(XD_SOURCE_NAME, PRIOR_ENTRY_DEF));
		    -- LRM 9.5(8): cannot nest ACCEPT for the same entry
		    declare
			CHK_DEF: TREE := WALK_STM.H.REGION_DEF;
		    begin
			while CHK_DEF /= CONST_VOID
			and then (KIND(D(XD_SOURCE_NAME, CHK_DEF)) = DN_BLOCK_LOOP_ID
				  or else KIND(D(XD_SOURCE_NAME, CHK_DEF)) = DN_ENTRY_ID)
			loop
			    if CHK_DEF = PRIOR_ENTRY_DEF then
				ERROR(D(LX_SRCPOS, STM), "Nested accept for same entry not allowed");
				exit;
			    end if;
			    CHK_DEF := D(XD_REGION_DEF, CHK_DEF);
			end loop;
		    end;
		    CONFORM_PARAMETER_LISTS
			    ( D(AS_PARAM_S
				, D(SM_SPEC, D(XD_SOURCE_NAME,PRIOR_ENTRY_DEF)))
			    , PARAM_S );
		    REMOVE_DEF_FROM_ENVIRONMENT(TEMP_ENTRY_DEF);
		end if;
		LEAVE_REGION(TEMP_ENTRY_DEF, S);
		H := WALK_STM.H;

		ENTER_BODY(PRIOR_ENTRY_DEF, H, S);
		declare
		    PREV_CAN_RET: constant BOOLEAN := CAN_RETURN;
		    PREV_IN_HND:  constant BOOLEAN := IN_HANDLER;
		    PREV_STM_B:   constant NATURAL := STM_BARRIER;
		    PREV_LOOP_B:  constant NATURAL := LOOP_BARRIER;
		begin
		    CAN_RETURN := TRUE;
		    IN_HANDLER := FALSE;
		    STM_BARRIER := STM_SP;
		    LOOP_BARRIER := LOOP_SP;
		    WALK_STM_S(STM_S, H);
		    CAN_RETURN := PREV_CAN_RET;
		    IN_HANDLER := PREV_IN_HND;
		    STM_BARRIER := PREV_STM_B;
		    LOOP_BARRIER := PREV_LOOP_B;
		end;
		LEAVE_BODY(PRIOR_ENTRY_DEF, S);
	    end;


	-- for a loop statement
	when DN_LOOP =>
	    declare
		SOURCE_NAME: constant TREE := D(AS_SOURCE_NAME, STM);
		ITERATION: constant TREE := D(AS_ITERATION, STM);
		STM_S: constant TREE := D(AS_STM_S, STM);

		SOURCE_DEF: TREE := GET_DEF_FOR_ID(SOURCE_NAME);

		H: H_TYPE := WALK_STM.H;
		S: S_TYPE;
	    begin

		-- $$$$ check that label is not duplicate in unit

		ENTER_BODY(SOURCE_DEF, H, S);
		H.RETURN_TYPE := WALK_STM.H.RETURN_TYPE;
		if KIND(ITERATION) in CLASS_FOR_REV then
		    declare
			ITERATION_ID: TREE := D(AS_SOURCE_NAME, ITERATION);
			DISCRETE_RANGE: TREE := D(AS_DISCRETE_RANGE, ITERATION);

			ITERATION_ID_DEF: TREE
				    := MAKE_DEF_FOR_ID(ITERATION_ID, H);
			RANGE_TYPESET: TYPESET_TYPE;
		    begin
			EVAL_NON_UNIVERSAL_DISCRETE_RANGE
					( DISCRETE_RANGE
					, RANGE_TYPESET );
			DISCRETE_RANGE := RESOLVE_DISCRETE_RANGE
					( DISCRETE_RANGE
					, GET_THE_TYPE(RANGE_TYPESET) );
			D(AS_DISCRETE_RANGE, ITERATION, DISCRETE_RANGE);

			if not IS_EMPTY(RANGE_TYPESET) then
			    MAKE_DEF_VISIBLE(ITERATION_ID_DEF);
			    D(SM_OBJ_TYPE, ITERATION_ID
					, GET_SUBTYPE_OF_DISCRETE_RANGE
						( DISCRETE_RANGE ) );
			else
			    MAKE_DEF_IN_ERROR(ITERATION_ID_DEF);
			end if;
		    end;

		elsif KIND(ITERATION) = DN_WHILE then
		    declare
			EXP: TREE := D(AS_EXP, ITERATION);
			EXP_TYPESET: TYPESET_TYPE;
		    begin
			EVAL_EXP_TYPES(EXP, EXP_TYPESET);
			REQUIRE_BOOLEAN_TYPE(EXP, EXP_TYPESET);
			REQUIRE_UNIQUE_TYPE(EXP, EXP_TYPESET);
			EXP := RESOLVE_EXP(EXP, GET_THE_TYPE(EXP_TYPESET));
			D(AS_EXP, ITERATION, EXP);
		    end;
		end if;

		-- make this the enclosing loop statement
		H.ENCLOSING_LOOP_ID := SOURCE_NAME;
		if KIND(ITERATION) in CLASS_FOR_REV then
		    -- LRM 8.3(17): loop parameter cannot have same name as label declared inside the loop
		    declare
			IT_SYM: constant TREE := D(LX_SYMREP, D(AS_SOURCE_NAME, ITERATION));
			procedure CHECK_LBL_CLASH(S_NODE: TREE) is
			    SL: SEQ_TYPE;
			    ST: TREE;
			    L_L: SEQ_TYPE;
			    L_ID: TREE;
			begin
			    if S_NODE = CONST_VOID then return; end if;
			    SL := LIST(S_NODE);
			    while not IS_EMPTY(SL) loop
				POP(SL, ST);
				if KIND(ST) = DN_LABELED then
				    L_L := LIST(D(AS_SOURCE_NAME_S, ST));
				    while not IS_EMPTY(L_L) loop
					POP(L_L, L_ID);
					if D(LX_SYMREP, L_ID) = IT_SYM then
					    ERROR(D(LX_SRCPOS, L_ID), "Label clashes with enclosing loop parameter");
					end if;
				    end loop;
				    ST := D(AS_STM, ST);
				end if;
				case KIND(ST) is
				when DN_LOOP =>
				    CHECK_LBL_CLASH(D(AS_STM_S, ST));
				when DN_IF | DN_SELECTIVE_WAIT =>
				    declare
					TL: SEQ_TYPE := LIST(D(AS_TEST_CLAUSE_ELEM_S, ST));
					TC: TREE;
				    begin
					while not IS_EMPTY(TL) loop
					    POP(TL, TC);
					    if KIND(TC) in CLASS_TEST_CLAUSE then
						CHECK_LBL_CLASH(D(AS_STM_S, TC));
					    end if;
					end loop;
				    end;
				    CHECK_LBL_CLASH(D(AS_STM_S, ST));
				when DN_CASE =>
				    declare
					AL: SEQ_TYPE := LIST(D(AS_ALTERNATIVE_S, ST));
					A_IT: TREE;
				    begin
					while not IS_EMPTY(AL) loop
					    POP(AL, A_IT);
					    if KIND(A_IT) = DN_ALTERNATIVE then
						CHECK_LBL_CLASH(D(AS_STM_S, A_IT));
					    end if;
					end loop;
				    end;
				when others =>
				    null;
				end case;
			    end loop;
			end CHECK_LBL_CLASH;
		    begin
			CHECK_LBL_CLASH(STM_S);
		    end;
		end if;
		if LOOP_SP < MAX_ACTIVE_LOOPS then
		    LOOP_SP := LOOP_SP + 1;
		    ACTIVE_LOOPS(LOOP_SP) := SOURCE_NAME;
		end if;

		-- walk the sequence of statements
		WALK_STM_S(STM_S, H);
		if LOOP_SP > 0 then
		    LOOP_SP := LOOP_SP - 1;
		end if;

		-- leave the declarative region
		LEAVE_BODY(SOURCE_DEF, S);
	    end;


	-- for a block statement
	when DN_BLOCK =>
	    declare
		SOURCE_NAME: constant TREE := D(AS_SOURCE_NAME, STM);
		BLOCK_BODY: constant TREE := D(AS_BLOCK_BODY, STM);

		ITEM_S: TREE := D(AS_ITEM_S, BLOCK_BODY);
		STM_S: TREE := D(AS_STM_S, BLOCK_BODY);
		ALTERNATIVE_S: TREE := D(AS_ALTERNATIVE_S, BLOCK_BODY);
		ALTERNATIVE_LIST: SEQ_TYPE;
		ALTERNATIVE: TREE;

		SOURCE_DEF: TREE := GET_DEF_FOR_ID(SOURCE_NAME);
		H: H_TYPE := WALK_STM.H;
		S: S_TYPE;
	    begin
		-- $$$$ check that label is not duplicate in unit

		ENTER_BODY(SOURCE_DEF, H, S);
		H.RETURN_TYPE := WALK_STM.H.RETURN_TYPE;
		WALK_ITEM_S(ITEM_S, H);
		CHECK_COMPLETIONS(ITEM_S);
		if STM_S /= CONST_VOID then
		    DECLARE_LABEL_BLOCK_LOOP_IDS(STM_S, H);
		end if;
		if ALTERNATIVE_S = CONST_VOID then
		    ALTERNATIVE_LIST := MAKE;
		else
		    ALTERNATIVE_LIST := LIST(ALTERNATIVE_S);
		end if;
		while not IS_EMPTY(ALTERNATIVE_LIST) loop
		    POP(ALTERNATIVE_LIST, ALTERNATIVE);
		    if KIND(ALTERNATIVE) = DN_ALTERNATIVE then
			DECLARE_LABEL_BLOCK_LOOP_IDS
				( D(AS_STM_S, ALTERNATIVE), H);
		    end if;
		end loop;
		if STM_S /= CONST_VOID then
		    WALK_STM_S(STM_S, H);
		end if;
		WALK_ALTERNATIVE_S(ALTERNATIVE_S, H);
		LEAVE_BODY(SOURCE_DEF, S);
	    end;


	-- for a conditional entry call or a timed entry call
	when DN_COND_ENTRY | DN_TIMED_ENTRY =>
	    declare
		STM_S1: constant TREE := D(AS_STM_S1, STM);
		STM_S2: constant TREE := D(AS_STM_S2, STM);
	    begin
		-- walk the two sequences of statements
		WALK_STM_S(STM_S1, H);
		WALK_STM_S(STM_S2, H);
	    end;


	-- for an if statement
	when DN_IF =>
	    declare
		TEST_CLAUSE_ELEM_S: constant TREE
			     := D(AS_TEST_CLAUSE_ELEM_S, STM);
		STM_S: constant TREE := D(AS_STM_S, STM);

		COND_CLAUSE_LIST: SEQ_TYPE := LIST(TEST_CLAUSE_ELEM_S);
		COND_CLAUSE: TREE;
		EXP: TREE;
		TYPESET: TYPESET_TYPE;
	    begin
		-- for each cond_clause
		while not IS_EMPTY(COND_CLAUSE_LIST) loop
		    POP(COND_CLAUSE_LIST, COND_CLAUSE);

		    -- resolve the conditional expression
		    EXP := D(AS_EXP, COND_CLAUSE);
		    EVAL_EXP_TYPES(EXP, TYPESET);
		    REQUIRE_BOOLEAN_TYPE(EXP, TYPESET);
		    REQUIRE_UNIQUE_TYPE(EXP, TYPESET);
		    EXP := RESOLVE_EXP(EXP, GET_THE_TYPE(TYPESET));
		    D(AS_EXP, COND_CLAUSE, EXP);

		    -- walk the sequence of statements
		    WALK_STM_S(D(AS_STM_S,COND_CLAUSE), H);

		-- walk the (else) sequence of statements
		end loop;
		WALK_STM_S(STM_S, H);
	    end;


	-- for a selective wait
	when DN_SELECTIVE_WAIT =>
	    declare
		TEST_CLAUSE_ELEM_S: constant TREE
			:= D(AS_TEST_CLAUSE_ELEM_S, STM);
		STM_S: TREE := D(AS_STM_S, STM);

		TEST_CLAUSE_LIST: SEQ_TYPE := LIST(TEST_CLAUSE_ELEM_S);
		TEST_CLAUSE: TREE;
		NEW_TEST_CLAUSE_LIST: SEQ_TYPE := MAKE;
		EXP: TREE;
		TYPESET: TYPESET_TYPE;
		SELECT_ALT_PRAGMA : TREE;
	    begin
		-- for each test_clause
		while not IS_EMPTY(TEST_CLAUSE_LIST) loop
		    POP(TEST_CLAUSE_LIST, TEST_CLAUSE);

		    -- if it is a select alternative
		    if KIND(TEST_CLAUSE) = DN_SELECT_ALTERNATIVE then

			-- if there is a when clause
			EXP := D(AS_EXP, TEST_CLAUSE);
			if EXP /= CONST_VOID then

			    -- resolve the conditional expression
			    EVAL_EXP_TYPES(EXP, TYPESET);
			    REQUIRE_BOOLEAN_TYPE(EXP, TYPESET);
			    REQUIRE_UNIQUE_TYPE(EXP, TYPESET);
			    EXP := RESOLVE_EXP(EXP, GET_THE_TYPE(TYPESET));
			    D(AS_EXP, TEST_CLAUSE, EXP);
			end if;

			-- walk the sequence of statements
			WALK_STM_S(D(AS_STM_S,TEST_CLAUSE), H);

			-- add select_alternative to new list
			NEW_TEST_CLAUSE_LIST := APPEND
					( NEW_TEST_CLAUSE_LIST
					, TEST_CLAUSE );

		    -- else -- since it is a stm pragma
		    else

			-- Note: parser generates stm_pragma instead
			-- ... of select_alt pragma to avoid LR(1) conflict

			-- change the stm_pragma to a select_alt_pragma
			SELECT_ALT_PRAGMA := MAKE_SELECT_ALT_PRAGMA
				    ( LX_SRCPOS => D(LX_SRCPOS, TEST_CLAUSE)
				    , AS_PRAGMA => D(AS_PRAGMA, TEST_CLAUSE) );

			-- process the pragma
			WALK(D(AS_PRAGMA, SELECT_ALT_PRAGMA), H);

			-- add select_alt_pragma to new list
			NEW_TEST_CLAUSE_LIST := APPEND
					( NEW_TEST_CLAUSE_LIST
					, SELECT_ALT_PRAGMA );
		    end if;

		-- replace test_clause_list with new list
		end loop;
		LIST(TEST_CLAUSE_ELEM_S, NEW_TEST_CLAUSE_LIST);

		-- walk the (else) sequence of statements
		WALK_STM_S(STM_S, H);

		-- LRM 9.7.1 static legality checks on selective wait alternatives
		declare
		    CL: SEQ_TYPE := LIST(TEST_CLAUSE_ELEM_S);
		    TC: TREE;
		    N_ACCEPT: NATURAL := 0;
		    N_DELAY: NATURAL := 0;
		    N_TERM: NATURAL := 0;
		    HAS_ELSE: constant Boolean := (STM_S /= CONST_VOID and then not IS_EMPTY(LIST(STM_S)));
		begin
		    while not IS_EMPTY(CL) loop
			POP(CL, TC);
			if KIND(TC) = DN_SELECT_ALTERNATIVE then
			    declare
				SL: SEQ_TYPE := LIST(D(AS_STM_S, TC));
				S1: TREE := CONST_VOID;
				HAS_MORE: Boolean := False;
			    begin
				while not IS_EMPTY(SL) loop
				    POP(SL, S1);
				    exit when KIND(S1) /= DN_STM_PRAGMA;
				    S1 := CONST_VOID;
				end loop;
				while not IS_EMPTY(SL) loop
				    declare
					S2: TREE;
				    begin
					POP(SL, S2);
					if KIND(S2) /= DN_STM_PRAGMA then
					    HAS_MORE := True;
					    exit;
					end if;
				    end;
				end loop;
				if S1 = CONST_VOID then
				    ERROR(D(LX_SRCPOS, TC), "Empty select alternative");
				elsif KIND(S1) = DN_ACCEPT then
				    N_ACCEPT := N_ACCEPT + 1;
				elsif KIND(S1) = DN_DELAY then
				    N_DELAY := N_DELAY + 1;
				elsif KIND(S1) = DN_TERMINATE then
				    N_TERM := N_TERM + 1;
				    if HAS_MORE then
					ERROR(D(LX_SRCPOS, S1), "Statements not allowed after terminate alternative");
				    end if;
				else
				    ERROR(D(LX_SRCPOS, S1), "Select alternative must start with accept, delay, or terminate");
				end if;
			    end;
			end if;
		    end loop;
		    if N_ACCEPT = 0 then
			ERROR(D(LX_SRCPOS, STM), "Selective wait must contain at least one accept alternative");
		    end if;
		    if N_TERM > 1 then
			ERROR(D(LX_SRCPOS, STM), "At most one terminate alternative allowed");
		    end if;
		    if N_TERM > 0 and then N_DELAY > 0 then
			ERROR(D(LX_SRCPOS, STM), "Cannot combine delay and terminate alternatives");
		    end if;
		    if HAS_ELSE and then (N_DELAY > 0 or else N_TERM > 0) then
			ERROR(D(LX_SRCPOS, STM), "Cannot combine else part with delay or terminate alternative");
		    end if;
		end;
	    end;


	-- for a pragma in a sequence of statements
	when DN_STM_PRAGMA =>
	    declare
		PRAGMA_NODE: constant TREE := D(AS_PRAGMA, STM);
	    begin

		-- walk the pragma
		WALK(PRAGMA_NODE, H);
	    end;


	when others =>
            QUIT("Invalid as stm node");
	end case;


	-- return the new statement (maybe procedure changed to entry)
	return STM;
    end WALK_STM;

end STMWALK;
