with DIANA, DIANATTR, DIANAMAN; use DIANA, DIANATTR, DIANAMAN;
with EXPRESO; use EXPRESO;
with UARITH;

package body SEMGLOB is

    procedure INITIALIZE_GLOBAL_DATA is
    begin

	SU.USED_PACKAGE_LIST		:= MAKE;
	SU.INCOMPLETE_TYPE_LIST 	:= MAKE;
	SU.PRIVATE_TYPE_LIST		:= MAKE;

	INITIAL_H :=
		( REGION_DEF	=> CONST_VOID
		, LEX_LEVEL	=> 1
		, IS_IN_SPEC	=> TRUE
		, IS_IN_BODY	=> FALSE
		, SUBP_SYMREP	=> CONST_VOID
		, RETURN_TYPE	=> CONST_VOID
		, ENCLOSING_LOOP_ID => CONST_VOID );

	REGION_SP := 0;
	CURRENT_REGION_DEF := CONST_VOID;
	FORBIDDEN_SELECTOR_SYMREP := CONST_VOID;
	FUNC_HAS_RETURN := FALSE;
	COMPILATION_UNIT_LEX_LEVEL := 2;
	SYSTEM_IS_WITHED := FALSE;
	CAN_RETURN := FALSE;
	IN_HANDLER := FALSE;
	STM_BARRIER := 0;
	STM_SP := 0;
	LOOP_BARRIER := 0;
	LOOP_SP := 0;
	IN_GENERIC_FORMALS := FALSE;
	IN_DEFAULT_EXP := FALSE;
	ALLOW_DEFERRED_CONST := FALSE;
	CONSTR_INC_CNT := 0;
	FROZEN_CNT := 0;
	GEN_BODY_CNT := 0;
	PEND_UNCON_CNT := 0;
	DEF_ACC_CNT := 0;
    end INITIALIZE_GLOBAL_DATA;

    procedure FREEZE_REC(TS: TREE; DEPTH: NATURAL) is
	BT: TREE := TS;
    begin
	if TS = CONST_VOID or else DEPTH > 8 then return; end if;
	if KIND(BT) in CLASS_CONSTRAINED or else KIND(BT) in DN_ENUMERATION .. DN_FIXED then
	    if D(SM_BASE_TYPE, BT) /= CONST_VOID then
		BT := D(SM_BASE_TYPE, BT);
	    end if;
	end if;
	if BT = CONST_VOID then return; end if;
	for I in 1 .. FROZEN_CNT loop
	    if FROZEN_ARR(I) = BT then return; end if;
	end loop;
	if FROZEN_CNT < 1024 then
	    FROZEN_CNT := FROZEN_CNT + 1;
	    FROZEN_ARR(FROZEN_CNT) := BT;
	end if;
	if KIND(BT) = DN_ARRAY or else KIND(BT) = DN_CONSTRAINED_ARRAY then
	    FREEZE_REC(D(SM_COMP_TYPE, BT), DEPTH + 1);
	    if KIND(BT) = DN_ARRAY and then D(SM_INDEX_S, BT) /= CONST_VOID then
		declare
		    IL: SEQ_TYPE := LIST(D(SM_INDEX_S, BT));
		    IT: TREE;
		begin
		    while not IS_EMPTY(IL) loop
			POP(IL, IT);
			if IT /= CONST_VOID then
			    FREEZE_REC(D(SM_TYPE_SPEC, IT), DEPTH + 1);
			end if;
		    end loop;
		end;
	    end if;
	elsif KIND(BT) = DN_RECORD then
	    if D(SM_DISCRIMINANT_S, BT) /= CONST_VOID then
		declare
		    DL: SEQ_TYPE := LIST(D(SM_DISCRIMINANT_S, BT));
		    DD: TREE;
		begin
		    while not IS_EMPTY(DL) loop
			POP(DL, DD);
			if KIND(DD) = DN_DSCRMT_DECL then
			    declare
				NS: constant SEQ_TYPE := LIST(D(AS_SOURCE_NAME_S, DD));
			    begin
				if not IS_EMPTY(NS) then
				    FREEZE_REC(D(SM_OBJ_TYPE, HEAD(NS)), DEPTH + 1);
				end if;
			    end;
			end if;
		    end loop;
		end;
	    end if;
	    declare
		procedure FREEZE_CL(CL: TREE) is
		    DL: SEQ_TYPE;
		    IT: TREE;
		    VP: TREE;
		    VL: SEQ_TYPE;
		    VN: TREE;
		begin
		    if CL = CONST_VOID or else KIND(CL) /= DN_COMP_LIST then return; end if;
		    if D(AS_DECL_S, CL) /= CONST_VOID then
			DL := LIST(D(AS_DECL_S, CL));
			while not IS_EMPTY(DL) loop
			    POP(DL, IT);
			    if KIND(IT) = DN_VARIABLE_DECL then
				declare
				    NS: constant SEQ_TYPE := LIST(D(AS_SOURCE_NAME_S, IT));
				begin
				    if not IS_EMPTY(NS) then
					FREEZE_REC(D(SM_OBJ_TYPE, HEAD(NS)), DEPTH + 1);
				    end if;
				end;
			    end if;
			end loop;
		    end if;
		    VP := D(AS_VARIANT_PART, CL);
		    if VP /= CONST_VOID and then KIND(VP) = DN_VARIANT_PART and then D(AS_VARIANT_S, VP) /= CONST_VOID then
			VL := LIST(D(AS_VARIANT_S, VP));
			while not IS_EMPTY(VL) loop
			    POP(VL, VN);
			    if KIND(VN) = DN_VARIANT then
				FREEZE_CL(D(AS_COMP_LIST, VN));
			    end if;
			end loop;
		    end if;
		end FREEZE_CL;
	    begin
		FREEZE_CL(D(SM_COMP_LIST, BT));
	    end;
	elsif KIND(BT) in CLASS_PRIVATE_SPEC and then D(SM_TYPE_SPEC, BT) /= CONST_VOID then
	    FREEZE_REC(D(SM_TYPE_SPEC, BT), DEPTH + 1);
	end if;
    end FREEZE_REC;

    procedure FREEZE_TYPE(TS: TREE) is
    begin
	FREEZE_REC(TS, 0);
    end FREEZE_TYPE;

    function IS_FROZEN(TS: TREE) return BOOLEAN is
	BT: TREE := TS;
    begin
	if TS = CONST_VOID then return FALSE; end if;
	if KIND(BT) in CLASS_CONSTRAINED or else KIND(BT) in DN_ENUMERATION .. DN_FIXED then
	    if D(SM_BASE_TYPE, BT) /= CONST_VOID then
		BT := D(SM_BASE_TYPE, BT);
	    end if;
	end if;
	for I in 1 .. FROZEN_CNT loop
	    if FROZEN_ARR(I) = BT then return TRUE; end if;
	end loop;
	return FALSE;
    end IS_FROZEN;

    function IS_ACC_DEREF_BLOCKED(TS: TREE) return BOOLEAN is
    begin
	if TS = CONST_VOID then return FALSE; end if;
	for I in 1 .. DEF_ACC_CNT loop
	    if DEF_ACC_TS(I) = TS and then not DEF_ACC_ACT(I) then
		return TRUE;
	    end if;
	end loop;
	return FALSE;
    end IS_ACC_DEREF_BLOCKED;

    procedure INITIALIZE_PREDEFINED_TYPES is

	function INIT(X: STRING) return TREE is
	    DEFLIST:	SEQ_TYPE := LIST(STORESYM(X));
	    DEF:	TREE;
	begin
	    while not IS_EMPTY(DEFLIST) loop
		POP(DEFLIST, DEF);
		if D(XD_REGION_DEF, DEF) = PREDEFINED_STANDARD_DEF then
		    return D(SM_TYPE_SPEC, D(XD_SOURCE_NAME, DEF));
		end if;
	    end loop;
	    return CONST_VOID;
	end INIT;

	procedure SET_RANGE_BOUNDS (TYPE_NODE: TREE; LOW, HIGH: out TREE) is
	    RANGE_NODE: TREE;
	begin
	    if TYPE_NODE /= CONST_VOID then
		RANGE_NODE := D(SM_RANGE, TYPE_NODE);
		LOW := GET_STATIC_VALUE(D(AS_EXP1, RANGE_NODE));
		HIGH := GET_STATIC_VALUE(D(AS_EXP2, RANGE_NODE));
	    else
		LOW := UARITH.U_VAL(0);
		HIGH := UARITH.U_VAL(0);
	    end if;
	end SET_RANGE_BOUNDS;

	procedure SET_ACCURACY (TYPE_NODE: TREE; ACCURACY: out TREE) is
	begin
	    if TYPE_NODE /= CONST_VOID then
		ACCURACY := D(SM_ACCURACY, TYPE_NODE);
	    else
		ACCURACY := UARITH.U_VAL(0);
	    end if;
	end SET_ACCURACY;

    begin
        PREDEFINED_BOOLEAN      := INIT("BOOLEAN");
        PREDEFINED_SHORT_INTEGER := INIT("SHORT_INTEGER");
        PREDEFINED_INTEGER      := INIT("INTEGER");
        PREDEFINED_LONG_INTEGER := INIT("LONG_INTEGER");
        PREDEFINED_FLOAT        := INIT("FLOAT");
        PREDEFINED_LONG_FLOAT   := INIT("LONG_FLOAT");
        PREDEFINED_STRING       := INIT("STRING");
        PREDEFINED_DURATION     := INIT("DURATION");
	PREDEFINED_ADDRESS	:= INIT("_ADDRESS");

	PREDEFINED_STANDARD_ID := D(XD_SOURCE_NAME, PREDEFINED_STANDARD_DEF);

	SET_RANGE_BOUNDS
		    ( PREDEFINED_SHORT_INTEGER
		    , PREDEFINED_SHORT_INTEGER_FIRST
		    , PREDEFINED_SHORT_INTEGER_LAST );
	SET_RANGE_BOUNDS
		    ( PREDEFINED_INTEGER
		    , PREDEFINED_INTEGER_FIRST
		    , PREDEFINED_INTEGER_LAST );
	SET_RANGE_BOUNDS
		    ( PREDEFINED_LONG_INTEGER
		    , PREDEFINED_LONG_INTEGER_FIRST
		    , PREDEFINED_LONG_INTEGER_LAST );
	if PREDEFINED_LONG_INTEGER /= CONST_VOID then
	    PREDEFINED_LARGEST_INTEGER := PREDEFINED_LONG_INTEGER;
	else
	    PREDEFINED_LARGEST_INTEGER := PREDEFINED_INTEGER;
	end if;

	SET_RANGE_BOUNDS
		    ( PREDEFINED_FLOAT
		    , PREDEFINED_FLOAT_FIRST
		    , PREDEFINED_FLOAT_LAST );
	SET_ACCURACY(PREDEFINED_FLOAT, PREDEFINED_FLOAT_ACCURACY);
	SET_RANGE_BOUNDS
		    ( PREDEFINED_LONG_FLOAT
		    , PREDEFINED_LONG_FLOAT_FIRST
		    , PREDEFINED_LONG_FLOAT_LAST );
	SET_ACCURACY(PREDEFINED_LONG_FLOAT, PREDEFINED_LONG_FLOAT_ACCURACY);
	if PREDEFINED_LONG_FLOAT /= CONST_VOID then
	    PREDEFINED_LARGEST_FLOAT := PREDEFINED_LONG_FLOAT;
	else
	    PREDEFINED_LARGEST_FLOAT := PREDEFINED_FLOAT;
	end if;

    end INITIALIZE_PREDEFINED_TYPES;
end SEMGLOB;
