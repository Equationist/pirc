with UNIVOPS; use UNIVOPS;
with EVALNUM;
with expreso; use expreso;
with diana,dianattr,dianaman; use diana,dianattr,dianaman;

package body UARITH is
    -- universal arithmetic functions

    -- Note.  This package was originally implemented with an Ada-like
    --	 compiler (old Janus) which did not have 32-bit arithmetic;
    --	 hence the multiple precision arithmetic using 8-bit pieces.

    function IS_ZERO(V: VECTOR) return BOOLEAN;

    -- make universal value from an integer
    function U_VAL(A: INTEGER) return TREE is
	A_SPREAD: VECTOR;
    begin
	SPREAD(A, A_SPREAD);
	return U_INT(A_SPREAD);
    end U_VAL;

    -- make universal value (integer or real) from string
    -- return void if illegal value
    function U_VALUE(TXT: STRING) return TREE is
    begin
	return EVALNUM(TXT);
    end U_VALUE;

    -- return integer value for universal (must be in 32-bit signed range)
    function U_POS(A: TREE) return INTEGER is
	V: VECTOR;
	ACC: INTEGER := 0;
    begin
	if A = CONST_VOID or else KIND(A) /= DN_NUM_VAL then
	    raise ASSERTION_ERROR;
	end if;
	if A.TLN = 0 then
	    return INTEGER(A.TPG);
	end if;
	SPREAD(A, V);
	if V.L > 3 then
	    raise ASSERTION_ERROR;
	end if;
	if V.S < 0 and then V.L = 3 and then V.D(3) = 21 and then V.D(2) = 4748 and then V.D(1) = 3648 then
	    return INTEGER'FIRST;
	end if;
	for I in reverse 1 .. V.L loop
	    if ACC > (INTEGER'LAST - INTEGER(V.D(I))) / 10000 then
		raise ASSERTION_ERROR;
	    end if;
	    ACC := ACC * 10000 + INTEGER(V.D(I));
	end loop;
	if V.S < 0 then
	    return -ACC;
	else
	    return ACC;
	end if;
    end U_POS;

    -- operators on universal values
    -- return void if either operand is void

    -- following return 0 or 1 or void
    function U_EQUAL(LEFT, RIGHT: TREE) return TREE is
    begin
	if LEFT = CONST_VOID or RIGHT = CONST_VOID then
	    return CONST_VOID;
	elsif KIND(LEFT) = DN_NUM_VAL and then KIND(RIGHT) = DN_NUM_VAL then
	    if LEFT = RIGHT then
		return U_VAL(1);
	    end if;
	    declare
		L_SPREAD, R_SPREAD: VECTOR;
	    begin
		SPREAD(LEFT, L_SPREAD);
		SPREAD(RIGHT, R_SPREAD);
		if L_SPREAD.S = R_SPREAD.S
		and then V_EQUAL(L_SPREAD, R_SPREAD) then
		    return U_VAL(1);
		else
		    return U_VAL(0);
		end if;
	    end;
	elsif KIND(LEFT) = DN_REAL_VAL and then KIND(RIGHT) = DN_REAL_VAL then
	    if LEFT = RIGHT then
		return U_VAL(1);
	    end if;
	    -- Rationals are canonicalized in lowest terms with positive denominator by U_REAL
	    return U_EQUAL(D(XD_NUMER, LEFT), D(XD_NUMER, RIGHT))
		   and U_EQUAL(D(XD_DENOM, LEFT), D(XD_DENOM, RIGHT));
	else
	    return CONST_VOID;
	end if;
    end U_EQUAL;

    function U_NOT_EQUAL(LEFT, RIGHT: TREE) return TREE is
    begin
	return not U_EQUAL(LEFT, RIGHT);
    end U_NOT_EQUAL;

    function "<"(LEFT, RIGHT: TREE) return TREE is
    begin
	if LEFT = CONST_VOID or RIGHT = CONST_VOID then
	    return CONST_VOID;
	elsif KIND(LEFT) = DN_NUM_VAL and then KIND(RIGHT) = DN_NUM_VAL then
	    if LEFT = RIGHT then
		return U_VAL(0);
	    end if;
	    declare
		L_SPREAD, R_SPREAD: VECTOR;
	    begin
		SPREAD(LEFT, L_SPREAD);
		SPREAD(RIGHT, R_SPREAD);
		if L_SPREAD.S < 0 then
		    if R_SPREAD.S > 0
		    or else V_LESS(R_SPREAD, L_SPREAD) then
			return U_VAL(1);
		    end if;
		else
		    if R_SPREAD.S > 0
		    and then V_LESS(L_SPREAD, R_SPREAD) then
			return U_VAL(1);
		    end if;
		end if;
		return U_VAL(0);
	    end;
	elsif KIND(LEFT) = DN_REAL_VAL and then KIND(RIGHT) = DN_REAL_VAL then
	    if LEFT = RIGHT then
		return U_VAL(0);
	    end if;
	    declare
		LN, LD, RN, RD: VECTOR;
		L_ZERO, R_ZERO: BOOLEAN;
		LQ, RQ, LR, RR: VECTOR;
		NEG_BOTH: BOOLEAN;
		LESS_MAG: BOOLEAN;
	    begin
		SPREAD(D(XD_NUMER, LEFT), LN);
		SPREAD(D(XD_DENOM, LEFT), LD);
		SPREAD(D(XD_NUMER, RIGHT), RN);
		SPREAD(D(XD_DENOM, RIGHT), RD);
		L_ZERO := IS_ZERO(LN);
		R_ZERO := IS_ZERO(RN);
		if L_ZERO then
		    if not R_ZERO and then RN.S > 0 then
			return U_VAL(1);
		    else
			return U_VAL(0);
		    end if;
		elsif R_ZERO then
		    if LN.S < 0 then
			return U_VAL(1);
		    else
			return U_VAL(0);
		    end if;
		end if;
		if LN.S < 0 and then RN.S > 0 then
		    return U_VAL(1);
		elsif LN.S > 0 and then RN.S < 0 then
		    return U_VAL(0);
		end if;
		-- Same sign and non-zero
		if LN.L + RD.L <= 250 and then RN.L + LD.L <= 250 then
		    return "<" ( D(XD_NUMER,LEFT) * D(XD_DENOM,RIGHT),
				 D(XD_NUMER,RIGHT) * D(XD_DENOM,LEFT));
		end if;
		-- Overflow-safe comparison via continued-fraction / quotient comparison
		NEG_BOTH := (LN.S < 0);
		LN.S := +1; LD.S := +1; RN.S := +1; RD.S := +1;
		LESS_MAG := FALSE;
		for STEP in 1 .. 64 loop
		    V_COPY(LN, LR);
		    V_DIV(LD, LR, LQ);
		    V_COPY(RN, RR);
		    V_DIV(RD, RR, RQ);
		    if not V_EQUAL(LQ, RQ) then
			LESS_MAG := V_LESS(LQ, RQ);
			exit;
		    end if;
		    if IS_ZERO(LR) and then IS_ZERO(RR) then
			return U_VAL(0);
		    elsif IS_ZERO(LR) then
			LESS_MAG := TRUE;
			exit;
		    elsif IS_ZERO(RR) then
			LESS_MAG := FALSE;
			exit;
		    end if;
		    -- Compare inverted fractions RD/RR vs LD/LR (flips inequality)
		    V_COPY(LD, LN);
		    V_COPY(LR, LD);
		    V_COPY(RD, RN);
		    V_COPY(RR, RD);
		    NEG_BOTH := not NEG_BOTH;
		    if LN.L + RD.L <= 250 and then RN.L + LD.L <= 250 then
			declare
			    P1, P2: VECTOR;
			begin
			    V_MUL(LN, RD, P1);
			    V_MUL(RN, LD, P2);
			    if V_EQUAL(P1, P2) then
				return U_VAL(0);
			    end if;
			    LESS_MAG := V_LESS(P1, P2);
			    exit;
			end;
		    end if;
		end loop;
		if NEG_BOTH then
		    LESS_MAG := not LESS_MAG;
		end if;
		if LESS_MAG then
		    return U_VAL(1);
		else
		    return U_VAL(0);
		end if;
	    end;
	else
	    return CONST_VOID;
	end if;
    end "<";

    function "<="(LEFT, RIGHT: TREE) return TREE is
    begin
	return not (RIGHT < LEFT);
    end "<=";

    function ">"(LEFT, RIGHT: TREE) return TREE is
    begin
	return (RIGHT < LEFT);
    end ">";

    function ">="(LEFT, RIGHT: TREE) return TREE is
    begin
	return not (LEFT < RIGHT);
    end ">=";

    function U_MEMBER(VALUE, DISCRETE_RANGE: TREE) return TREE is
    begin
	if VALUE = CONST_VOID or else DISCRETE_RANGE = CONST_VOID then
	    return CONST_VOID;
	end if;

	if KIND(DISCRETE_RANGE) = DN_RANGE then
	    return (VALUE >= GET_STATIC_VALUE(D(AS_EXP1,DISCRETE_RANGE)))
	            and (VALUE <= GET_STATIC_VALUE(D(AS_EXP2,DISCRETE_RANGE)));

	elsif KIND(DISCRETE_RANGE) = DN_RANGE_ATTRIBUTE then
	    return CONST_VOID;

	elsif KIND(DISCRETE_RANGE) = DN_DISCRETE_SUBTYPE then
	    declare
		SUBTYPE_INDICATION: constant TREE
			:= D(AS_SUBTYPE_INDICATION, DISCRETE_RANGE);
		NAME: TREE;
		CONSTRAINT: TREE;
		DEFN: TREE;
		TS: TREE;
	    begin
		if SUBTYPE_INDICATION = CONST_VOID or else KIND(SUBTYPE_INDICATION) /= DN_SUBTYPE_INDICATION then
		    return CONST_VOID;
		end if;
		NAME := D(AS_NAME, SUBTYPE_INDICATION);
		CONSTRAINT := D(AS_CONSTRAINT, SUBTYPE_INDICATION);
	  	if CONSTRAINT /= CONST_VOID then
		    if KIND(CONSTRAINT) in CLASS_RANGE then
			return U_MEMBER(VALUE, CONSTRAINT);
		    elsif KIND(CONSTRAINT) in CLASS_REAL_CONSTRAINT
		    and then D(AS_RANGE,CONSTRAINT) /= CONST_VOID then
			return U_MEMBER(VALUE, D(AS_RANGE,CONSTRAINT));
		    else
			return CONST_VOID;
		    end if;
		end if;

		while NAME /= CONST_VOID and then KIND(NAME) = DN_SELECTED loop
		    NAME := D(AS_DESIGNATOR, NAME);
		end loop;
		if NAME = CONST_VOID or else KIND(NAME) not in CLASS_USED_NAME then
		    return CONST_VOID;
		end if;
		DEFN := D(SM_DEFN, NAME);
		if DEFN = CONST_VOID or else KIND(DEFN) not in CLASS_TYPE_NAME then
		    return CONST_VOID;
		end if;

		TS := D(SM_TYPE_SPEC, DEFN);
		if TS = CONST_VOID or else KIND(TS) not in CLASS_SCALAR then
		    return CONST_VOID;
		end if;
		return U_MEMBER(VALUE, D(SM_RANGE, TS));
	    end;
	else
	    return CONST_VOID;
	end if;
    end U_MEMBER;


    -- following return BOOLEAN (for compiler range tests)
    function "<="(LEFT, RIGHT: TREE) return BOOLEAN is
    begin
	return (LEFT <= RIGHT) = U_VAL(1);
    end "<=";

    function ">="(LEFT, RIGHT: TREE) return BOOLEAN is
    begin
	return (LEFT >= RIGHT) = U_VAL(1);
    end ">=";

    function U_EQUAL(LEFT, RIGHT: TREE) return BOOLEAN is
    begin
	return U_EQUAL(LEFT, RIGHT) = U_VAL(1);
    end U_EQUAL;

    function U_MEMBER(VALUE, DISCRETE_RANGE: TREE) return BOOLEAN is
    begin
	return U_MEMBER(VALUE, DISCRETE_RANGE) = U_VAL(1);
    end U_MEMBER;


    -- following expect 0 or 1 as argument -- boolean operators
    function "AND"(LEFT, RIGHT: TREE) return TREE is
    begin
	if LEFT = CONST_VOID or RIGHT = CONST_VOID then
	    return CONST_VOID;
	elsif LEFT.TPG > 0 and RIGHT.TPG > 0 then
	    return U_VAL(1);
	else
	    return U_VAL(0);
	end if;
    end "AND";

    function "OR"(LEFT, RIGHT: TREE) return TREE is
    begin
	if LEFT = CONST_VOID or RIGHT = CONST_VOID then
	    return CONST_VOID;
	elsif LEFT.TPG > 0 or RIGHT.TPG > 0 then
	    return U_VAL(1);
	else
	    return U_VAL(0);
	end if;
    end "OR";

    function "XOR"(LEFT, RIGHT: TREE) return TREE is
    begin
	if LEFT = CONST_VOID or RIGHT = CONST_VOID then
	    return CONST_VOID;
	elsif LEFT.TPG /= RIGHT.TPG then
	    return U_VAL(1);
	else
	    return U_VAL(0);
	end if;
    end "XOR";

    function "NOT"(RIGHT: TREE) return TREE is
    begin
	if RIGHT = CONST_VOID then
	    return CONST_VOID;
	else
	    return U_VAL(1 - INTEGER(RIGHT.TPG));
	end if;
    end "NOT";


    -- unary functions
    function "-"(RIGHT: TREE) return TREE is
    begin
	if RIGHT = CONST_VOID then
	    return CONST_VOID;
	elsif KIND(RIGHT) = DN_NUM_VAL then
	    declare
		R_SPREAD: VECTOR;
	    begin
		SPREAD(RIGHT, R_SPREAD);
		R_SPREAD.S := - R_SPREAD.S;
		return U_INT(R_SPREAD);
	    end;
	else -- must be real_val
	    return U_REAL( - D(XD_NUMER, RIGHT), D(XD_DENOM, RIGHT) );
	end if;
    end "-";

    function "ABS"(RIGHT: TREE) return TREE is
    begin
	if RIGHT = CONST_VOID then
	    return CONST_VOID;
	elsif KIND(RIGHT) = DN_NUM_VAL then
	    declare
		R_SPREAD: VECTOR;
	    begin
		SPREAD(RIGHT, R_SPREAD);
		if R_SPREAD.S > 0 then
		    return RIGHT;
		else
		    R_SPREAD.S := +1;
		    return U_INT(R_SPREAD);
		end if;
	    end;
	else -- must be real_val
	    return U_REAL( abs D(XD_NUMER, RIGHT), D(XD_DENOM, RIGHT) );
	end if;
    end "ABS";


    -- binary functions
    function "+"(LEFT, RIGHT: TREE) return TREE is
    begin
	if LEFT = CONST_VOID or RIGHT = CONST_VOID then
	    return CONST_VOID;
	elsif KIND(LEFT) = DN_NUM_VAL then
	    declare
		L_SPREAD, R_SPREAD: VECTOR;
	    begin
		SPREAD(LEFT, L_SPREAD);
		SPREAD(RIGHT, R_SPREAD);
		if L_SPREAD.S = R_SPREAD.S then
		    V_ADD(L_SPREAD, R_SPREAD);
		    return U_INT(R_SPREAD);
		elsif V_EQUAL(L_SPREAD, R_SPREAD) then
		    return U_VAL(0);
		elsif V_LESS(L_SPREAD, R_SPREAD) then
		    V_SUB(L_SPREAD, R_SPREAD);
		    return U_INT(R_SPREAD);
		else
		    V_SUB(R_SPREAD, L_SPREAD);
		    return U_INT(L_SPREAD);
		end if;
	    exception
		when ASSERTION_ERROR =>
		    return CONST_VOID;
	    end;
	else -- must be real_val
	    return U_REAL( D(XD_NUMER, LEFT) * D(XD_DENOM, RIGHT)
			   + D(XD_NUMER, RIGHT) * D(XD_DENOM, LEFT)
			 , D(XD_DENOM, LEFT) * D(XD_DENOM, RIGHT) );
	end if;
    end "+";

    function "-"(LEFT, RIGHT: TREE) return TREE is
    begin
	if LEFT = CONST_VOID or RIGHT = CONST_VOID then
	    return CONST_VOID;
	elsif KIND(LEFT) = DN_NUM_VAL then
	    declare
		L_SPREAD, R_SPREAD: VECTOR;
	    begin
		SPREAD(LEFT, L_SPREAD);
		SPREAD(RIGHT, R_SPREAD);
		R_SPREAD.S := - R_SPREAD.S; -- rest of code same as +
		if L_SPREAD.S = R_SPREAD.S then
		    V_ADD(L_SPREAD, R_SPREAD);
		    return U_INT(R_SPREAD);
		elsif V_EQUAL(L_SPREAD, R_SPREAD) then
		    return U_VAL(0);
		elsif V_LESS(L_SPREAD, R_SPREAD) then
		    V_SUB(L_SPREAD, R_SPREAD);
		    return U_INT(R_SPREAD);
		else
		    V_SUB(R_SPREAD, L_SPREAD);
		    return U_INT(L_SPREAD);
		end if;
	    exception
		when ASSERTION_ERROR =>
		    return CONST_VOID;
	    end;
	else -- must be real_val
	    return U_REAL( D(XD_NUMER, LEFT) * D(XD_DENOM, RIGHT)
			   - D(XD_NUMER, RIGHT) * D(XD_DENOM, LEFT)
			 , D(XD_DENOM, LEFT) * D(XD_DENOM, RIGHT) );
	end if;
    end "-";

    function "*"(LEFT, RIGHT: TREE) return TREE is -- i*i, i*r, r*i, r*r
    begin
	if LEFT = CONST_VOID or RIGHT = CONST_VOID then
	    return CONST_VOID;
	elsif KIND(LEFT) = DN_NUM_VAL and KIND(RIGHT) = DN_NUM_VAL then
	    declare
		L_SPREAD, R_SPREAD: VECTOR;
		TEMP: VECTOR;
	    begin
		SPREAD(LEFT, L_SPREAD);
		SPREAD(RIGHT, R_SPREAD);
		if IS_ZERO(L_SPREAD) or else IS_ZERO(R_SPREAD) then
		    return U_VAL(0);
		end if;
		if L_SPREAD.L + R_SPREAD.L > 250 then
		    return CONST_VOID;
		end if;
		V_MUL(L_SPREAD, R_SPREAD, TEMP);
		TEMP.S := L_SPREAD.S * R_SPREAD.S;
		return U_INT(TEMP);
	    end;
	elsif KIND(RIGHT) = DN_NUM_VAL then
	    return U_REAL( D(XD_NUMER,LEFT) * RIGHT
			 , D(XD_DENOM,LEFT) );
	elsif KIND(LEFT) = DN_NUM_VAL then
	    return RIGHT * LEFT;
	else -- must be real_val
	    return U_REAL( D(XD_NUMER, LEFT) * D(XD_NUMER, RIGHT)
			 , D(XD_DENOM, LEFT) * D(XD_DENOM, RIGHT) );
	end if;
    end "*";

    function "/"(LEFT, RIGHT: TREE) return TREE is -- i/i, r/i, r/r
    begin
	if LEFT = CONST_VOID or RIGHT = CONST_VOID then
	    return CONST_VOID;
	elsif KIND(LEFT) = DN_NUM_VAL and KIND(RIGHT) = DN_NUM_VAL then
	    declare
		L_SPREAD, R_SPREAD: VECTOR;
		TEMP: VECTOR;
	    begin
		SPREAD(RIGHT, R_SPREAD);
		if IS_ZERO(R_SPREAD) then
		    return CONST_VOID;
		end if;
		SPREAD(LEFT, L_SPREAD);
		V_DIV(R_SPREAD, L_SPREAD, TEMP);
		TEMP.S := L_SPREAD.S * R_SPREAD.S;
		return U_INT(TEMP);
	    end;
	elsif KIND(RIGHT) = DN_NUM_VAL then
	    if RIGHT = U_VAL(0) then
		return CONST_VOID;
	    end if;
	    return U_REAL( D(XD_NUMER,LEFT)
			 , D(XD_DENOM,LEFT) * RIGHT);
	else -- must be real_val
	    if D(XD_NUMER,RIGHT) = U_VAL(0) then
		return CONST_VOID;
	    end if;
	    return U_REAL( D(XD_NUMER, LEFT) * D(XD_DENOM, RIGHT)
			 , D(XD_DENOM, LEFT) * D(XD_NUMER, RIGHT) );
	end if;
    end "/";

    function "MOD"(LEFT, RIGHT: TREE) return TREE is
    begin
	if LEFT = CONST_VOID or RIGHT = CONST_VOID then
	    return CONST_VOID;
	else
	    declare
		L_SPREAD, R_SPREAD: VECTOR;
		TEMP: VECTOR;
	    begin
		SPREAD(LEFT, L_SPREAD);
		SPREAD(RIGHT, R_SPREAD);

	        if IS_ZERO(R_SPREAD) then
		    return CONST_VOID; -- zero divide
		end if;

		V_DIV(R_SPREAD, L_SPREAD, TEMP);
		if L_SPREAD.S /= R_SPREAD.S
		and then not IS_ZERO(L_SPREAD) then
		    V_SUB(L_SPREAD, R_SPREAD);
		    L_SPREAD.D(1..R_SPREAD.L) := R_SPREAD.D(1..R_SPREAD.L);
		    L_SPREAD.L := R_SPREAD.L;
		end if;
		L_SPREAD.S := R_SPREAD.S;
		return U_INT(L_SPREAD);
	    end;
	end if;
    end "MOD";

    function "REM"(LEFT, RIGHT: TREE) return TREE is
    begin
	if LEFT = CONST_VOID or RIGHT = CONST_VOID then
	    return CONST_VOID;
	else
	    declare
		L_SPREAD, R_SPREAD: VECTOR;
		TEMP: VECTOR;
	    begin
		SPREAD(LEFT, L_SPREAD);
		SPREAD(RIGHT, R_SPREAD);

		if IS_ZERO(R_SPREAD) then
		    return CONST_VOID; -- zero divide
		end if;

		V_DIV(R_SPREAD, L_SPREAD, TEMP);
		-- sign is sign of original L_SPREAD
		return U_INT(L_SPREAD);
	    end;
	end if;
    end "REM";

    function "**"(LEFT, RIGHT: TREE) return TREE is -- i**i, r**i
	R_SPREAD: VECTOR;
	EXP_VAL:  INTEGER := 0;
	EXP_NEG:  BOOLEAN := FALSE;
    begin
	if LEFT = CONST_VOID or RIGHT = CONST_VOID then
	    return CONST_VOID;
	end if;
	-- Extract signed 32-bit exponent safely (supports exponents outside 16-bit range)
	SPREAD(RIGHT, R_SPREAD);
	EXP_NEG := (R_SPREAD.S < 0);
	if KIND(LEFT) = DN_NUM_VAL then
	    declare
		L_SPREAD: VECTOR;
	    begin
		if EXP_NEG then
		    return CONST_VOID; -- constraint error for negative integer exponent
		end if;
		SPREAD(LEFT, L_SPREAD);
		if IS_ZERO(R_SPREAD) then
		    return U_VAL(1);
		elsif IS_ZERO(L_SPREAD) then
		    return U_VAL(0);
		elsif L_SPREAD.L = 1 and then L_SPREAD.D(1) = 1 then
		    if L_SPREAD.S < 0 and then (INTEGER(R_SPREAD.D(1)) mod 2 = 1) then
			return U_VAL(-1);
		    else
			return U_VAL(1);
		    end if;
		end if;
	    end;
	end if;
	if R_SPREAD.L > 3 then
	    return CONST_VOID;
	end if;
	for I in reverse 1 .. R_SPREAD.L loop
	    if EXP_VAL > (INTEGER'LAST - INTEGER(R_SPREAD.D(I))) / 10000 then
		return CONST_VOID;
	    end if;
	    EXP_VAL := EXP_VAL * 10000 + INTEGER(R_SPREAD.D(I));
	end loop;

	if KIND(LEFT) = DN_NUM_VAL then
	    declare
		L_SPREAD: VECTOR;
		BASE:     VECTOR;
		TEMP:     VECTOR;
		RESULT:   VECTOR;
		COUNT:    INTEGER := EXP_VAL;
		RES_SIGN: INTEGER := +1;
	    begin
		if EXP_NEG then
		    return CONST_VOID; -- constraint error for negative integer exponent
		end if;
		SPREAD(LEFT, L_SPREAD);
		if COUNT = 0 then
		    return U_VAL(1);
		elsif IS_ZERO(L_SPREAD) then
		    return U_VAL(0);
		elsif L_SPREAD.L = 1 and then L_SPREAD.D(1) = 1 then
		    if L_SPREAD.S < 0 and then (COUNT mod 2 = 1) then
			return U_VAL(-1);
		    else
			return U_VAL(1);
		    end if;
		end if;
		if L_SPREAD.S < 0 and then (COUNT mod 2 = 1) then
		    RES_SIGN := -1;
		end if;
		V_COPY(L_SPREAD, BASE);
		BASE.S := +1;
		SPREAD(1, RESULT);
		while COUNT > 0 loop
		    if COUNT mod 2 = 1 then
			if RESULT.L + BASE.L > RESULT.D'LAST - 2 then
			    return CONST_VOID;
			end if;
			V_MUL(BASE, RESULT, TEMP);
			V_COPY(TEMP, RESULT);
		    end if;
		    COUNT := COUNT / 2;
		    if COUNT > 0 then
			if BASE.L + BASE.L > BASE.D'LAST - 2 then
			    return CONST_VOID;
			end if;
			V_MUL(BASE, BASE, TEMP);
			V_COPY(TEMP, BASE);
		    end if;
		end loop;
		RESULT.S := RES_SIGN;
		return U_INT(RESULT);
	    end;
	else
	    if not EXP_NEG then
		return U_REAL( D(XD_NUMER,LEFT) ** RIGHT
			     , D(XD_DENOM,LEFT) ** RIGHT );
	    else
		declare
		    POS_R : constant TREE := - RIGHT;
		begin
		    return U_REAL( D(XD_DENOM,LEFT) ** POS_R
				 , D(XD_NUMER,LEFT) ** POS_R );
		end;
	    end if;
	end if;
    end "**";

    function IS_ZERO(V: VECTOR) return BOOLEAN is
    begin
	return V.D(1..V.L) = (1..V.L => 0);
    end IS_ZERO;

end UARITH;
