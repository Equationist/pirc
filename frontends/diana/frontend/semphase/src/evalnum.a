with USERPK, TEXT2_IO, DIANA, DIANATTR, DIANAMAN, UNIVOPS;
use  USERPK, TEXT2_IO, DIANA, DIANATTR, DIANAMAN, UNIVOPS;
function EVALNUM(TXT: STRING) return TREE is
  subtype UDIGIT is SHORT;

  MAXCOL: constant INTEGER := TXT'LAST;
  COL: INTEGER := TXT'FIRST;
  CHR : CHARACTER := ' ';
  IS_REAL : BOOLEAN := FALSE;
  SCALEFACTOR : INTEGER := 0;
  VNUMER: VECTOR;
  VDENOM: VECTOR;
  RADIX:  INTEGER := 10;
  EXPONENT: INTEGER := 0;
  EXPONENT_POSITIVE: BOOLEAN := TRUE;

  function MAIN return TREE;
  procedure V_CLEAR(ARG: out VECTOR);
  procedure V_INCREMENT(DLTA: INTEGER; V: in out VECTOR);
  procedure NEXT_CHR;

  function MAIN return TREE is
  begin
    if TXT'LENGTH = 0 then
      return CONST_VOID;
    end if;
    CHR := TXT(TXT'FIRST);
    V_CLEAR(VNUMER);
    V_CLEAR(VDENOM);
    VDENOM.D(1) := 1;
    -- get integer val or radix
    while (CHR in '0' .. '9' or else CHR = '.' or else CHR = '_') and then COL <= MAXCOL loop
      if CHR = '.' then
	IS_REAL := TRUE;
	SCALEFACTOR := 0;
      elsif CHR /= '_' then
        V_INCREMENT (CHARACTER'POS(CHR) - CHARACTER'POS('0'), VNUMER);
	if IS_REAL then
	  SCALEFACTOR := SCALEFACTOR - 1;
	end if;
      end if;
      NEXT_CHR;
    end loop;
    if CHR = '#' or else CHR = ':' then
      if VNUMER.L > 1 then
        return CONST_VOID;
      end if;
      RADIX := INTEGER(VNUMER.D(1));
      if RADIX < 2 or else RADIX > 16 then
        return CONST_VOID;
      end if;
      V_CLEAR(VNUMER);
      NEXT_CHR;
      while CHR /= '#' and then CHR /= ':' and then COL <= MAXCOL loop
        if CHR = '.' then
	  IS_REAL := TRUE;
	  SCALEFACTOR := 0;
        elsif CHR = '_' then
	  null;
        elsif CHR in '0' .. '9' then
          V_INCREMENT (CHARACTER'POS(CHR) - CHARACTER'POS('0'), VNUMER);
	  if IS_REAL then
	    SCALEFACTOR := SCALEFACTOR - 1;
	  end if;
        elsif CHR in 'A' .. 'F' then
          V_INCREMENT (CHARACTER'POS(CHR) - CHARACTER'POS('A') + 10, VNUMER);
	  if IS_REAL then
	    SCALEFACTOR := SCALEFACTOR - 1;
	  end if;
        elsif CHR in 'a' .. 'f' then
          V_INCREMENT (CHARACTER'POS(CHR) - CHARACTER'POS('a') + 10, VNUMER);
	  if IS_REAL then
	    SCALEFACTOR := SCALEFACTOR - 1;
	  end if;
	else
	  return CONST_VOID;
	end if;
	NEXT_CHR;
      end loop;
      if CHR /= '#' and then CHR /= ':' then
        return CONST_VOID;
      end if;
      NEXT_CHR;

    end if;
    if CHR = 'E' or else CHR = 'e' then
      NEXT_CHR;
      if CHR = '+' then
	NEXT_CHR;
      elsif CHR = '-' then
	NEXT_CHR;
	EXPONENT_POSITIVE := FALSE;
      end if;
      while CHR /= ' ' and then COL <= MAXCOL loop
        if CHR = '_' then
          null;
        elsif CHR in '0' .. '9' then
	  if EXPONENT > 3275 then
	    EXPONENT := 1_000_000;
	  else
            EXPONENT := EXPONENT * 10 + CHARACTER'POS(CHR) - CHARACTER'POS('0');
	  end if;
        else
          return CONST_VOID;
        end if;
	NEXT_CHR;
      end loop;
      if not EXPONENT_POSITIVE then
	EXPONENT := - EXPONENT;
      end if;
    end if;
    if IS_REAL then
      EXPONENT := EXPONENT + SCALEFACTOR;
    elsif EXPONENT < 0 then
      -- Integer literal with negative exponent is illegal
      return CONST_VOID;
    end if;

    if not (VNUMER.L = 1 and then VNUMER.D(1) = 0) then
      if EXPONENT > 0 then
        for I in 1 .. EXPONENT loop
	  if VNUMER.L >= VNUMER.D'LAST - 4 then
	    return CONST_VOID;
	  end if;
	  V_SCALE(RADIX, VNUMER);
        end loop;
      elsif EXPONENT < 0 then
        for I in 1 .. - EXPONENT loop
	  if VDENOM.L >= VDENOM.D'LAST - 4 then
	    -- Extremely small non-zero real literal (e.g. 1.0E-1008): underflows universal vector cap
	    return CONST_VOID;
	  end if;
	  V_SCALE(RADIX, VDENOM);
        end loop;
      end if;
    end if;

    if not IS_REAL then
      if VNUMER.L < VNUMER.D'LAST then
        VNUMER.D(VNUMER.L+1) := 0;
      end if;
      return U_INT(VNUMER);
    else
      V_LOWEST_TERMS(VNUMER,VDENOM);
      if VNUMER.L < VNUMER.D'LAST then
        VNUMER.D(VNUMER.L+1) := 0;
      end if;
      if VDENOM.L < VDENOM.D'LAST then
        VDENOM.D(VDENOM.L+1) := 0;
      end if;
      return U_REAL(VNUMER, VDENOM);
    end if;
  exception
    when ASSERTION_ERROR =>
      return CONST_VOID;
  end;

  procedure V_CLEAR(ARG: out VECTOR) is
  begin
    ARG.S := +1;
    ARG.L := 1;
    ARG.D(1) := 0;
  end V_CLEAR;

  procedure V_INCREMENT(DLTA: INTEGER; V: in out VECTOR) is
    TEMP: UDIGIT;
    CARRY : UDIGIT := 0;
  begin
    V_SCALE(RADIX,V);
    TEMP := V.D(1) + UDIGIT(DLTA);
    if TEMP >= 10000 then
      CARRY := 1;
      TEMP := TEMP - 10000;
    end if;
    V.D(1) := TEMP;
    for I in 2 .. V.L loop
      if CARRY = 0 then
	return;
      end if;
      TEMP := V.D(I) + 1;
      if TEMP >= 10000 then
	CARRY := 1;
	TEMP := TEMP - 10000;
      else
	CARRY := 0;
      end if;
      V.D(I) := TEMP;
    end loop;
    if CARRY > 0 then
      if V.L >= V.D'LAST then
        raise ASSERTION_ERROR;
      end if;
      V.L := V.L + 1;
      V.D(V.L) := CARRY;
      NORMALIZE(V); -- to check for overflow
    end if;
  end V_INCREMENT;

  procedure NEXT_CHR is
  begin
    COL := COL + 1;
    if COL <= MAXCOL then
      CHR := TXT(COL);
    else
      CHR := ' ';
    end if;
  end NEXT_CHR;

begin
  return MAIN;
end EVALNUM;
